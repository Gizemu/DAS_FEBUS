def to_posix(dt):
    return dt.replace(tzinfo=UTC).timestamp()


def from_posix(t):
    return datetime.datetime.fromtimestamp(float(t), tz=UTC).replace(tzinfo=None)


_h5_opened = set()


def open_h5(path, retries=3):
    _h5_opened.add(os.path.abspath(path))
    last = None
    for k in range(retries):
        try:
            try:
                return h5py.File(path, "r", locking=False)
            except TypeError:
                return h5py.File(path, "r")
        except OSError as e:
            last = e
            if "signature" in str(e).lower() or "truncated" in str(e).lower():
                break
            time.sleep(0.5 * (k + 1))
    raise OSError(f"cannot open HDF5 file {os.path.basename(path)} ({last})")


def find_zones(f):
    found = []

    def visit(name, obj):
        if isinstance(obj, h5py.Group) and re.search(r"Zone\d+$", name):
            found.append(obj)
    f.visititems(visit)
    return found


def find_zone(f):
    zones = find_zones(f)
    if not zones:
        return None
    if ZONE:
        for z in zones:
            if z.name.rstrip("/").split("/")[-1].lower() == str(ZONE).lower():
                return z
        raise ValueError(f"no zone {ZONE!r} in the file, zones: {[z.name for z in zones]}")
    return zones[0]


def find_strain_dataset(zone, cable):
    keys = [k for k in zone.keys() if isinstance(zone[k], h5py.Dataset) and zone[k].ndim == 3]
    rate = [k for k in keys if "strain" in k.lower() and ("rate" in k.lower() or "|s" in k or "/s" in k.lower())]
    strain = [k for k in keys if "strain" in k.lower()]
    for group in (rate, strain, keys):
        for k in group:
            if cable and str(cable).lower() in k.lower():
                return zone[k]
        if group and not any(str(cable).lower() in k.lower() for k in keys):
            return zone[group[0]]
    return zone[keys[0]] if keys else None


def find_time_array(f):
    found = [None]

    def visit(name, obj):
        if found[0] is None and isinstance(obj, h5py.Dataset) and name.lower().endswith("time"):
            found[0] = obj[:]
    f.visititems(visit)
    return found[0]


_LEN_UNITS = {"m": 1.0, "meter": 1.0, "meters": 1.0, "metre": 1.0, "metres": 1.0, "km": 1e3, "cm": 1e-2,
              "mm": 1e-3, "ft": 0.3048, "feet": 0.3048, "foot": 0.3048, "us_survey_ft": 0.3048006}


_TIME_UNITS = {"s": 1.0, "sec": 1.0, "second": 1.0, "seconds": 1.0, "ms": 1e-3, "msec": 1e-3,
               "millisecond": 1e-3, "milliseconds": 1e-3, "us": 1e-6, "\u00b5s": 1e-6, "microsecond": 1e-6,
               "ns": 1e-9}


META_PATTERNS = {
    "gauge_length": r"(gauge|gage)[ _-]?len(gth)?([ _-]?(m|meters?|metres?))?|gl([ _-]?(m|meters?|metres?))?",
    "derivation_time": r"deriv(ation)?[ _-]?time([ _-]?ms)?",
}


def h5_attr_table(h5):
    rows = [("/", k, v) for k, v in h5.attrs.items()]

    def visit(name, obj):
        for k, v in obj.attrs.items():
            rows.append(("/" + name, k, v))
        if isinstance(obj, h5py.Dataset) and obj.size <= 4 and obj.dtype.kind in "fiuSO":
            try:
                rows.append(("/" + name.rsplit("/", 1)[0] if "/" in name else "/", name.rsplit("/", 1)[-1], obj[()]))
            except Exception:
                pass
    h5.visititems(visit)
    return rows


def _text(v):
    if isinstance(v, bytes):
        return v.decode("utf-8", errors="ignore")
    if isinstance(v, np.ndarray) and v.dtype.kind in "SO" and v.size:
        return _text(np.ravel(v)[0])
    return v if isinstance(v, str) else None


def meta_number(v):
    t = _text(v)
    if t is not None:
        m = re.match(r"\s*([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)\s*([A-Za-z\u00b5_/|]*)", t)
        return (float(m.group(1)), (m.group(2) or None)) if m else (None, None)
    try:
        a = np.ravel(np.asarray(v, dtype=float))
        return (float(a[0]), None) if a.size else (None, None)
    except (TypeError, ValueError):
        return None, None


def meta_lookup(table, name, exact=None, prefer=()):
    if exact:
        obj, _, key = str(exact).rpartition("@")
        hits = [r for r in table if r[1] == key and (not obj or r[0].strip("/") == obj.strip("/"))]
    else:
        rx = re.compile(META_PATTERNS[name], re.I)
        hits = [r for r in table if rx.fullmatch(str(r[1]).strip())]
        hits.sort(key=lambda r: (not any(p.lower() in r[0].lower() for p in prefer), len(r[0])))
    for obj, key, val in hits:
        num, unit = meta_number(val)
        txt = _text(val)
        if num is None and txt is None:
            continue
        if unit is None:
            for o2, k2, v2 in table:
                if o2 == obj and str(k2).lower() in (f"{key}unit".lower(), f"{key}units".lower(),
                                                      f"{key}_unit".lower(), f"{key}_units".lower()):
                    unit = _text(v2) or unit
        return dict(value=num, unit=unit, text=txt, src=f"{obj}@{key}")
    return None


def meta_length_m(hit, what):
    if hit is None or hit["value"] is None:
        return None, None
    u = (hit["unit"] or "m").strip().lower()
    f = _LEN_UNITS.get(u)
    note = hit["src"] + (f" [{hit['unit']}]" if hit["unit"] else "")
    if f is None:
        print(f"  ! unknown length unit {hit['unit']!r} for {what} at {hit['src']}, metres assumed")
        f = 1.0
    return hit["value"] * f, note


def meta_time_s(hit, default_unit):
    if hit is None or hit["value"] is None:
        return None, None
    u = (hit["unit"] or default_unit).strip().lower()
    return hit["value"] * _TIME_UNITS.get(u, _TIME_UNITS[default_unit]), hit["src"] + f" [{u}]"


def parse_raw_unit(text):
    if not text:
        return None, None
    t = str(text).lower().replace(" ", "")
    if "rad" in t:
        return "phase", 1.0
    if "strain" not in t and "\u03b5" not in t and not t.startswith(("ne", "ue", "\u00b5e")):
        return None, None
    rate = any(s in t for s in ("/s", "|s", "rate", "pers", "/sec", "s-1", "s^-1"))
    scale = 1.0
    for pre, s in (("nano", 1e-9), ("nstrain", 1e-9), ("n\u03b5", 1e-9), ("ne", 1e-9), ("micro", 1e-6),
                   ("ustrain", 1e-6), ("\u00b5strain", 1e-6), ("\u00b5\u03b5", 1e-6), ("pico", 1e-12),
                   ("pstrain", 1e-12), ("milli", 1e-3)):
        if t.startswith(pre) or f"[{pre}" in t or f"({pre}" in t:
            scale = s
            break
    return ("strain_rate" if rate else "strain"), scale


def parse_timestamp(filename):
    m = re.search(r"(\d{4})\W(\d{2})\W(\d{2})[_\s](\d{2})\W(\d{2})\W(\d{2})_UTC", filename)
    if not m:
        return None
    try:
        return datetime.datetime(*[int(x) for x in m.groups()])
    except ValueError:
        return None


def file_layout(f, cable):
    zone = find_zone(f)
    if zone is None:
        raise ValueError(f"no Zone group, top level groups {list(f.keys())}")
    ds = find_strain_dataset(zone, cable)
    if ds is None:
        raise ValueError(f"no 3-D strain rate dataset in {zone.name}, keys {list(zone.keys())}")
    nb, spb, nch = ds.shape
    sp = np.asarray(zone.attrs.get("Spacing", [1.0, 1.0])).ravel()
    dx, fs = float(sp[0]), 1000.0 / float(sp[1])
    ov = float(np.asarray(zone.attrs.get("BlockOverlap", [0])).ravel()[0])
    usable = int(round(spb / (1.0 + ov / 100.0)))
    trim = (spb - usable) // 2
    table = h5_attr_table(f)
    g, g_src = meta_length_m(meta_lookup(table, "gauge_length", exact=GAUGE_LENGTH_KEY,
                                         prefer=("Source", "Zone")), "gauge length")
    if GAUGE_LENGTH_M:
        g, g_src = float(GAUGE_LENGTH_M), "setting GAUGE_LENGTH_M (override)"
    hit = meta_lookup(table, "derivation_time", prefer=("Source", "Zone"))
    dt_s, dt_src = meta_time_s(hit, "ms")
    if hit is not None and hit["unit"] is None and hit["value"] is not None and hit["value"] < 0.1:
        dt_s, dt_src = hit["value"], hit["src"] + " [s, value below 0.1]"
    if DERIVATION_TIME_MS:
        dt_s, dt_src = float(DERIVATION_TIME_MS) / 1000.0, "setting DERIVATION_TIME_MS (override)"
    kind, unit_scale = parse_raw_unit(ds.name.rsplit("/", 1)[-1])
    x0, x0_src = 0.0, "no Origin attribute: 0 m"
    org = zone.attrs.get("Origin")
    ext = zone.attrs.get("Extent")
    if org is not None and np.size(org):
        x0, x0_src = float(np.ravel(org)[0]), f"{zone.name}@Origin[0]"
    if ext is not None and np.size(ext) >= 2:
        e = np.ravel(ext)
        if int(round(e[1] - e[0])) + 1 == nch and abs(e[0]) > 0:
            x0 += float(e[0]) * dx
            x0_src += f" + Extent[0] ({int(e[0])}) x dx"
    return ds, {"n_blocks": nb, "spb": spb, "n_ch": nch, "usable": usable, "trim": trim,
                "x0": x0, "x0_src": x0_src, "zone": zone.name, "zones": "; ".join(z.name for z in find_zones(f)),
                "n_keep": spb - 2 * trim, "dx": dx, "dx_src": f"{zone.name}@Spacing[0] [m]",
                "fs": fs, "fs_src": f"{zone.name}@Spacing[1] [ms]", "gauge_m": g, "gauge_src": g_src,
                "dt_s": dt_s, "dt_src": dt_src, "unit_kind": kind, "unit_scale": unit_scale,
                "dataset": ds.name}


def read_file(path, cable, channels):
    with open_h5(path) as f:
        ds, L = file_layout(f, cable)
        ch = np.asarray(channels, dtype=int)
        if ch.size == 0 or ch.min() < 0 or ch.max() >= L["n_ch"]:
            raise ValueError(f"channels outside 0..{L['n_ch'] - 1} in {os.path.basename(path)}")
        tb = find_time_array(f)
        tb = None if tb is None else np.asarray(tb, dtype=np.float64).ravel()
        nb, spb, fs = L["n_blocks"], L["spb"], L["fs"]
        nk = L["n_keep"]
        if tb is not None and tb.size == nb and nb > 1:
            d = np.diff(tb)
            d = d[d > 0]
            if d.size:
                step = int(round(np.median(d) * fs))
                if 0 < step <= spb:
                    nk = step
        if _step_override and 0 < _step_override <= spb:
            nk = int(_step_override)
        a = (spb - nk) // 2
        b = a + nk
        c0, c1 = int(ch.min()), int(ch.max()) + 1
        if c1 - c0 <= 4 * len(ch):
            raw = ds[:, a:b, c0:c1][:, :, ch - c0]
        else:
            raw = np.stack([ds[:, a:b, int(c)] for c in ch], axis=-1)
        raw = raw.astype(np.float32)
    x = raw.reshape(-1, len(ch))
    L["dropped_sec"] = 0.0
    L["time_note"] = ""
    ts = parse_timestamp(os.path.basename(path))
    t_name = to_posix(ts) if ts is not None else None
    good_tb = tb is not None and tb.size == nb and np.all(np.isfinite(tb))
    if good_tb and nb > 1 and np.any(np.diff(tb) <= 0):
        good_tb = False
        L["time_note"] = "block times not increasing: blocks placed end to end from the file-name time"
    if good_tb and t_name is not None and abs(float(tb[0]) - t_name) > max(120.0, 2.0 * nb * nk / fs):
        good_tb = False
        L["time_note"] = (f"block times ({from_posix(tb[0]):%Y-%m-%d %H:%M:%S}) far from the file-name time: "
                          f"blocks placed end to end from the file-name time")
    if good_tb:
        start = tb - 0.5 * nk / fs
        t0 = float(start[0])
        per = float(np.median(np.diff(tb)[np.diff(tb) > 0])) if nb > 1 and np.any(np.diff(tb) > 0) else nk / fs
        idx = np.round((tb - tb[0]) / per).astype(np.int64) * nk
        if nb > 1 and np.any(np.diff(idx) != nk):
            x = np.full((int(idx[-1]) + nk, len(ch)), np.nan, dtype=np.float32)
            for i, k in enumerate(idx):
                x[k:k + nk] = raw[i]
            L["dropped_sec"] = float(np.isnan(x[:, 0]).sum()) / fs
    else:
        if t_name is None:
            raise ValueError(f"no usable block times and no time stamp in {os.path.basename(path)}")
        t0 = t_name
        if not L["time_note"]:
            L["time_note"] = "no usable block times: blocks placed end to end from the file-name time"
    return x, t0, L


def file_info(path, cable):
    with open_h5(path) as f:
        _, L = file_layout(f, cable)
    return L


def report_metadata(path, cable, need_gauge=False):
    L = file_info(path, cable)
    print(f"metadata of {os.path.basename(path)}:")
    rows = [("gauge length", f"{L['gauge_m']:.4f} m" if L["gauge_m"] else "not found", L["gauge_src"] or "-"),
            ("derivation time", f"{L['dt_s'] * 1e3:g} ms" if L["dt_s"] else "not found", L["dt_src"] or "-"),
            ("channel spacing", f"{L['dx']:g} m", L["dx_src"]), ("sampling rate", f"{L['fs']:g} Hz", L["fs_src"]),
            ("data unit", f"{L['unit_kind']} x {L['unit_scale']:g}" if L["unit_kind"] else "not recognised",
             f"dataset name {L['dataset']}"), ("channels", str(L["n_ch"]), "data shape")]
    for name, val, src in rows:
        print(f"    {name:16s}: {val:22s} <- {src}")
    if L["unit_kind"] and L["unit_kind"] != "strain_rate":
        print(f"  ! the dataset name says {L['unit_kind']}, not strain rate: the axis labels say nstrain/s")
    if L["gauge_m"] and not 0.5 <= L["gauge_m"] <= 500:
        print(f"  ! gauge length {L['gauge_m']:g} m is unusual, check its unit ({L['gauge_src']})")
    if not L["gauge_m"]:
        with open_h5(path) as f:
            rx = re.compile(r"gauge|gage|length|^gl", re.I)
            cands = [f"{o}@{k} = {str(v)[:40]}" for o, k, v in h5_attr_table(f) if rx.search(str(k))][:10]
        msg = ("no gauge length in the metadata; attributes that could hold it: " + ("; ".join(cands) or "none") +
               ". Set GAUGE_LENGTH_KEY to the right 'object@attribute' or GAUGE_LENGTH_M to the value, "
               "--inspect FILE lists every attribute")
        if need_gauge:
            raise StopRun(msg)
        print("  ! " + msg)
    return L


def inspect_file(path):
    print(f"structure of {path}  ({os.path.getsize(path) / 1e6:.1f} MB)")
    with open_h5(path) as f:
        def show(name, obj):
            kind = f"dataset {name}  shape {obj.shape}  dtype {obj.dtype}" if isinstance(obj, h5py.Dataset)\
