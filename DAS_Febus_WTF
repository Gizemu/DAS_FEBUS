def design_filter(fs, band, order):
    nyq = fs / 2.0
    lo, hi = band
    if hi is None or hi >= 0.99 * nyq:
        return butter(order, lo, btype="highpass", fs=fs, output="sos") if lo else None
    if not lo:
        return butter(order, hi, btype="lowpass", fs=fs, output="sos")
    return butter(order, [lo, hi], btype="bandpass", fs=fs, output="sos")


def mirror_fill(y, bad):
    #every run of missing samples is replaced by the data mirrored about its left edge, cross-faded
    #(equal power, cos / sin) into the data mirrored about its right edge: continuous at both edges,
    #same noise level as the surroundings, so the filter sees no step and nothing is drawn blank
    n = len(y)
    for s, e in contiguous_runs(bad):
        g = e - s
        i = np.arange(g)
        left = y[np.clip(s - 1 - i, 0, n - 1)] if s > 0 else None
        right = y[np.clip(e + g - 1 - i, 0, n - 1)] if e < n else None
        if left is None and right is None:
            y[s:e] = 0.0
            continue
        if left is None:
            fill = right
        elif right is None:
            fill = left
        else:
            tt = (i + 0.5) / g
            wl, wr = np.cos(0.5 * np.pi * tt)[:, None], np.sin(0.5 * np.pi * tt)[:, None]
            fill = wl * left + wr * right
            fill = np.where(np.isnan(fill), left, fill)
            fill = np.where(np.isnan(fill), right, fill)
        y[s:e] = np.nan_to_num(fill)
    return y


def condition(x, fs, sos):
    #raw Febus strain rate (nstrain/s), no unit conversion and no scaling: dropped samples are mirror-filled,
    #then, only when a filter is given, linear detrend + zero-phase band pass. The values stay in nstrain/s.
    y = np.asarray(x, dtype=np.float64)
    bad = np.isnan(y).any(axis=1)
    if bad.all():
        return np.full(y.shape, np.nan)
    if bad.any():
        y = mirror_fill(y, bad)
    if sos is not None and len(y) > 6 * (2 * len(sos) + 1):
        y = sosfiltfilt(sos, detrend(y, axis=0), axis=0)
    if COMMON_MODE and y.shape[1] > 2:
        y -= np.median(y, axis=1, keepdims=True)
    return y


def channel_list(n_ch, ch_range, step=1):
    c0 = ch_range[0] or 0
    c1 = n_ch - 1 if ch_range[1] is None else min(ch_range[1], n_ch - 1)
    return list(range(c0, c1 + 1, max(1, step)))


class FilteredStream:
    #overlap-save streaming of the zero-phase filter, PAD samples of context on both sides; a gap up to
    #max_gap_sec is filled (NaN here, mirror-filled by condition), a longer gap flushes and restarts
    def __init__(self, fs, proc, chunk_sec, pad_sec, max_gap_sec=0.0):
        self.fs, self.proc = fs, proc
        self.chunk, self.pad = int(chunk_sec * fs), int(pad_sec * fs)
        self.max_gap = max_gap_sec
        self.buf, self.t0, self.head = None, None, 0
        self.filled_sec, self.restarts = 0.0, 0

    def push(self, t0, x):
        out = []
        if self.buf is not None:
            end = self.t0 + len(self.buf) / self.fs
            gap = t0 - end
            if gap < -0.5 / self.fs:
                if -gap >= len(x) / self.fs:
                    return out
                x = x[int(round(-gap * self.fs)):]
                t0 = end
            elif 0.5 / self.fs <= gap <= self.max_gap:
                nfill = int(round(gap * self.fs))
                if nfill > 0:
                    fill = np.full((nfill, x.shape[1]), np.nan, dtype=x.dtype)
                    x = np.concatenate([fill, x], axis=0)
                    self.filled_sec += nfill / self.fs
                t0 = end
            elif gap > self.max_gap:
                self.restarts += 1
                out += self.flush()
        if not len(x):
            return out
        if self.buf is None:
            self.buf, self.t0, self.head = x, t0, 0
        else:
            self.buf = np.concatenate([self.buf, x], axis=0)
        while len(self.buf) >= self.head + self.chunk + self.pad:
            stop = self.head + self.chunk
            y = self.proc(self.buf[:stop + self.pad])
            out.append((self.t0 + self.head / self.fs, y[self.head:stop]))
            cut = max(0, stop - self.pad)
            self.buf, self.t0, self.head = self.buf[cut:], self.t0 + cut / self.fs, stop - cut
        return out

    def flush(self):
        out = []
        if self.buf is not None and len(self.buf) > self.head:
            y = self.proc(self.buf)
            out.append((self.t0 + self.head / self.fs, y[self.head:]))
        self.buf, self.t0, self.head = None, None, 0
        return out


class PeakImage:
    #time x channel image with ncol rows along time ("sample", "peak" or "rms" per row), the robust noise
    #level per channel and the min / max envelope of the reference channel
    def __init__(self, a, b, fs, nch, iref, ncol, mode="sample"):
        self.a, self.b, self.fs = a, b, fs
        n_samp = max(1, int(round((b - a) * fs)))
        self.n_samp = n_samp
        self.ncol = max(1, min(int(ncol), n_samp))
        self.col_sec = (b - a) / self.ncol
        self.mode = mode
        self.kc = np.minimum(((np.arange(self.ncol) + 0.5) * n_samp / self.ncol).astype(np.int64), n_samp - 1)
        self.img = np.full((self.ncol, nch), np.nan, dtype=np.float32)
        self.lo = np.full(self.ncol, np.nan)
        self.hi = np.full(self.ncol, np.nan)
        self.med = [[] for _ in range(nch)]
        self.iref = iref
        if mode == "rms":
            self.ss = np.zeros((self.ncol, nch))
            self.nn = np.zeros((self.ncol, nch), dtype=np.float32)

    def add(self, t0, y, c0):
        k = int(round((t0 - self.a) * self.fs)) + np.arange(len(y), dtype=np.int64)
        m = (k >= 0) & (k < self.n_samp)
        if not m.any():
            return
        y, k = y[m], k[m]
        c1 = c0 + y.shape[1]
        cols = np.minimum(k * self.ncol // self.n_samp, self.ncol - 1)
        ok_rows = ~np.isnan(y).all(axis=1)
        if ok_rows.sum() > 10:
            md = np.nanmedian(np.abs(y[ok_rows]), axis=0)
            for j, v in enumerate(md):
                self.med[c0 + j].append(v)
        starts = np.concatenate([[0], np.flatnonzero(np.diff(cols)) + 1])
        uc = cols[starts]
        with np.errstate(invalid="ignore"):
            mx = np.fmax.reduceat(y, starts, axis=0)
            mn = np.fmin.reduceat(y, starts, axis=0)
        if self.mode == "rms":
            ok = ~np.isnan(y)
            self.ss[uc, c0:c1] += np.add.reduceat(np.where(ok, y, 0.0).astype(np.float64) ** 2, starts, axis=0)
            self.nn[uc, c0:c1] += np.add.reduceat(ok.astype(np.float32), starts, axis=0)
        elif self.mode == "peak":
            val = np.where(np.abs(np.nan_to_num(mn)) > np.abs(np.nan_to_num(mx)), mn, mx)
            cur = self.img[uc, c0:c1]
            take = np.isnan(cur) | (np.abs(np.nan_to_num(val)) > np.abs(np.nan_to_num(cur)))
            self.img[uc, c0:c1] = np.where(take, val, cur)
        else:
            sel = k == self.kc[cols]
            self.img[cols[sel], c0:c1] = y[sel]
        r = self.iref - c0
        if 0 <= r < y.shape[1]:
            self.lo[uc] = np.fmin(self.lo[uc], mn[:, r])
            self.hi[uc] = np.fmax(self.hi[uc], mx[:, r])

    def finish(self):
        if self.mode == "rms":
            with np.errstate(invalid="ignore", divide="ignore"):
                self.img = np.where(self.nn > 0, np.sqrt(self.ss / np.maximum(self.nn, 1)), np.nan).astype(np.float32)

    def noise_sigma(self):
        return np.array([1.4826 * np.median(v) if len(v) else np.nan for v in self.med])


def fill_time_gaps(a):
    #interpolates the missing rows of a 1-D or 2-D (time, channel) array along time, per column;
    #edges take the nearest value, an empty column becomes 0. Returns the array and the number of filled rows
    a = np.array(a, dtype=np.float64)
    two_d = a.ndim == 2
    A = a if two_d else a[:, None]
    t = np.arange(len(A))
    n_filled = int(np.isnan(A).all(axis=1).sum())
    for j in range(A.shape[1]):
        ok = np.isfinite(A[:, j])
        if ok.all():
            continue
        A[:, j] = np.interp(t, t[ok], A[ok, j]) if ok.any() else 0.0
    return (A if two_d else A[:, 0]), n_filled


def nice_limit(v):
    #rounds a colour limit up to 1, 1.5, 2, 2.5, 3, 4, 5, 6, 8 x 10^n for clean colour bar ticks
    if not np.isfinite(v) or v <= 0:
        return 1.0
    e = 10.0 ** np.floor(np.log10(v))
    for m in (1, 1.5, 2, 2.5, 3, 4, 5, 6, 8, 10):
        if m * e >= v * 0.999:
            return m * e
    return 10 * e


def log(msg):
    print(msg, flush=True)


def parse_window_time(txt):
    for fmt in ("%Y-%m-%d %H:%M:%S.%f", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            return datetime.datetime.strptime(str(txt).strip().replace("T", " "), fmt)
        except ValueError:
            continue
    raise StopRun(f"cannot read the time '{txt}', use YYYY-MM-DD HH:MM")


def select_channels(L):
    #plotted channels and the selected channel, from distances when given, else from channel numbers
    n_ch, dx = L["n_ch"], L["dx"]
    for nm, v in (("CH_START_PLOT", CH_START_PLOT), ("CH_END_PLOT", CH_END_PLOT),
                  ("SELECTED_CHANNEL", SELECTED_CHANNEL), ("DIST_START_M", DIST_START_M),
                  ("DIST_END_M", DIST_END_M), ("SELECTED_DIST_M", SELECTED_DIST_M)):
        if v is not None and (isinstance(v, bool) or not isinstance(v, (int, float, np.integer, np.floating))):
            raise StopRun(f"{nm} = {v!r} is not a number or None")
    last_d = DISTANCE_OFFSET_M + (n_ch - 1) * dx
    if DIST_START_M is not None:
        c0 = int(np.ceil((DIST_START_M - DISTANCE_OFFSET_M) / dx))
    else:
        c0 = int(CH_START_PLOT or 0)
    if DIST_END_M is not None:
        c1 = int(np.floor((DIST_END_M - DISTANCE_OFFSET_M) / dx))
    else:
        c1 = n_ch - 1 if CH_END_PLOT is None else int(CH_END_PLOT)
    if c1 > n_ch - 1:
        log(f"  ! the range is cut at the last channel of the files, Ch {n_ch - 1} ({last_d:.0f} m)")
    c0, c1 = max(0, c0), min(n_ch - 1, c1)
    if c1 <= c0:
        raise StopRun(f"empty channel range {c0}-{c1} (the files have channels 0-{n_ch - 1}, dx {dx:g} m)")
    if SELECTED_DIST_M is not None:
        ref = int(round((SELECTED_DIST_M - DISTANCE_OFFSET_M) / dx))
        log(f"  selected distance {SELECTED_DIST_M:g} m -> Ch {ref} "
            f"({DISTANCE_OFFSET_M + ref * dx:.1f} m, dx {dx:g} m)")
    else:
        ref = int(SELECTED_CHANNEL)
    if not c0 <= ref <= c1:
        raise StopRun(f"selected Ch {ref} ({DISTANCE_OFFSET_M + ref * dx:.0f} m) is outside the plotted range "
                      f"Ch {c0}-{c1} ({DISTANCE_OFFSET_M + c0 * dx:.0f}-{DISTANCE_OFFSET_M + c1 * dx:.0f} m)")
    return list(range(c0, c1 + 1)), ref


def cache_key(ta, tb, chans, ref, fs, q, L):
    #everything that changes the processed data; plot-only settings (VMAX, ylim, dpi, ticks...) are not in it
    d = dict(ta=ta, tb=tb, c0=chans[0], c1=chans[-1], ref=ref, fs=fs, q=q, bp=APPLY_BANDPASS,
             band=[F_LOW, F_HIGH, FILTER_ORDER], rows=MAX_PLOT_TIME_ROWS, cm=COMMON_MODE, gap=SHORT_GAP_SEC,
             qty="raw_strain_rate", v=4)
    return hashlib.md5(json.dumps(d, sort_keys=True, default=str).encode()).hexdigest()[:10]


def process_window(stamped, file_sec, t_start, t_end, name):
    #reads, conditions and reduces one window: waterfall image (rows x channels) and the selected-channel
    #trace at fs_eff, both in plotted units. Cached per window.
    ta, tb = to_posix(t_start), to_posix(t_end)
    pad = max(2.0, 3.0 / F_LOW) if (APPLY_BANDPASS and F_LOW) else 2.0
    paths = files_between(stamped, file_sec, ta - pad, tb + pad)
    if not paths:
        raise StopRun(f"no files between {t_start} and {t_end} UTC")
    L = report_metadata(paths[0], CABLE, need_gauge=False)
    fs, dx = L["fs"], L["dx"]
    chans, ref = select_channels(L)
    iref = chans.index(ref)
    if APPLY_BANDPASS:
        if not F_LOW and not F_HIGH:
            raise StopRun("APPLY_BANDPASS = True needs F_LOW and / or F_HIGH")
        if F_HIGH and fs / 2 <= F_HIGH:
            raise StopRun(f"F_HIGH {F_HIGH:g} Hz is above the Nyquist frequency {fs / 2:g} Hz")
        #decimation of the trace only when a low-pass edge protects it from aliasing
        q = max(1, int(np.floor(fs / max(FS_EFF or fs, 2.5 * F_HIGH)))) if F_HIGH else 1
    else:
        q = 1                                                   #raw data: every sample, no decimation

    os.makedirs(CACHE_FOLDER, exist_ok=True)
    cpath = os.path.join(CACHE_FOLDER, f"febus_{CABLE}_{name}_{cache_key(ta, tb, chans, ref, fs, q, L)}.npz")
    if USE_CACHE and os.path.exists(cpath):
        log(f"  cache hit: {os.path.basename(cpath)} (re-plot only)")
        h = np.load(cpath, allow_pickle=False)
        return {k: h[k] for k in h.files}

    sos = design_filter(fs, (F_LOW, F_HIGH), FILTER_ORDER) if APPLY_BANDPASS else None
    log(f"  {len(paths)} files, fs {fs:g} Hz, dx {dx:g} m, Ch {chans[0]}-{chans[-1]} "
        f"({DISTANCE_OFFSET_M + chans[0] * dx:.0f}-{DISTANCE_OFFSET_M + chans[-1] * dx:.0f} m), "
        f"selected Ch {ref} ({DISTANCE_OFFSET_M + ref * dx:.0f} m), fs_eff {fs / q:g} Hz")

    blocks = [chans[i:i + CHANNEL_BLOCK] for i in range(0, len(chans), CHANNEL_BLOCK)]
    proc = lambda x: condition(x, fs, sos).astype(np.float32)
    streams = [FilteredStream(fs, proc, CHUNK_SEC, pad, SHORT_GAP_SEC) for _ in blocks]
    n_samp = int(round((tb - ta) * fs))
    nrows = min(MAX_PLOT_TIME_ROWS, int(round((tb - ta) * fs / q)))
    img = PeakImage(ta, tb, fs, len(chans), iref, nrows, "sample")
    n_tr = (n_samp + q - 1) // q
    trace = np.full(n_tr, np.nan, dtype=np.float32)
    b_ref, j_ref = iref // CHANNEL_BLOCK, iref % CHANNEL_BLOCK

    def take(bi, tt, y):
        img.add(tt, y, bi * CHANNEL_BLOCK)
        if bi == b_ref:
            k = int(round((tt - ta) * fs)) + np.arange(len(y))
            m = (k >= 0) & (k < n_samp) & (k % q == 0)
            trace[k[m] // q] = y[m, j_ref]

    dropped = 0.0
    t_read = time.time()
    for k, p in enumerate(paths, 1):
        for bi, bl in enumerate(blocks):
            try:
                x, t0, Lf = read_file(p, CABLE, bl)
            except Exception as e:                               # noqa: BLE001
                log(f"  skipped {os.path.basename(p)}: {e}")
                break
            if bi == 0:
                dropped += Lf["dropped_sec"]
            i0 = max(0, int(np.floor((ta - pad - t0) * fs)))
            i1 = min(len(x), int(np.ceil((tb + pad - t0) * fs)))
            if i1 > i0:
                for tt, y in streams[bi].push(t0 + i0 / fs, x[i0:i1]):
                    take(bi, tt, y)
            del x
        if k % 10 == 0 or k == len(paths):
            log(f"  [{k}/{len(paths)}] files read  ({time.time() - t_read:.0f} s)")
        gc.collect()
    for bi, s in enumerate(streams):
        for tt, y in s.flush():
            take(bi, tt, y)
    if np.all(np.isnan(img.img)):
        raise StopRun("no data inside the window")

    Z, n_rows = fill_time_gaps(img.img)
    trace, _ = fill_time_gaps(trace)
    log(f"  gaps: {dropped:.1f} s dropped blocks + {streams[0].filled_sec:.1f} s between files mirror-filled, "
        f"{n_rows * img.col_sec:.1f} s interpolated ({streams[0].restarts} filter restarts)")
    res = dict(Z=Z.astype(np.float32), trace=trace.astype(np.float32), chans=np.array(chans), ref=np.int64(ref),
               dx=np.float64(dx), fs=np.float64(fs), fs_eff=np.float64(fs / q), gauge=np.float64(L["gauge_m"] or 0),
               noise=img.noise_sigma().astype(np.float64), ta=np.float64(ta), tb=np.float64(tb))
    np.savez(cpath, **res)
    log(f"  cache saved: {os.path.basename(cpath)}")
    return res


def clock_ticks(ta, tb, step_min):
    #tick seconds from ta: the start, every step_min on the clock, the end
    tsec = tb - ta
    if step_min is None:
        for step_min in (0.25, 0.5, 1, 2, 5, 10, 15, 30, 60, 120, 240):
            if tsec / (60 * step_min) <= 8:
                break
    step = 60.0 * step_min
    ticks = [0.0]
    t = np.ceil(ta / step) * step
    while t < tb - 1e-6:
        if t - ta > 0.04 * tsec and tb - t > 0.04 * tsec:
            ticks.append(t - ta)
        t += step
    ticks.append(tsec)
    fmt = "%H:%M:%S" if step_min < 1 or ta % 60 or tb % 60 else "%H:%M"
    return ticks, [from_posix(ta + s).strftime(fmt) for s in ticks]


def plot_window(res, name, run_n):
    Z, trace, chans = res["Z"].copy(), res["trace"], [int(c) for c in res["chans"]]
    ref, dx, fs_eff, gl = int(res["ref"]), float(res["dx"]), float(res["fs_eff"]), float(res["gauge"])
    ta, tb = float(res["ta"]), float(res["tb"])
    tsec, n_t, n_ch = tb - ta, Z.shape[0], Z.shape[1]
    qname, unit = UNIT_NAME, UNIT
    band = (f"{F_LOW or 0:g}-{F_HIGH if F_HIGH else float(res['fs']) / 2:g} Hz" if APPLY_BANDPASS
            else "unfiltered")

    #display clipping, as in the Sintela script (the values themselves are not converted)
    if SPIKE_CLIP:
        np.clip(Z, -SPIKE_CLIP, SPIKE_CLIP, out=Z)
    if PER_CH_MAD_CLIP:
        med = np.median(Z, axis=0)
        clip_v = np.maximum(MAD_MULT * np.median(np.abs(Z - med[None, :]), axis=0), 1e-12)
        n_clip = int((np.abs(Z) > clip_v[None, :]).sum())
        np.clip(Z, -clip_v[None, :], clip_v[None, :], out=Z)
        log(f"  MAD clip: {n_clip:,} samples ({100.0 * n_clip / Z.size:.3f} %)")

    noise = res["noise"]
    ok = np.isfinite(noise) & (noise > 0)
    sigma = float(np.median(noise[ok])) if ok.any() else float(np.std(Z))
    vmax = float(VMAX) if VMAX else nice_limit(VMAX_SIGMA * sigma)
    s = np.abs(Z[::max(1, n_t // 2000)]).ravel()
    log(f"  stats |{unit}|: p50={np.percentile(s, 50):.4g}  p90={np.percentile(s, 90):.4g}  "
        f"p99={np.percentile(s, 99):.4g}  max={s.max():.4g}  noise sigma={sigma:.4g}")
    sat = 100.0 * float((s >= vmax).mean())
    log(f"  VMAX={vmax:g}{'' if VMAX else ' (auto)'}  ->  {sat:.1f} % saturated"
        + ("  (VMAX is well below the noise: set VMAX = None or raise it)" if sat > 40 else ""))
    ylim = float(SIGNAL_YLIM) if SIGNAL_YLIM else nice_limit(1.2 * np.nanpercentile(np.abs(trace), 99.9))
    tr_out = 100.0 * float(np.mean(np.abs(trace) > ylim))
    if tr_out > 1:
        log(f"  ! {tr_out:.1f} % of the trace is beyond SIGNAL_YLIM={ylim:g}, raise it or set None")

    ticks, t_lbl = clock_ticks(ta, tb, TIME_TICK_INTERVAL_MIN)
    idx = np.unique(np.r_[np.arange(0, n_ch, max(1, n_ch // CH_TICKS)), n_ch - 1])
    if len(idx) > 2 and idx[-1] - idx[-2] < max(1, n_ch // CH_TICKS) / 3:
        idx = np.delete(idx, -2)
    ch_tks = [chans[i] for i in idx]
    ch_lbl = [f"Ch {c}\n{DISTANCE_OFFSET_M + c * dx:.0f} m" for c in ch_tks]
    t_tr = np.arange(len(trace)) / fs_eff

    fig = plt.figure(figsize=(FIG_WIDTH, FIG_HEIGHT), constrained_layout=True)
    gs = gridspec.GridSpec(1, 3, figure=fig, width_ratios=[1, 5, 0.08])
    ax_ts, ax_wf, ax_cb = [fig.add_subplot(gs[0, i]) for i in range(3)]

    im = ax_wf.imshow(Z, aspect="auto", cmap=CMAP, norm=Normalize(vmin=-vmax, vmax=vmax), origin="upper",
                      interpolation="none", extent=[chans[0] - 0.5, chans[-1] + 0.5, tsec, 0], rasterized=True)
    ax_wf.set_xticks(ch_tks)
    ax_wf.set_xticklabels(ch_lbl, fontsize=9)
    ax_wf.set_yticks(ticks)
    ax_wf.set_yticklabels([])
    ax_wf.set_xlabel("Channel  |  Optical Distance (m)", fontsize=12)
    ax_wf.axvline(ref, color="magenta", lw=1.2, ls="--", alpha=0.8)
    ax_wf.text(ref + 0.01 * n_ch, 0.01 * tsec, f"Ch {ref}", color="magenta", fontsize=10, va="top")
    dur = f"{tsec / 3600:.2f} h" if tsec >= 3600 else f"{tsec / 60:.2f} min"
    ax_wf.set_title(f"DAS Waterfall ({qname}, raw)  |  {band}  |  fs_eff {fs_eff:g} Hz  |  "
                    f"GL = {gl:.2f} m  |  Ch {chans[0]}-{chans[-1]}  |  "
                    f"{from_posix(ta):%Y-%m-%d %H:%M} UTC to {from_posix(tb):%H:%M} UTC  ({dur})",
                    fontsize=10, pad=6)

    ax_ts.plot(trace, t_tr, lw=0.25, color="steelblue", alpha=0.9, rasterized=True)
    ax_ts.set_ylim(tsec, 0)
    ax_ts.set_xlim(ylim, -ylim)
    ax_ts.set_yticks(ticks)
    ax_ts.set_yticklabels(t_lbl, fontsize=10)
    ax_ts.axvline(0, color="gray", lw=0.5, ls="--", alpha=0.6)
    ax_ts.set_xlabel(f"{qname} ({unit})\nCh {ref} ({band})", fontsize=10)
    ax_ts.set_ylabel("Time (UTC)", fontsize=11)
    ax_ts.grid(True, ls="--", alpha=0.2)

    fig.colorbar(im, cax=ax_cb).set_label(f"{qname} ({unit})", fontsize=10)

    os.makedirs(OUTPUT_FOLDER, exist_ok=True)
    path = os.path.join(OUTPUT_FOLDER, f"waterfall_{CABLE}_{name}_ch{ref}_{run_n:03d}.jpeg")
    fig.savefig(path, dpi=DPI_SAVE, pil_kwargs={"quality": JPEG_QUALITY, "optimize": True})
    plt.close(fig)
    gc.collect()
    log(f"  saved: {path}  ({os.path.getsize(path) / 1e6:.1f} MB)")


def main():
    global USE_CACHE
    ap = argparse.ArgumentParser(description="Febus A1-R raw strain-rate waterfall")
    ap.add_argument("--window", nargs=2, metavar=("START", "END"))
    ap.add_argument("--folder")
    ap.add_argument("--rebuild", action="store_true", help="ignore the caches")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--inspect")
    a, _ = ap.parse_known_args()
    if a.inspect:
        inspect_file(a.inspect)
        return
    if a.rebuild:
        USE_CACHE = False
    stamped, file_sec = list_files(a.folder or DATA_FOLDER, CABLE, RECURSIVE)
    if a.list:
        describe_coverage(stamped, file_sec, CABLE)
        return
    windows = WINDOWS
    if a.window:
        t0, t1 = parse_window_time(a.window[0]), parse_window_time(a.window[1])
        windows = [(a.window[0], a.window[1], f"window_{t0:%H%M}_{t1:%H%M}")]
    for ws, we, name in windows:
        t_start, t_end = parse_window_time(ws), parse_window_time(we)
        log(f"\n{'=' * 65}\n{name}: {t_start:%Y-%m-%d %H:%M:%S} -> {t_end:%H:%M:%S} UTC\n{'=' * 65}")
        if t_end <= t_start:
            log("  [!] end before start, skipped")
            continue
        try:
            res = process_window(stamped, file_sec, t_start, t_end, name)
            os.makedirs(OUTPUT_FOLDER, exist_ok=True)
            run_n = len([f for f in os.listdir(OUTPUT_FOLDER)
                         if f.startswith(f"waterfall_{CABLE}_{name}_") and f.endswith(".jpeg")]) + 1
            plot_window(res, name, run_n)
        except StopRun as stop:
            log(f"  STOPPED: {stop}")
        except Exception:                                        # noqa: BLE001
            import traceback
            log(f"  [!] error in window {name}")
            traceback.print_exc()
    log("\nAll windows completed.")


if __name__ == "__main__":
    main()
