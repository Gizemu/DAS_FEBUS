def list_files(folder, cable, recursive):
    pat = os.path.join(folder, "**", f"*{cable}*.h5") if recursive else os.path.join(folder, f"*{cable}*.h5")
    files = sorted(glob.glob(pat, recursive=recursive))
    files = [p for p in files if re.search(rf"{re.escape(cable)}(?!\d)", os.path.basename(p))]
    files = [p for p in files if not os.path.basename(p).startswith(".") and os.path.getsize(p) >= 10000]
    if not files:
        raise StopRun(f"no h5 files for cable {cable} in {folder}")
    stamped = sorted([(p, parse_timestamp(os.path.basename(p))) for p in files
                      if parse_timestamp(os.path.basename(p)) is not None], key=lambda r: r[1])
    if not stamped:
        raise StopRun("no file has a readable UTC time stamp in its name")
    gaps = np.diff([to_posix(ts) for _, ts in stamped])
    gaps = gaps[gaps > 0]
    file_sec = float(np.median(gaps)) if gaps.size else 60.0
    return stamped, file_sec


def describe_coverage(stamped, file_sec, cable):
    first, last = stamped[0][1], stamped[-1][1] + datetime.timedelta(seconds=file_sec)
    print(f"cable {cable}: {len(stamped)} files, nominal length {file_sec:.0f} s")
    print(f"  coverage {first:%Y-%m-%d %H:%M:%S} to {last:%Y-%m-%d %H:%M:%S} UTC")
    t = np.array([to_posix(ts) for _, ts in stamped])
    big = np.where(np.diff(t) > 1.5 * file_sec)[0]
    for i in big[:20]:
        print(f"  gap {stamped[i][1] + datetime.timedelta(seconds=file_sec):%Y-%m-%d %H:%M:%S}"
              f" to {stamped[i + 1][1]:%Y-%m-%d %H:%M:%S}")
    if len(big) > 20:
        print(f"  ... {len(big) - 20} more gaps")


def files_between(stamped, file_sec, a, b, margin=5.0):
    return [p for p, ts in stamped if to_posix(ts) - margin < b and to_posix(ts) + file_sec + margin > a]


def contiguous_runs(mask):
    if not np.any(mask):
        return []
    d = np.diff(np.concatenate([[0], np.asarray(mask).astype(np.int8), [0]]))
    return list(zip(np.where(d == 1)[0], np.where(d == -1)[0]))


