    raise SystemExit("no readable DAS file in the window")


class StreamDecimator:

    def __init__(self, k: int, fs_in: float, taps_per_k: int = 20):
        self.k = int(k)
        self.fs_in = float(fs_in)
        self.fs_out = self.fs_in / self.k
        self.ntaps = int(taps_per_k * self.k) | 1
        self.h = signal.firwin(self.ntaps, 1.0 / self.k, window=("kaiser", 5.0))
        self.D = (self.ntaps - 1) // 2
        self.reset()

    def reset(self) -> None:
        self.pend = None
        self.base = 0
        self.t_origin = None

    def push(self, x: np.ndarray, t0):
        x = np.asarray(x, dtype=np.float64)
        if self.t_origin is None:
            self.t_origin = UTCDateTime(t0)
            pad = np.repeat(x[:1], self.D, axis=0)
            avail = np.concatenate([pad, x], axis=0)
            self.base = -self.D
        else:
            avail = np.concatenate([self.pend, x], axis=0)
        n_valid = avail.shape[0] - self.ntaps + 1
        if n_valid <= 0:
            self.pend = avail
            return None, None
        h = self.h.reshape((-1,) + (1,) * (avail.ndim - 1))
        y = signal.fftconvolve(avail, h, mode="valid", axes=0)
        c0 = self.base + self.D
        i0 = int((-c0) % self.k)
        out = y[i0::self.k]
        m0 = (c0 + i0) // self.k
        t_out = self.t_origin + (m0 * self.k) / self.fs_in
        self.base += n_valid
        self.pend = avail[n_valid:]
        if out.shape[0] == 0:
            return None, None
        return out, t_out


def das_decimation_factor(fs_in: float, fs_out) -> int | None:
    if not fs_out or fs_out >= fs_in * (1 - 1e-9):
        return None
    k = int(round(fs_in / fs_out))
    if k < 2:
        return None
    if abs(fs_in / k - fs_out) / fs_out > 0.02:
        print(f"  NOTE: {fs_in:g} Hz is not an integer multiple of {fs_out:g} Hz;"
              f" decimating by {k} to {fs_in / k:g} Hz instead")
    return k


def das_raw_to_strain(x: np.ndarray, cfg, gauge_length: float) -> np.ndarray:
    x = np.asarray(x, dtype=np.float64) * float(cfg.das_raw_scale)
    u = str(cfg.das_raw_units).lower()
    if u == "phase":
        return x * phase_to_strain_factor(gauge_length)
    if u == "strain":
        return x
    raise SystemExit(f"das_raw_units={cfg.das_raw_units!r} is not supported "
                     f"(use 'phase' or 'strain')")


def stream_das_blocks(cfg, channels=None, fs_read=None, verbose=True):
    files = das_files_in_window(cfg)
    chs = sorted({int(c) for c in (channels if channels is not None
                                   else cfg.das_channels)})
    if not chs:
        raise SystemExit("no DAS channel selected (das_channels in CONFIG)")
    first, last = min(chs), max(chs) + 1
    t0w, t1w = window_of(cfg)
    dec = None
    meta = {}
    prev_end = None
    prog = Progress("DAS files", len(files))
    for i, path in enumerate(files):
        try:
            data, fs_f, dx_f, t_file, gl_f, nx = read_sintela_h5(path, first, last)
        except Exception as exc:
            print(f"  ! skip {os.path.basename(path)}: {exc}")
            continue
        if t0w is not None:
            nt = data.shape[0]
            i0 = max(0, int(round((t0w - t_file) * fs_f)))
            i1 = min(nt, int(round((t1w - t_file) * fs_f)))
            if i0 >= nt or i1 <= i0:
                continue
            data = data[i0:i1]
            t_file = t_file + i0 / fs_f
        cols = [c - first for c in chs if 0 <= c - first < data.shape[1]]
        if len(cols) != len(chs) or first < 0:
            raise SystemExit(
                f"DAS channel(s) {[c for c in chs if c < 0 or c >= nx]} "
                f"do not exist in {os.path.basename(path)} (the file has {nx} "
                f"loci, channels 0..{nx - 1}).")
        if not meta:
            gl = fallback_gauge_length(cfg, gl_f)
            meta = dict(fs_raw=float(fs_f), dx=float(cfg.dx or dx_f),
                        gauge_length=gl, channels=list(chs), n_loci=nx)
            k = das_decimation_factor(fs_f, fs_read)
            if k:
                dec = StreamDecimator(k, fs_f)
                meta["fs"] = dec.fs_out
                if verbose:
                    print(f"  DAS decimation : {fs_f:g} -> {dec.fs_out:g} Hz (k={k}, "
                          f"continuous across files)")
            else:
                meta["fs"] = float(fs_f)
        eps = das_raw_to_strain(data[:, cols], cfg, meta["gauge_length"])
        if prev_end is not None and abs(t_file - prev_end) > 1.5 / fs_f:
            if dec:
                dec.reset()
            if verbose:
                print(f"  DAS gap        : {prev_end} -> {t_file} "
                      f"({t_file - prev_end:.1f} s)")
        prev_end = t_file + eps.shape[0] / fs_f
        if dec is None:
            yield eps, t_file, meta["fs"], meta["channels"], meta
        else:
            y, t_out = dec.push(eps, t_file)
            if y is not None:
                yield y, t_out, meta["fs"], meta["channels"], meta
        if verbose:
            prog.step(i)
    if not meta:
        raise SystemExit("no usable DAS data in that window")


def das_trace_id(cfg, ch: int, fs: float, instrument: str = "S"):
    band = ("F" if fs >= 1000 else "C" if fs >= 250 else "H" if fs >= 80
            else "B" if fs >= 10 else "M")
    return cfg.das_net_code, f"D{int(ch):04d}"[:5], "", f"{band}{instrument}1"


def read_das_window(cfg, channels=None, fs_read=None, verbose=True):
    chs = list(channels if channels is not None else cfg.das_channels)
    est_mb = (duration_s(cfg) * (fs_read or 1000.0) * len(chs) * 8) / 1e6
    if est_mb > float(cfg.max_memory_mb):
        raise SystemExit(
            f"loading {duration_s(cfg) / 60:g} min of {len(chs)} DAS channel(s) "
            f"needs ~{est_mb:.0f} MB > max_memory_mb={cfg.max_memory_mb:g}. "
            f"Shorten START_TIME..END_TIME or raise MAX_MEMORY_MB.")
    pieces, meta = {}, {}
    for block, t_start, fs, chs_out, meta in stream_das_blocks(cfg, chs, fs_read,
                                                                verbose):
        for j, ch in enumerate(chs_out):
            pieces.setdefault(ch, []).append((t_start, fs, block[:, j].copy()))
    st = Stream()
    for ch, plist in pieces.items():
        net, sta, loc, cha = das_trace_id(cfg, ch, meta["fs"])
        for t_start, fs, d in plist:
            st += Trace(data=np.ascontiguousarray(d),
                        header=dict(network=net, station=sta, location=loc,
                                    channel=cha, sampling_rate=float(fs),
                                    starttime=UTCDateTime(t_start),
                                    npts=int(d.size)))
    if not len(st):
        raise SystemExit("no DAS data in that window")
    st.merge(method=1, fill_value=None)
    if verbose:
        print(f"  DAS            : {len(st)} trace(s), {meta['fs']:g} Hz, "
              f"dx={meta['dx']:.3f} m, GL={meta['gauge_length']:.4f} m, "
              f"K={phase_to_strain_factor(meta['gauge_length']):.4e} strain/rad")
    return st, meta


