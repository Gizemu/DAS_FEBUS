def settings_from(g: dict, description: str = "") -> Config:
    ap = argparse.ArgumentParser(description=description)
    ap.add_argument("--start", help="override START_TIME, e.g. '2025-07-18 17:00:00'")
    ap.add_argument("--end", help="override END_TIME")
    ap.add_argument("--rebuild", action="store_true", help="rebuild the timeline cache")
    a, _ = ap.parse_known_args()
    missing = [k for k in _REQUIRED if g.get(k) in (None, "")]
    if missing:
        raise SystemExit(f"set {', '.join(missing)} at the top of the script")
    kw = {}
    for name, (key, default) in _SHARED.items():
        kw[key] = g.get(name, default)
    kw["start_utc"] = str(a.start or kw["start_utc"]).strip().replace(" ", "T")
    kw["end_utc"] = str(a.end or kw["end_utc"]).strip().replace(" ", "T")
    try:
        t0, t1 = UTCDateTime(kw["start_utc"]), UTCDateTime(kw["end_utc"])
    except Exception as exc:
        raise SystemExit(f"cannot read START_TIME / END_TIME: {exc}")
    if t1 <= t0:
        raise SystemExit(f"END_TIME {t1} is not after START_TIME {t0}")
    kw["rebuild_cache"] = bool(kw["rebuild_cache"] or a.rebuild)
    ch = kw["das_channels"]
    kw["das_channels"] = [int(c) for c in ch] if isinstance(ch, (list, tuple)) else [int(ch)]
    if kw["gauge_length"] is None:
        kw["gauge_length"] = float("nan")
    kw["pre_filt"] = list(kw["pre_filt"]) if kw["pre_filt"] else None
    sta = str(kw["seis_station"] or str(kw["seis_select"]).split(".")[1]).upper()
    kw["seis_station"] = sta
    resp = kw["inventory"]
    kw["inventory"] = {sta: resp} if resp else "auto"
    kw["fig_width"], kw["fig_height"] = (float(v) for v in kw["fig_size"])
    kw["cache_dir"] = kw["cache_dir"] or kw["outdir"]
    kw.update(das_net_code="DA", seis_station_dirs={}, seis_component=None,
              component_azimuth_tolerance_deg=35.0, seis_remove_response=True,
              fs_target=None, obliquity=1.0, gauge_correct=False, gauge_water=0.2,
              acc_db_range=None, vel_db_range=None)
    os.makedirs(kw["outdir"], exist_ok=True)
    os.makedirs(kw["cache_dir"], exist_ok=True)
    return Config(**kw)


def fallback_gauge_length(cfg, value):
    if np.isfinite(value) and value > 0:
        return float(value)
    if cfg.gauge_length and np.isfinite(cfg.gauge_length):
        return float(cfg.gauge_length)
    raise SystemExit("the DAS files have no GaugeLength: set GAUGE_LENGTH_M")


def rms_series(tl, cfg, quantity):
    if tl["seis_units"] not in ("VEL", "ACC", "DISP"):
        raise SystemExit("the seismometer is in COUNTS (no response removed): amplitudes cannot "
                         "be compared. Check RESPONSE_FILE.")
    _dp, _sp, d, s = timeline_envelopes(tl, cfg, quantity)
    return d, s


def pick_event(cfg, grid, da, sa):
    if cfg.event_utc:
        return UTCDateTime(str(cfg.event_utc).replace(" ", "T")), "EVENT_TIME"
    ok = np.isfinite(da) & np.isfinite(sa) & (da > 0) & (sa > 0)
    if not ok.any():
        raise SystemExit("no bin with data from both instruments")

    def contrast(x, half=5):
        lx = np.where(ok, np.log10(np.where(x > 0, x, np.nan)), np.nan)
        out = np.full(len(x), np.nan)
        for i in np.flatnonzero(ok):
            nb = np.r_[lx[max(0, i - half):i], lx[i + 1:i + 1 + half]]
            nb = nb[np.isfinite(nb)]
            if nb.size >= 2:
                out[i] = 10 ** (lx[i] - np.median(nb))
        return out
    score = np.fmin(contrast(da), contrast(sa))
    if not np.isfinite(score).any():
        score = np.where(ok, np.fmin(da / np.nanmedian(da[ok]), sa / np.nanmedian(sa[ok])), np.nan)
    i = int(np.nanargmax(score))
    return (grid.start_of(i) + 0.5 * grid.bin_s,
            f"auto: strongest transient seen by both ({score[i]:.1f} x local background)")


def event_waveforms(cfg, t_centre):
    half = 0.5 * float(cfg.bin_s) + float(cfg.event_pad_s)
    ec = Config(**vars(cfg))
    ec.start_utc, ec.end_utc = str(t_centre - half), str(t_centre + half)
    print(f"  -- event       : reading {ec.start_utc} -> {ec.end_utc} at the native rate", flush=True)
    eps, seis, fs, t0, _t1, units, das_id, seis_id, _m, _a, _b = load_aligned_pair(ec, verbose=False)
    if units not in ("VEL", "ACC", "DISP"):
        raise SystemExit("the event panel needs the seismometer response removed (units are COUNTS)")
    a_das = np.asarray(strain_to_acceleration(eps, fs, cfg), dtype=np.float64)
    a_seis = np.asarray(seis_to_acceleration(seis, fs, units), dtype=np.float64)
    nyq = fs / 2.0
    lo, hi = float(cfg.env_fmin), min(float(cfg.env_fmax), 0.45 * fs)
    sos = signal.butter(4, [lo / nyq, hi / nyq], btype="band", output="sos")
    tap = signal.windows.tukey(len(a_das), 0.1)
    a_das = signal.sosfiltfilt(sos, (a_das - np.mean(a_das)) * tap)
    a_seis = signal.sosfiltfilt(sos, (a_seis - np.mean(a_seis)) * tap)
    t = np.arange(len(a_das)) / fs
    w = max(1, int(round(0.5 * fs)))
    env = sum(uniform_filter1d(np.abs(x), w) / (np.max(np.abs(x)) + 1e-30) for x in (a_das, a_seis))
    in_bin = (t >= float(cfg.event_pad_s)) & (t <= float(cfg.event_pad_s) + float(cfg.bin_s))
    k_pk = int(np.argmax(np.where(in_bin, env, -1)))
    nwin = int(round(float(cfg.event_win_s) * fs))
    i0 = int(np.clip(k_pk - nwin // 2, 0, max(0, len(t) - nwin)))
    x, y = a_das[i0:i0 + nwin], a_seis[i0:i0 + nwin]
    xn, yn = x - np.mean(x), y - np.mean(y)
    nrm = np.sqrt(np.sum(xn ** 2) * np.sum(yn ** 2)) + 1e-30
    cc = signal.correlate(xn, yn, mode="full") / nrm
    lags = signal.correlation_lags(len(xn), len(yn), mode="full")
    sel = np.abs(lags) <= int(round(float(cfg.event_lag_max_s) * fs))
    cc, lags = cc[sel], lags[sel]
    k = int(np.argmax(np.abs(cc)))
    lag = float(lags[k])
    if 0 < k < len(cc) - 1:
        y0, y1, y2 = np.abs(cc[k - 1:k + 2])
        den = y0 - 2 * y1 + y2
        if den != 0:
            lag += float(np.clip(0.5 * (y0 - y2) / den, -0.5, 0.5))
    r0 = float(cc[lags == 0][0]) if np.any(lags == 0) else np.nan
    flipped = bool(cfg.event_auto_polarity and cc[k] < 0)
    if flipped:
        x = -x
    return dict(t0=t0 + i0 / fs, fs=fs, das=x, seis=y, lag_s=lag / fs, r_best=float(abs(cc[k])),
                r_zero=(-r0 if flipped else r0), flipped=flipped, das_id=das_id, seis_id=seis_id,
                rms_ratio=float(np.sqrt(np.mean(x ** 2)) / (np.sqrt(np.mean(y ** 2)) + 1e-30)),
                band=(lo, hi), cc_lags=lags / fs, cc=(-cc if flipped else cc))


def save_figure(fig, cfg, suffix):
    stem, _ = out_path(cfg, suffix)
    fig.savefig(stem + ".png", dpi=cfg.dpi, bbox_inches="tight")
    plt.close(fig)
    print(f"  wrote {stem}.png", flush=True)
    return stem


def main():
    cfg = settings_from(globals(), __doc__)
    banner("Sintela DAS vs seismometer: event waveforms", cfg,
             {"DAS channel": cfg.das_channels[0], "seismometer": cfg.seis_select,
              "event": cfg.event_utc or "automatic"})
    if cfg.event_utc:
        t_ev, why = UTCDateTime(str(cfg.event_utc).replace(" ", "T")), "EVENT_TIME"
    else:
        tl = build_timeline(cfg, cfg.use_cache, cfg.rebuild_cache)
        d, s = rms_series(tl, cfg, "ACC")
        t_ev, why = pick_event(cfg, tl["grid"], d, s)
    print(f"  event centre   : {t_ev} ({why})", flush=True)
    ev = event_waveforms(cfg, t_ev)
    fig = plt.figure(figsize=(cfg.fig_width, cfg.fig_height))
    outer = fig.add_gridspec(2, 1, height_ratios=[2.0, 0.8], hspace=0.38)
    top = outer[0].subgridspec(2, 1, hspace=0.08)
    a1 = fig.add_subplot(top[0])
    a2 = fig.add_subplot(top[1], sharex=a1, sharey=a1)
    a3 = fig.add_subplot(outer[1])
    tt = np.arange(len(ev["das"])) / ev["fs"]
    a1.plot(tt, ev["das"] * 1e3, color="tab:red", lw=0.7)
    a2.plot(tt, ev["seis"] * 1e3, color="tab:blue", lw=0.7)
    m = 1.1 * max(np.max(np.abs(ev["das"])), np.max(np.abs(ev["seis"]))) * 1e3
    a1.set_ylim(-m, m)
    a1.set_ylabel(f"DAS ch{cfg.das_channels[0]}" + (" \u00d7(\u22121)" if ev["flipped"] else "")
                  + "\n[mm/s$^2$]")
    a2.set_ylabel(f"{ev['seis_id']}\n[mm/s$^2$]")
    plt.setp(a1.get_xticklabels(), visible=False)
    a2.set_xlabel(f"seconds after {ev['t0'].strftime('%Y-%m-%d %H:%M:%S.%f')[:-4]} UTC")
    for a in (a1, a2):
        a.grid(alpha=0.3)
        a.set_xlim(tt[0], tt[-1])
    lag_ms = round(1e3 * ev["lag_s"]) + 0.0
    a1.set_title(f"Do both instruments record the same waveform?   acceleration, "
                 f"{ev['band'][0]:g}-{ev['band'][1]:g} Hz, {ev['fs']:g} Hz, C_APP {cfg.c_app:g} m/s\n"
                 f"zero-lag r = {ev['r_zero']:.2f}   |   best r = {ev['r_best']:.2f} at {lag_ms:+.0f} ms "
                 f"(+ = DAS late)   |   RMS DAS/seis = {ev['rms_ratio']:.2f}   |   {why}", fontsize=10)
    if ev["flipped"]:
        a2.text(0.01, 0.04, "DAS polarity reversed for display (propagation direction / sensor orientation)",
                transform=a2.transAxes, fontsize=8, color="0.3")
    a3.plot(ev["cc_lags"] * 1e3, ev["cc"], color="tab:green", lw=1)
    a3.axvline(0, color="k", lw=0.8)
    a3.axvline(1e3 * ev["lag_s"], color="tab:green", ls="--", lw=0.8)
    a3.set_xlim(-1e3 * cfg.event_lag_max_s, 1e3 * cfg.event_lag_max_s)
    a3.set_xlabel("lag of DAS relative to the seismometer [ms] (+ = DAS late)")
    a3.set_ylabel("corr.")
    a3.grid(alpha=0.3)
    stem = save_figure(fig, cfg, "event_waveform")
    np.savez_compressed(stem + ".npz", t0=str(ev["t0"]), fs=ev["fs"], das_acc=ev["das"],
                        seis_acc=ev["seis"], lag_s=ev["lag_s"], r_zero=ev["r_zero"],
                        r_best=ev["r_best"], das_flipped=ev["flipped"])
    print(f"  wrote {stem}.npz")
    print(f"  zero-lag r = {ev['r_zero']:.3f}; best r = {ev['r_best']:.3f} at {1e3 * ev['lag_s']:+.1f} ms; "
          f"RMS DAS/seis = {ev['rms_ratio']:.3f}" + ("; DAS polarity reversed" if ev["flipped"] else ""))


if __name__ == "__main__":
    main()
