class Config(SimpleNamespace):

    def __getattr__(self, key):
        raise AttributeError(
            f"setting {key!r} is not defined in CONFIG at the top of "
            f"{os.path.basename(sys.argv[0])}")


def window_of(cfg):
    if not cfg.start_utc:
        return None, None
    return UTCDateTime(cfg.start_utc), UTCDateTime(cfg.end_utc)


def duration_s(cfg):
    t0, t1 = window_of(cfg)
    return float(t1 - t0)


def indexed(path: str, index: int | None = None):
    stem, ext = os.path.splitext(path)
    stem = re.sub(r"_\d{4}$", "", stem)
    if index is None:
        used = [int(m.group(1))
                for p in _glob.glob(f"{stem}_[0-9][0-9][0-9][0-9]*")
                for m in [re.search(r"_(\d{4})(?:_[A-Za-z]+)?(?:\.\w+)?$", p)] if m]
        index = max(used) + 1 if used else 1
    return f"{stem}_{index:04d}{ext}", index


def out_path(cfg, suffix: str, index: int | None = None):
    base = os.path.join(cfg.outdir, f"{cfg.out_prefix}_{suffix}")
    if not cfg.index_output:
        return base, 0
    return indexed(base, index)


