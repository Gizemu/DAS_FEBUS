def list_files(folder, recursive):


    if not os.path.isdir(folder):
        raise StopRun(f"DATA_FOLDER does not exist (is the disk mounted?): {folder}")
    pat = os.path.join(folder, "**", FILE_PATTERN) if recursive else os.path.join(folder, FILE_PATTERN)
    files = [p for p in sorted(glob.glob(pat, recursive=recursive))
             if p.lower().endswith(".h5") and not os.path.basename(p).startswith(".")
             and os.path.getsize(p) >= 10000]
    if not files:
        n_all = len(glob.glob(os.path.join(folder, "*")))
        raise StopRun(f"no h5 files matching {FILE_PATTERN!r} in {folder} ({n_all} entries in the folder)")
    stamped = sorted([(p, parse_timestamp(os.path.basename(p))) for p in files
                      if parse_timestamp(os.path.basename(p)) is not None], key=lambda r: r[1])
    if not stamped:
        raise StopRun(f"no file name has a UTC time stamp like YYYY-MM-DD_HH.MM.SS_UTC, e.g. "
                      f"{os.path.basename(files[0])}")
    gaps = np.diff([to_posix(ts) for _, ts in stamped])
    gaps = gaps[gaps > 0]
    file_sec = float(np.median(gaps)) if gaps.size else 60.0
    log(f"{len(stamped)} files in {folder}, {stamped[0][1]:%Y-%m-%d %H:%M:%S} to "
        f"{stamped[-1][1] + datetime.timedelta(seconds=file_sec):%Y-%m-%d %H:%M:%S} UTC, {file_sec:.0f} s each")
    return stamped, file_sec


def files_between(stamped, file_sec, a, b, margin=5.0):
    return [p for p, ts in stamped if to_posix(ts) - margin < b and to_posix(ts) + file_sec + margin > a]


def check_window(stamped, file_sec, ta, tb):

    first = to_posix(stamped[0][1])
    last = to_posix(stamped[-1][1]) + file_sec
    span = f"{from_posix(first):%Y-%m-%d %H:%M:%S} to {from_posix(last):%Y-%m-%d %H:%M:%S} UTC"
    if tb <= first or ta >= last:
        raise StopRun(f"the window {from_posix(ta):%Y-%m-%d %H:%M} - {from_posix(tb):%H:%M} UTC is outside the "
                      f"recording ({span}); change WINDOWS")
    if ta < first or tb > last:
        log(f"  ! the window is only partly inside the recording ({span}), the rest stays empty")


def contiguous_runs(mask):
    if not np.any(mask):
        return []
    d = np.diff(np.concatenate([[0], np.asarray(mask).astype(np.int8), [0]]))
    return list(zip(np.where(d == 1)[0], np.where(d == -1)[0]))


def parse_window_time(txt):
    for fmt in ("%Y-%m-%d %H:%M:%S.%f", "%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M"):
        try:
            return datetime.datetime.strptime(str(txt).strip().replace("T", " "), fmt)
        except ValueError:
            continue
    raise StopRun(f"cannot read the time '{txt}', use YYYY-MM-DD HH:MM")


def next_path(base, ext):

    os.makedirs(OUTPUT_FOLDER, exist_ok=True)
    rx = re.compile(re.escape(base) + r"_(\d{4,})\.[A-Za-z0-9]+$")
    used = [int(m.group(1)) for m in map(rx.match, os.listdir(OUTPUT_FOLDER)) if m]
    return os.path.join(OUTPUT_FOLDER, f"{base}_{max(used, default=0) + 1:04d}.{ext}")


CACHE_VERSION = 5


def sat_settings_tag():
    """Short hash of the saturation settings; part of every cache name / key."""
    txt = json.dumps([SAT_DETECT, SAT_MIN_REPEATS, SAT_MIN_SIGMA, SAT_PILEUP, SAT_EDGE_QUANTA, DAS_FULL_SCALE, SEIS_FULL_SCALE_COUNTS,
                      SPIKE_DETECT, SPIKE_SIGMA, SPIKE_MAX_SAMPLES, PHASE_SAT_FRACTION, PHASE_WRAPPED, SAT_REPAIR_MAX_SAMPLES, SAT_GUARD_SEC], default=str)
    return hashlib.md5(txt.encode()).hexdigest()[:6]


_step_override = None


_cache_stats = {"hit": 0, "built": 0, "rebuilt": 0, "off": 0}


_rebuild = False


def reader_tag():
    """Hash of the reader settings: changing any of them invalidates layouts and caches."""
    txt = json.dumps([RAW_DATASET_PATHS, SAMPLING_RATE_HZ, GAUGE_LENGTH_M, DX_M, RAW_UNIT, RAW_SCALE, DATA_TIME_AXIS,
                      PHASE_WRAPPED, NEFF, WAVELENGTH, STRAIN_OPTIC_COEFF], default=str)
    return hashlib.md5(txt.encode()).hexdigest()[:6]


def cache_tag():
    return f"_r{reader_tag()}_q{sat_settings_tag()}"


def cache_path(path, ch):
    base = os.path.splitext(os.path.basename(path))[0]
    return os.path.join(CACHE_FOLDER, f"{base}_{CABLE}_ch{ch}{cache_tag()}.npz")


def cache_folders():
    out = [CACHE_FOLDER] + [f for f in (LEGACY_CACHE_FOLDERS or []) if f]
    return [f for i, f in enumerate(out) if f and f not in out[:i]]


def cache_valid(h, st):


    if 'version' not in h.files or int(h['version']) != CACHE_VERSION:
        return False
    if int(h['src_size']) != st.st_size:
        return False
    if CACHE_CHECK_MTIME and abs(float(h['src_mtime']) - st.st_mtime) > 2.5:
        return False
    return True


def find_cache(name, st):
    if not USE_CACHE or _rebuild:
        return None
    for folder in cache_folders():
        cp = os.path.join(folder, name)
        if not os.path.exists(cp):
            continue
        try:
            h = np.load(cp, allow_pickle=False)
            if cache_valid(h, st):
                return h
            h.close()
        except Exception:
            continue
    return None


def write_channel_cache(path, ch, y, t0, L, st, sat=((), ())):
    cp = cache_path(path, ch)
    try:
        os.makedirs(CACHE_FOLDER, exist_ok=True)
        with open(cp + ".tmp", "wb") as fh:
            np.savez(fh, x=y.astype(np.float32), t0=np.float64(t0), fs=np.float64(L["fs"]),
                     src_size=np.int64(st.st_size), src_mtime=np.float64(st.st_mtime),
                     version=np.int64(CACHE_VERSION), channel=np.int64(ch), time_note=str(L.get("time_note", "")),
                     sat_masked=np.asarray(sat[0], dtype=np.int64), sat_bridged=np.asarray(sat[1], dtype=np.int64))
        os.replace(cp + ".tmp", cp)
        _cache_stats["built"] += 1
    except OSError as e:
        log(f"  ! cannot write the cache in {CACHE_FOLDER} ({e}), continuing without it")


def read_channels_cached(path, chans):
    st = os.stat(path)
    out, t0, info, missing, sat = {}, None, {}, [], {}
    for ch in chans:
        h = find_cache(os.path.basename(cache_path(path, ch)), st)
        if h is None:
            missing.append(ch)
            continue
        with h:
            _cache_stats["hit"] += 1
            out[ch] = h["x"].astype(np.float32)
            t0 = float(h["t0"])
            info = {"fs": float(h["fs"]), "time_note": str(h["time_note"]) if "time_note" in h.files else ""}
            sat[ch] = (h["sat_masked"] if "sat_masked" in h.files else np.zeros(0, np.int64),
                       h["sat_bridged"] if "sat_bridged" in h.files else np.zeros(0, np.int64))
    if missing:
        y, t0m, L = read_file(path, missing)
        for j, ch in enumerate(missing):
            out[ch] = y[:, j].astype(np.float32)
            sat[ch] = (L["sat_masked"][j], L["sat_bridged"][j])
            if USE_CACHE:
                write_channel_cache(path, ch, y[:, j], t0m, L, st, sat[ch])
            else:
                _cache_stats["off"] += 1
        if t0 is not None and abs(t0 - t0m) > 1e-6:
            raise ValueError("cached and new channels of this file are not aligned: run with --rebuild")
        t0 = t0m
        info = {"fs": L["fs"], "time_note": L.get("time_note", "")}
    n = min(len(v) for v in out.values())
    info["sat"] = {ch: (sat[ch][0][sat[ch][0] < n], sat[ch][1][sat[ch][1] < n]) for ch in chans}
    return np.stack([out[ch][:n] for ch in chans], axis=1), t0, info


_layouts = {}


_db = {"layout": None, "meta": None, "dirty": set()}


def db_path(kind):
