def db_load(kind):
    import json
    if _db[kind] is None:
        _db[kind] = {}
        if USE_CACHE and not _rebuild:
            for folder in reversed(cache_folders()):
                fp = os.path.join(folder, f"{kind}_{CABLE}.json")
                if os.path.exists(fp):
                    try:
                        with open(fp, encoding="utf-8") as fh:
                            _db[kind].update(json.load(fh))
                    except Exception:
