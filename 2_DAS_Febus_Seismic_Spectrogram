    return _db[kind]


def db_save():
    import json
    if not USE_CACHE:
        return
    for kind in list(_db["dirty"]):
        try:
            os.makedirs(CACHE_FOLDER, exist_ok=True)
            fp = db_path(kind)
            with open(fp + ".tmp", "w", encoding="utf-8") as fh:
                json.dump(_db[kind], fh)
            os.replace(fp + ".tmp", fp)
        except OSError as e:
            log(f"  ! cannot write {db_path(kind)} ({e})")
    _db["dirty"].clear()


def x0_of(L):
    return float(DISTANCE_OFFSET_M) if DISTANCE_OFFSET_M is not None else float(L.get("x0", 0.0) or 0.0)


def layout_of(path):
    if path in _layouts:
        return _layouts[path]
    db = db_load("layout")
    n, size = os.path.basename(path), os.path.getsize(path)
    e = db.get(n)
    if e is not None and e.get("src_size") == size and "x0" in e and e.get("reader") == reader_tag() and e.get("cache_version") == CACHE_VERSION:
        L = dict(e)
    else:
        L = file_info(path)
        L = {k: v for k, v in L.items() if isinstance(v, (int, float, str, bool)) or v is None}
        L["src_size"] = size
        L["reader"] = reader_tag()
        L["cache_version"] = CACHE_VERSION
        db[n] = L
        _db["dirty"].add("layout")
    _layouts[path] = L
    return L


def convert_seismic():
    from obspy import read
    src = sorted(glob.glob(os.path.join(SEIS_FOLDER, SEIS_PATTERN)))
    if not src:
        raise StopRun(f"no seismic files matching {SEIS_PATTERN!r} in {SEIS_FOLDER}")
    os.makedirs(SEIS_CONVERTED_FOLDER, exist_ok=True)
    out, rows = [], []
    for p in src:
        name = os.path.basename(p)
        stem = name[:-3] if name.lower().endswith(".gz") else name
        stem = re.sub(r"\.(mseed|miniseed|msd|sac|seed)$", "", stem, flags=re.I)
        dst = os.path.join(SEIS_CONVERTED_FOLDER, stem + ".mseed")
        if os.path.exists(dst) and os.path.getsize(dst) > 0 and os.path.getmtime(dst) >= os.path.getmtime(p) and not _rebuild:
            out.append(dst)
            rows.append((name, "already converted", os.path.basename(dst)))
            continue
        try:
            raw = gzip.open(p, "rb").read() if name.lower().endswith(".gz") else open(p, "rb").read()
            st = read(io.BytesIO(raw))
            fmt = st[0].stats._format if len(st) else "?"
            if fmt == "MSEED":
                with open(dst + ".tmp", "wb") as fh:
                    fh.write(raw)
            else:
                for tr in st:
                    if tr.data.dtype.kind == "f" and tr.data.dtype.itemsize == 8:
                        tr.data = tr.data.astype(np.float64)
                st.write(dst + ".tmp", format="MSEED")
            os.replace(dst + ".tmp", dst)
            out.append(dst)
            rows.append((name, f"{fmt} -> MSEED, {len(st)} traces", os.path.basename(dst)))
        except Exception as e:
            rows.append((name, f"NOT CONVERTED: {e}", "-"))
            log(f"  ! {name} could not be converted: {e}")
    log(f"  seismic files: {len(out)} of {len(src)} ready in {SEIS_CONVERTED_FOLDER}")
    return out, rows


def response_files():
    if not RESPONSE_FILE:
        return []
    items = RESPONSE_FILE if isinstance(RESPONSE_FILE, (list, tuple)) else [RESPONSE_FILE]
    out = []
    for it in items:
        hits = sorted(glob.glob(str(it))) if any(c in str(it) for c in "*?[") else ([str(it)] if os.path.isfile(str(it)) else [])
        out += [h for h in hits if h not in out]
    return out


def load_inventory():
    files = response_files()
    if not files:
        return None
    from obspy import read_inventory
    inv = None
    for fpath in files:
        try:
            part = read_inventory(fpath)
        except Exception as e:
            log(f"  ! response file {os.path.basename(fpath)} not readable: {e}")
            continue
        inv = part if inv is None else inv + part
        log(f"  response file {os.path.basename(fpath)}: " + ", ".join(
            f"{n.code}.{s_.code}.{c.location_code}.{c.code}" for n in part for s_ in n for c in s_))
    if inv is None:
        raise StopRun("none of the response files could be read")
    return inv


_resp_cache = {}


def response_lookup(inv, tr):
    from obspy import UTCDateTime
    key = tr.id
    if key in _resp_cache:
        return _resp_cache[key]
    try:
        r = inv.get_response(tr.id, UTCDateTime(tr.stats.starttime))
        _resp_cache[key] = (r, f"{tr.id} (exact)")
        return _resp_cache[key]
    except Exception:
        pass
    if RESPONSE_MATCH == "exact":
        _resp_cache[key] = None
        return None
    cha = tr.stats.channel
    fam, comp = cha[:2].upper(), cha[-1:].upper()
    alias = {"1": "1N", "N": "N1", "2": "2E", "E": "E2", "Z": "Z3", "3": "3Z"}
    cands = []
    for n in inv:
        for s_ in n:
            for c in s_:
                if c.response is None:
                    continue
                if c.code == cha:
                    score = 8
                elif c.code[:2].upper() == fam and c.code[-1:].upper() in alias.get(comp, comp):
                    score = 4
                else:
                    continue
                score += 2 if s_.code == tr.stats.station else 0
                score += 1 if n.code == tr.stats.network else 0
                cands.append((score, f"{n.code}.{s_.code}.{c.location_code}.{c.code}", c.response))
    if not cands:
        _resp_cache[key] = None
        return None
    cands.sort(key=lambda r: -r[0])
    _resp_cache[key] = (cands[0][2], f"{cands[0][1]} (matched by {'channel code' if cands[0][0] >= 8 else 'component'})")
    log(f"  response for {tr.id}: {_resp_cache[key][1]}")
    return _resp_cache[key]


def response_for(inv, tr):
    r = response_lookup(inv, tr)
    if r is None:
        raise StopRun(f"no response for {tr.id} in the response file(s); run --list-seismic to compare the codes")
    return r


_excluded = {}


def waveform_ok(tr):
    if tr.stats.sampling_rate is None or not np.isfinite(tr.stats.sampling_rate) or tr.stats.sampling_rate <= 0:
        return f"sampling rate {tr.stats.sampling_rate} (log / state-of-health record)"
    if tr.stats.npts == 0:
        return "no samples"
    if getattr(tr.data, "dtype", None) is None or tr.data.dtype.kind not in "iuf":
        return f"non-numeric samples ({getattr(tr.data, 'dtype', '?')})"
    return None


def traces_window(trs, t0, t1):
    fs = trs[0].stats.sampling_rate
    n = int(round((t1 - t0) * fs))
    y = np.full(n, np.nan)
    for tr in trs:
        if tr.stats.endtime.timestamp < t0 or tr.stats.starttime.timestamp > t1:
            continue
        data = tr.data
        data = np.ma.filled(data.astype(np.float64), np.nan) if np.ma.isMaskedArray(data) else data.astype(np.float64)
        i0 = int(round((tr.stats.starttime.timestamp - t0) * fs))
        s0, s1 = max(0, i0), min(n, i0 + len(data))
        if s1 > s0:
            seg = data[s0 - i0:s1 - i0]
            ok = ~np.isnan(seg)
            y[s0:s1][ok] = seg[ok]
    return y, fs


def das_window(stamped, file_sec, t0, t1, dist, fs):
    y = np.full(int(round((t1 - t0) * fs)), np.nan)
    flag = np.zeros(len(y), dtype=np.int8)
    ch_used = None
    for p in files_between(stamped, file_sec, t0, t1):
        try:
            L = layout_of(p)
            ch = int(round((dist - x0_of(L)) / L["dx"]))
            if not 0 <= ch < L["n_ch"] or abs(L["fs"] / fs - 1.0) > 1e-4:
                continue
            Y, tf, info = read_channels_cached(p, [ch])
            ch_used = ch
        except Exception as e:
            log(f"  ! {os.path.basename(p)}: {e}")
            continue
        x = Y[:, 0].astype(np.float64)
        i0 = int(round((tf - t0) * fs))
        s0, s1 = max(0, i0), min(len(y), i0 + len(x))
        if s1 > s0:
            seg = x[s0 - i0:s1 - i0]
            ok = ~np.isnan(seg)
            y[s0:s1][ok] = seg[ok]
            for code, idx in ((1, info["sat"][ch][1]), (2, info["sat"][ch][0])):
                k = idx + i0
                k = k[(k >= s0) & (k < s1)]
                flag[k] = code
    return y, ch_used, flag


def _robust_centre_sigma(v):
    v = v[np.isfinite(v)]
    if v.size < 16:
        return np.nan, np.nan
    med = float(np.median(v))
    return med, 1.4826 * float(np.median(np.abs(v - med)))


def _noise_sigma(v, n_chunks=64):
    """Robust sigma of the quiet part of a trace: the 20th percentile of the MAD
    sigmas of short chunks, so a strong event filling much of the record does not
    inflate the noise estimate."""
    v = v[np.isfinite(v)]
    if v.size < 64:
        return np.nan
    k = max(32, v.size // n_chunks)
    m = v.size // k
    C = v[:m * k].reshape(m, k)
    s_ = 1.4826 * np.median(np.abs(C - np.median(C, axis=1, keepdims=True)), axis=1)
    s_ = s_[s_ > 0]
    return float(np.percentile(s_, 20)) if s_.size else np.nan


def _grow(flag, n):
    """Widen every True run of a boolean array by n samples on both sides."""
    if n <= 0 or not flag.any():
        return flag
    out = flag.copy()
    for a, b in contiguous_runs(flag):
        out[max(0, a - n):b + n] = True
    return out


def clipped_samples(y, full_scale=None):
    """Flat-top clipping.

    A recorder at full scale writes the same extreme value again and again; a
    real waveform passes its largest peak once. Candidates are the samples that
    carry the record's maximum (or minimum) value when that value lies
    SAT_MIN_SIGMA noise sigmas from the median and occurs >= SAT_MIN_REPEATS
    times. A candidate run is accepted only if the trace runs into or out of it
    with a step of >= SAT_EDGE_QUANTA quantisation steps: a rail cuts a waveform
    off while it is still moving, whereas the crest of a large long-period wave
    in integer counts can repeat a value but is entered with a step of about one
    count. The extreme must also "pile up": occur SAT_PILEUP times more often
    than the values just inside it, which separates a rail from the crests of a
    steady tone. Float DAS data have a tiny quantisation step, so for them any
    exact repetition of the extreme far from the median counts."""
    n = len(y)
    flag = np.zeros(n, dtype=bool)
    ok = np.isfinite(y)
    if ok.sum() < 64:
        return flag
    v = y[ok]
    med, _ = _robust_centre_sigma(v)
    sig = _noise_sigma(v)
    if not np.isfinite(sig):
        return flag
    d = np.abs(np.diff(v))
    d = d[d > 0]
    q = float(np.percentile(d, 1.0)) if d.size else 0.0


    q0 = float(d.min()) if d.size else 0.0
    sub = v[:: max(1, v.size // 20000)]
    quantised = q0 > 0 and np.mean(np.abs(sub / q0 - np.round(sub / q0)) < 1e-3) > 0.9
    thr = (SAT_MIN_SIGMA if quantised else 3.0) * max(sig, 1e-30)
    cand = np.zeros(n, dtype=bool)
    with np.errstate(invalid="ignore"):
        for ext in (float(v.max()), float(v.min())):
            if abs(ext - med) < thr:
                continue
            tol = abs(ext) * 1e-12
            hit = ok & (np.abs(y - ext) <= tol)
            n_hit = int(hit.sum())
            if n_hit < SAT_MIN_REPEATS:
                continue


            span = 10.0 * q
            inside = ok & ~hit & (np.abs(y - ext) < span)
            density = inside.sum() / 10.0
            if n_hit >= SAT_PILEUP * density:
                cand |= hit
    if cand.any():
        edge_thr = SAT_EDGE_QUANTA * q
        for a, b in contiguous_runs(cand):
            steps = [abs(y[a] - y[a - 1]) if a > 0 else 0.0, abs(y[b] - y[b - 1]) if b < n else 0.0]
            steps = [x for x in steps if np.isfinite(x)]
            if steps and max(steps) >= edge_thr:
                flag[a:b] = True
    if full_scale:
        with np.errstate(invalid="ignore"):
            flag |= ok & (np.abs(y) >= 0.999 * float(full_scale))
    return flag


def spike_samples(y):
    """Isolated spikes (phase-unwrapping errors).

    Hampel-type test: the deviation from a (2*SPIKE_MAX_SAMPLES+1)-sample running
    median must exceed SPIKE_SIGMA times the LOCAL spread of the trace (running
    median of |sample-to-sample change| over 21 samples, which a spike of 1-3
    samples cannot raise) and the quiet-noise level. A strong but smooth or
    oscillating real signal raises its own local spread and is never flagged;
    only runs of <= SPIKE_MAX_SAMPLES samples that come back to the level the
    trace had before them qualify."""
    from scipy.ndimage import median_filter
    flag = np.zeros(len(y), dtype=bool)
    width = 2 * int(SPIKE_MAX_SAMPLES) + 1
    wide = max(21, 3 * width)
    for a, b in contiguous_runs(np.isfinite(y)):
        if b - a < 4 * wide:
            continue
        seg = np.asarray(y[a:b], dtype=np.float64)
        r = seg - median_filter(seg, size=width, mode="nearest")
        dd = np.abs(np.diff(seg, prepend=seg[0]))
        loc = 1.05 * median_filter(dd, size=wide, mode="nearest")
        floor = _noise_sigma(r)
        floor = floor if np.isfinite(floor) else 0.0
        scale = np.maximum(loc, floor)
        if not np.any(scale > 0):
            continue
        hit = (scale > 0) & (np.abs(r) > SPIKE_SIGMA * scale)
        if not hit.any():
            continue
        for p, q in contiguous_runs(hit):
            if q - p > SPIKE_MAX_SAMPLES or p == 0 or q >= len(seg):
                continue


            base = 0.5 * (seg[p - 1] + seg[q])
            amp = np.max(np.abs(seg[p:q] - base))
            if abs(seg[q] - seg[p - 1]) <= 0.25 * amp:
                flag[a + p:a + q] = True
    return flag


def fix_saturation(y, fs, kind):
    """Repair recording saturation in one trace (kind 'das' or 'seis').

    Returns (y_fixed, idx_masked, idx_bridged): clipped runs (+ guard) become NaN,
    short spikes are bridged with a short cubic between their finite neighbours, longer
    spike runs become NaN. Nothing else is changed."""
    y = np.array(y, dtype=np.float64, copy=True)
    fin = np.isfinite(y)
    empty = np.zeros(0, dtype=np.int64)
    if not SAT_DETECT and not (SPIKE_DETECT and kind == "das"):
        return y, empty, empty
    n = len(y)


    spike = spike_samples(y) if (SPIKE_DETECT and kind == "das") else np.zeros(n, dtype=bool)
    clip = clipped_samples(np.where(spike, np.nan, y), DAS_FULL_SCALE if kind == "das" else SEIS_FULL_SCALE_COUNTS) \
        if SAT_DETECT else np.zeros(n, dtype=bool)
    clip = _grow(clip, int(round(SAT_GUARD_SEC * fs)))
    spike &= ~clip
    masked = clip.copy()
    bridged = np.zeros(n, dtype=bool)
    for a, b in contiguous_runs(spike):


        nb = 4
        lo, hi = np.arange(max(0, a - nb), a), np.arange(b, min(n, b + nb))
        lo = lo[np.isfinite(y[lo]) & ~masked[lo] & ~spike[lo]]
        hi = hi[np.isfinite(y[hi]) & ~masked[hi] & ~spike[hi]]
        if (b - a) <= SAT_REPAIR_MAX_SAMPLES and lo.size >= 1 and hi.size >= 1:
            k = np.r_[lo, hi]
            deg = min(3, k.size - 1)
            c = np.polyfit(k - a, y[k], deg)
            y[a:b] = np.polyval(c, np.arange(a, b) - a)
            bridged[a:b] = True
        else:
            g = int(round(SAT_GUARD_SEC * fs))
            masked[max(0, a - g):min(n, b + g)] = True
    masked &= fin
    y[masked] = np.nan
    bridged &= ~masked
    return y, np.flatnonzero(masked).astype(np.int64), np.flatnonzero(bridged).astype(np.int64)


def welch_psd(y, fs, nper):
    """Gap-aware, one-sided Welch PSD with detrending, averaging ONLY valid runs.

    Every contiguous run begins its OWN Welch grid, so good windows are not
    incorrectly rejected merely because an unrelated earlier gap shifted the
    window start. This is essential for long/low-frequency bands.
    """
    nper = int(nper)
    if nper < 8:
        return None
    hop = max(1, nper//2)
    win = np.hanning(nper+1)[:-1]
    scale = 1.0/(fs*np.sum(win**2))
    tt = np.arange(nper, dtype=np.float64)-(nper-1)/2.0
    tt2 = np.dot(tt,tt)
    acc = np.zeros(nper//2+1, dtype=np.float64)
    n = 0
    for start,stop in contiguous_runs(np.isfinite(y)):
        if stop-start < nper:
            continue
        for i in range(start,stop-nper+1,hop):
            seg = np.asarray(y[i:i+nper], dtype=np.float64)
            seg = seg - np.mean(seg)
            seg = seg-tt*(np.dot(seg,tt)/tt2)
            F = np.fft.rfft(seg*win)
            acc += (F.real**2+F.imag**2)
            n += 1
    if n == 0:
        return None
    P = (acc/n)*scale
    if nper % 2 == 0:
        P[1:-1] *= 2.0
    else:
        P[1:] *= 2.0
    return P


def welch_psd_gapaware(y, fs, nper, min_hz, min_cycles=PSD_MIN_CYCLES):
    """Find the longest useful window size that fits real contiguous samples.

    No interpolation across absent recordings. Returned PSD has the sample units
    squared / Hz. Minimum frequency with >= min_cycles in the selected FFT length
    must be respected by the caller.
    """
    y = np.asarray(y, dtype=np.float64)
    runs = contiguous_runs(np.isfinite(y))
    if not runs:
        return None
    longest = max(b-a for a,b in runs)
    candidates = [min(int(nper), int(longest))]
    for factor in PSD_FALLBACK_FACTORS:
        candidates.append(min(int(longest), int(round(nper*factor))))
    seen = set()
    candidates = [n for n in candidates if n > 3 and not (n in seen or seen.add(n))]
    for n in candidates:
        if (n / fs) * min_hz < min_cycles:

            continue
        P = welch_psd(y, fs, n)
        if P is not None:
            f = np.fft.rfftfreq(n, d=1.0/fs)
            return f, P, min_cycles*fs/n, n

    for n in candidates:
        if n/fs < 1.0:
            continue
        P = welch_psd(y, fs, n)
        if P is not None:
            f = np.fft.rfftfreq(n, d=1.0/fs)
            return f, P, min_cycles*fs/n, n
    return None


def rebin_psd_without_fabrication(freq, power, centres, usable, cutoff):
    """Log-interpolate positive PSD values, excluding unresolved spectral bins.

    Interpolates the *representation* of measured PSD samples, never missing time
    series data. Do not infer frequencies below the effective FFT resolution.
    """
    out = np.full(len(centres), np.nan, dtype=np.float64)
    valid = np.isfinite(power) & (power > 0) & (freq > 0)
    if np.count_nonzero(valid) < 2:
        return out
    f, p = freq[valid], power[valid]
    keep = usable & (centres >= max(float(cutoff), float(f[0]))) & (centres <= f[-1])
    if np.any(keep):
        out[keep] = np.exp(np.interp(np.log(centres[keep]), np.log(f), np.log(p)))
    return out


def log_map(f_src, centres, edges, use):
    rows, cols = [], []
    for j in np.flatnonzero(use):
        m = np.flatnonzero((f_src >= edges[j]) & (f_src < edges[j + 1]))
        if m.size == 0:
            m = np.array([int(np.argmin(np.abs(np.log(np.maximum(f_src, 1e-12)) - np.log(centres[j]))))])
        rows += [j] * m.size
        cols += list(m)
    rows, cols = np.array(rows), np.array(cols)
    cnt = np.bincount(rows, minlength=len(centres)).astype(float)
    return rows, cols, cnt


def apply_map(P, mp, n_out):
    rows, cols, cnt = mp
    out = np.zeros(n_out)
    np.add.at(out, rows, P[cols])
    with np.errstate(invalid="ignore", divide="ignore"):
        return np.where(cnt > 0, out / cnt, np.nan)


def seis_index(paths):
    from obspy import read
    ip = os.path.join(CACHE_FOLDER, "seis_index.json")
    idx = {}
    if USE_CACHE and os.path.exists(ip) and not _rebuild:
        try:
            with open(ip, encoding="utf-8") as fh:
                idx = json.load(fh)
        except Exception:
            idx = {}
    changed = False
    out = []
    for p in paths:
        k = os.path.abspath(p)
        st_ = os.stat(p)
        e = idx.get(k)
        if e is None or e.get("size") != st_.st_size or (CACHE_CHECK_MTIME and abs(e.get("mtime", -999999) - st_.st_mtime) > 2.5):
            try:
                st = read(p, headonly=True)
                e = {"size": st_.st_size, "mtime": st_.st_mtime, "t0": min(t.stats.starttime.timestamp for t in st),
                     "t1": max(t.stats.endtime.timestamp for t in st),
                     "ids": sorted({f"{t.id}|{t.stats.sampling_rate:g}" for t in st})}
            except Exception as ex:
                e = {"size": st_.st_size, "mtime": st_.st_mtime, "t0": None, "t1": None, "ids": [], "error": str(ex)}
            idx[k] = e
            changed = True
        out.append((p, e))
    if changed and USE_CACHE:
        try:
            os.makedirs(CACHE_FOLDER, exist_ok=True)
            with open(ip + ".tmp", "w", encoding="utf-8") as fh:
                json.dump(idx, fh)
            os.replace(ip + ".tmp", ip)
        except OSError:
            pass
    return out


def choose_seis_id(index, ta, tb):
    import fnmatch
    pat = f"{SEIS_NETWORK}.{SEIS_STATION}.{SEIS_LOCATION}.{SEIS_CHANNEL}"
    rates = {}
    for p, e in index:
        if e.get("t0") is None or e["t1"] < ta or e["t0"] > tb:
            continue
        for s in e["ids"]:
            i, r = s.split("|")
            if fnmatch.fnmatchcase(i, pat) and float(r) > 0:
                rates[i] = float(r)
    if not rates:
        raise StopRun(f"no seismic channel {pat} with data in the window (check SEIS_* and the time span)")
    ids = sorted(rates)
    if len(ids) > 1:
        log(f"  ! {len(ids)} seismic channels match {pat}: {', '.join(ids)}; using {ids[0]} (set SEIS_CHANNEL to choose)")
    return ids[0], rates[ids[0]]


def seis_block(index, sid, b0, b1):
    from obspy import read, UTCDateTime
    net, sta, loc, cha = sid.split(".")
    trs = []
    for p, e in index:
        if e.get("t0") is None or e["t1"] < b0 or e["t0"] > b1:
            continue
        try:
            st = read(p, starttime=UTCDateTime(b0), endtime=UTCDateTime(b1))
        except Exception as ex:
            log(f"  ! {os.path.basename(p)}: {ex}")
            continue
        for tr in st.select(network=net, station=sta, location=loc, channel=cha):
            if waveform_ok(tr) is None:
                trs.append(tr)
    if not trs:
        return None, None
    main = max({t.stats.sampling_rate for t in trs}, key=lambda r: sum(t.stats.sampling_rate == r for t in trs))
    trs = sorted([t for t in trs if t.stats.sampling_rate == main], key=lambda t: t.stats.starttime)
    return traces_window(trs, b0, b1)[0], trs[0]


def detrend_log(x):
    from scipy.ndimage import median_filter
    lx = np.log10(np.where(x > 0, x, np.nan))
    ok = np.isfinite(lx)
    if ok.sum() < 10:
        return lx
    filled = np.interp(np.arange(len(lx)), np.flatnonzero(ok), lx[ok])
    w = max(3, int(round(ENV_DETREND_MIN * 60.0 / RMS_STEP_SEC)) | 1)
    out = filled - median_filter(filled, size=min(w, len(filled) | 1), mode="nearest")
    out[~ok] = np.nan
    return out


def env_xcorr(a, b):
    la, lb = detrend_log(a), detrend_log(b)
    kmax = int(round(LAG_MAX_SEC / RMS_STEP_SEC))
    lags = np.arange(-kmax, kmax + 1)
    r = np.full(len(lags), np.nan)
    n_used = 0
    for i, k in enumerate(lags):
        x, y = (la[k:], lb[:len(lb) - k]) if k >= 0 else (la[:k], lb[-k:])
        ok = np.isfinite(x) & np.isfinite(y)
        if ok.sum() > 20:
            r[i] = np.corrcoef(x[ok], y[ok])[0, 1]
            n_used = max(n_used, int(ok.sum()))
    if not np.isfinite(r).any():
        return lags * RMS_STEP_SEC, r, np.nan, np.nan, np.nan
    j = int(np.nanargmax(r))
    shift = 0.0
    if 0 < j < len(r) - 1 and np.all(np.isfinite(r[j - 1:j + 2])):
        den = r[j - 1] - 2 * r[j] + r[j + 1]
        shift = 0.5 * (r[j - 1] - r[j + 1]) / den if den != 0 else 0.0


    return lags * RMS_STEP_SEC, r, float(r[j]), float((lags[j] + shift) * RMS_STEP_SEC), np.nan


def row_normalise(P, allowed=None):
    Q = np.where(allowed, P, 0.0) if allowed is not None else P
    return P / np.maximum(Q.max(axis=1, keepdims=True), 1e-30)


def contrast_of(P, allowed):
    Q = np.where(allowed, P, np.nan)
    with np.errstate(invalid="ignore", divide="ignore"):
        return np.nanmax(Q, axis=1) / np.maximum(np.nanmean(Q, axis=1), 1e-30)


def track(Pn, c, allowed, smooth):
    nf, nc = Pn.shape
    score = np.where(allowed, Pn, -1.0)
    jump = smooth * np.abs(np.arange(nc)[:, None] - np.arange(nc)[None, :])
    cost = score[0].copy()
    back = np.zeros((nf, nc), dtype=np.int32)
    for i in range(1, nf):
        tot = cost[None, :] - jump
        back[i] = np.argmax(tot, axis=1)
        cost = tot[np.arange(nc), back[i]] + score[i]
    j = np.zeros(nf, dtype=int)
    j[-1] = int(np.argmax(cost))
    for i in range(nf - 1, 0, -1):
        j[i - 1] = back[i][j[i]]
    cp = c[j].astype(float)
    lo, hi = np.full(nf, np.nan), np.full(nf, np.nan)
    dc = c[1] - c[0]
    for i in range(nf):
        jj = j[i]
        if 0 < jj < nc - 1:
            y0, y1, y2 = Pn[i, jj - 1], Pn[i, jj], Pn[i, jj + 1]
            den = y0 - 2 * y1 + y2
            if den < 0 and y1 >= y0 and y1 >= y2:
                cp[i] = c[jj] + float(np.clip(0.5 * (y0 - y2) / den, -0.5, 0.5)) * dc
        a = b = jj
        while a > 0 and Pn[i, a - 1] >= 0.5 * Pn[i, jj]:
            a -= 1
        while b < nc - 1 and Pn[i, b + 1] >= 0.5 * Pn[i, jj]:
            b += 1
        lo[i], hi[i] = c[a], c[b]
    peak = Pn[np.arange(nf), j]
    on = allowed[np.arange(nf), j]
    return dict(c=cp, lo=lo, hi=hi, j=j, peak=peak, on=on)


def reliability(T, contrast, q_thresh, split, tol, c, Praw, art=None, max_jump=None):
    Pm = np.where(art, 0.0, Praw) if art is not None else Praw
    glob_ratio = Pm[np.arange(len(T["j"])), T["j"]] / np.maximum(Pm.max(axis=1), 1e-30)
    T["global_ratio"] = glob_ratio
    ok = T["on"] & (contrast >= q_thresh) & (T["peak"] >= 0.5) & (glob_ratio >= 0.5)
    ok &= (T["c"] > c[0] + (c[1] - c[0])) & (T["c"] < c[-1] - (c[1] - c[0]))
    ok &= (T["hi"] - T["lo"]) / np.maximum(T["c"], 1e-9) < 0.6
    if split is not None:
        diff = np.abs(split[0]["c"] - split[1]["c"])
        ok &= diff <= tol * T["c"]
        T["lo"] = np.minimum(T["lo"], T["c"] - diff)
        T["hi"] = np.maximum(T["hi"], T["c"] + diff)
        T["split_diff"] = diff
    if max_jump and ok.sum() >= 5:
        from scipy.ndimage import median_filter
        idx = np.flatnonzero(ok)
        med = median_filter(T["c"][idx], size=min(9, len(idx) | 1), mode="nearest")
        ok[idx[np.abs(T["c"][idx] - med) > max_jump * med]] = False
    T["ok"] = ok
    return T


def broken_xy(x, y, ok, tol=0.10):
    xs, ys = [], []
    prev = None
    for xi, yi, oi in zip(x, y, ok):
        if not oi or not np.isfinite(yi):
            xs.append(xi)
            ys.append(np.nan)
            prev = None
            continue
        if prev is not None and abs(yi - prev) > tol * prev:
            xs.append(xi)
            ys.append(np.nan)
        xs.append(xi)
        ys.append(yi)
        prev = yi
    return np.array(xs), np.array(ys)


def tone_rows(P, f):
    from scipy.ndimage import median_filter
    w = max(3, int(round(TONE_WIN_HZ / max(f[1] - f[0], 1e-9))) | 1)
    bad = np.zeros(len(f), dtype=bool)
    for v in (np.median(P, axis=1), P.max(axis=1)):
        ref = median_filter(v, size=w, mode="nearest")
        with np.errstate(divide="ignore", invalid="ignore"):
            bad |= 10 * np.log10(v / np.maximum(ref, 1e-30)) > TONE_DB
    return bad


def notch(P, bad):
    if not bad.any() or bad.all():
        return P
    good = np.flatnonzero(~bad)
    out = P.copy()
    for i in np.flatnonzero(bad):
        j = np.searchsorted(good, i)
        lo = good[max(0, j - 1)]
        hi = good[min(len(good) - 1, j)]
        if lo == hi:
            out[i] = P[lo]
        else:
            w = (i - lo) / (hi - lo)
            out[i] = (1 - w) * P[lo] + w * P[hi]
    return out


def noise_floor(P, k, kmin, dx):
    sel = (np.abs(k) >= kmin) & (np.abs(k) <= 0.5 / dx)
    return np.median(P[:, sel], axis=1)


def fk_to_fc_wrap(P, f, k, c, sign, dx):
    kn = 0.5 / dx
    order = np.argsort(k)
    ks = k[order]
    out = np.zeros((len(f), len(c)))
    for i, fi in enumerate(f):
        kt = sign * fi / c
        kw = ((kt + kn) % (2.0 * kn)) - kn
        out[i] = np.interp(kw, ks, P[i, order])
    return out


