def decimate_nan(y, fs, fs_t):
    """Polyphase decimation of each observed contiguous span, never across gaps.

    Returns NaNs for missing data. Long filters are not allowed to mix separate
    acquired segments across an unobserved interval.
    """
    from scipy.signal import resample_poly
    q = max(1, int(np.floor(fs / fs_t)))
    y = np.asarray(y, dtype=np.float64)
    if q == 1:
        return y, fs
    nout = (len(y) + q - 1) // q
    out = np.full(nout, np.nan, dtype=np.float64)
    good = np.isfinite(y)
    for left, right in contiguous_runs(good):

        first = (left + q - 1) // q
        last = right // q
        if last <= first:
            continue
        sl = y[first*q:last*q]
        if len(sl) < 4*q:
            continue
        filt = resample_poly(sl, 1, q)

        if len(filt) > 4:
            out[first+2:min(last-2, first+len(filt)-2)] = filt[2:max(2, min(len(filt)-2, last-first-2))]
    return out, fs/q


def tier_setup(fs, fny):
    out = []
    for i, (flo, fhi, seg, ctx) in enumerate(TIERS):
        hi = fny if fhi is None else min(fhi, fny)
        if flo >= hi:
            continue
        lo_b = flo / (TIER_BLEND if i > 0 else 1.0)
        hi_b = hi * (TIER_BLEND if fhi is not None else 1.0)
        fs_t = fs if fhi is None else min(fs, 4.0 * min(hi_b, fny))
        q = max(1, int(np.floor(fs / fs_t)))
        out.append(dict(flo=flo, fhi=hi, lo_b=lo_b, hi_b=min(hi_b, fny), seg=seg, ctx=ctx, q=q, fs=fs / q,
                        nper=int(round(seg * fs / q)), last=fhi is None))
    return out


def tier_weights(centres, tiers):
    W = np.zeros((len(tiers), len(centres)))
    for i, t in enumerate(tiers):
        lc = np.log(centres)
        w = ((centres >= t["lo_b"]) & (centres <= t["hi_b"])).astype(float)
        if i > 0:
            a, b = np.log(t["lo_b"]), np.log(t["flo"] * TIER_BLEND)
            m = (lc >= a) & (lc < b)
            w[m] = 0.5 - 0.5 * np.cos(np.pi * (lc[m] - a) / max(b - a, 1e-9))
        if not t["last"]:
            a, b = np.log(t["fhi"] / TIER_BLEND), np.log(t["hi_b"])
            m = (lc > a) & (lc <= b)
            w[m] = 0.5 + 0.5 * np.cos(np.pi * (lc[m] - a) / max(b - a, 1e-9))
        W[i] = w
    s = W.sum(axis=0)
    return W / np.where(s > 0, s, 1.0)


def measure_c(stamped, file_sec, ta, tb, L):
    from scipy.signal import detrend
    from scipy.signal.windows import hann, tukey
    dx, fs = L["dx"], L["fs"]
    x0 = x0_of(L)
    jc = int(round((SELECTED_DIST_M - x0) / dx))
    h = int(round(C_HALF_APERTURE_M / dx))
    chans = np.arange(max(0, jc - h), min(L["n_ch"] - 1, jc + h) + 1)
    sel = [p for p, ts in stamped if ta <= to_posix(ts) < tb]
    if len(sel) > C_FILES_MAX:
        sel = [sel[i] for i in np.linspace(0, len(sel) - 1, int(C_FILES_MAX)).round().astype(int)]
    key = hashlib.md5(json.dumps(dict(files=[(os.path.basename(p), os.path.getsize(p)) for p in sel], ch=[int(chans[0]), int(chans[-1])],
                                      w=C_WIN_SEC, f=[C_FMIN, C_NF], c=[C_MIN, C_MAX, C_NC], q=C_Q_THRESH, mw=C_MIN_WAVELENGTHS,
                                      s=C_SMOOTHNESS, st=C_SPLIT_TOL, mj=C_MAX_JUMP, gap=C_MAX_GAP, t=[TONE_DB, TONE_WIN_HZ],
                                      cable=CABLE, reader=reader_tag(), off=DISTANCE_OFFSET_M, v=CACHE_VERSION, sat=sat_settings_tag()), sort_keys=True).encode()).hexdigest()[:12]
    for folder in (cache_folders() if USE_CACHE and not _rebuild else []):
        cand = os.path.join(folder, "results", f"cmeas_{key}.npz")
        if os.path.exists(cand):
            try:
                with np.load(cand, allow_pickle=False) as hh:
                    log(f"  C(f) from the result cache ({os.path.basename(cand)})")
                    return {k: hh[k] for k in hh.files}
            except Exception:
                pass
    nwin = int(round(C_WIN_SEC * fs))
    nch = len(chans)
    fall = np.fft.rfftfreq(nwin, 1.0 / fs)
    fm = (fall >= C_FMIN) & (fall <= fs / 2.0)
    nk = int(2 ** np.ceil(np.log2(nch * 4)))
    k = np.fft.fftshift(np.fft.fftfreq(nk, dx))
    tt = hann(nwin)[:, None]
    xt = tukey(nch, 0.5)[None, :]
    acc = np.zeros((2, int(fm.sum()), nk))
    nh = np.zeros(2, dtype=int)
    t_run = time.time()
    for i, p in enumerate(sel):
        try:
            X, t0, _ = read_file(p, chans)
        except Exception as e:
            log(f"  ! {os.path.basename(p)}: {e}")
            continue
        for s0 in range(0, len(X) - nwin + 1, nwin // 2):
            w = X[s0:s0 + nwin]
            if np.isnan(w).any():
                continue
            w = detrend(w.astype(np.float64), axis=0)
            sd = w.std(axis=0)
            w = w / np.where(sd > 0, sd, 1.0)[None, :]
            U = np.fft.rfft(w * tt, axis=0)[fm] * xt
            K = np.fft.fftshift(np.fft.ifft(U, n=nk, axis=1) * nk, axes=1)
            hf = int(np.floor((t0 + s0 / fs) / C_WIN_SEC * 2 + 1e-6)) % 2
            acc[hf] += K.real ** 2 + K.imag ** 2
            nh[hf] += 1
        if (i + 1) % 10 == 0 or i + 1 == len(sel):
            log(f"  C(f): {i + 1}/{len(sel)} files  ({time.time() - t_run:.0f} s)")
    if nh.min() < 2:
        raise StopRun("C(f): too few complete windows around the selected channel")
    f = fall[fm]
    P = acc.sum(axis=0) / nh.sum()
    Ph = [acc[j] / nh[j] for j in range(2)]
    tones = tone_rows(P, f)
    if tones.any():
        P = notch(P, tones)
        Ph = [notch(H, tones) for H in Ph]
    aperture = (nch - 1) * dx
    kmin = C_MIN_WAVELENGTHS / aperture
    E = np.maximum(P - noise_floor(P, k, kmin, dx)[:, None], 0.0)
    Eh = [np.maximum(H - noise_floor(H, k, kmin, dx)[:, None], 0.0) for H in Ph]
    idx = np.unique(np.searchsorted(f, np.geomspace(f[0], f[-1], int(C_NF))).clip(0, len(f) - 1))
    fs_ = f[idx]
    c = np.linspace(C_MIN, C_MAX, int(C_NC))
    gl = L.get("gauge_m")
    curves = []
    for sign in (1, -1):
        Pc = fk_to_fc_wrap(E[idx], fs_, k, c, sign, dx)
        Pr = fk_to_fc_wrap(P[idx], fs_, k, c, sign, dx)
        allowed = (c[None, :] >= 2.0 * dx * fs_[:, None]) & (fs_[:, None] * aperture / c[None, :] >= C_MIN_WAVELENGTHS)
        if gl:
            allowed &= fs_[:, None] / c[None, :] < 0.9 / gl
        Pn = row_normalise(Pc, allowed)
        T = track(Pn, c, allowed, C_SMOOTHNESS)
        split = [track(row_normalise(fk_to_fc_wrap(H[idx], fs_, k, c, sign, dx), allowed), c, allowed, C_SMOOTHNESS) for H in Eh]
        T = reliability(T, contrast_of(Pr, allowed), C_Q_THRESH, split, C_SPLIT_TOL, c, Pr, None, C_MAX_JUMP)
        curves.append(T)
    a, b = curves
    cc = np.full(len(fs_), np.nan)
    lo = np.full(len(fs_), np.nan)
    hi = np.full(len(fs_), np.nan)
    both = a["ok"] & b["ok"]
    cc[both] = np.sqrt(a["c"][both] * b["c"][both])
    for T in (a, b):
        only = T["ok"] & ~both
        cc[only] = T["c"][only]
    for i in range(len(fs_)):
        vals = [T for T in (a, b) if T["ok"][i]]
        if vals:
            lo[i] = min(T["lo"][i] for T in vals)
            hi[i] = max(T["hi"][i] for T in vals)
    ok = np.isfinite(cc)
    band = (np.nan, np.nan)
    c_fill = np.full(len(fs_), np.nan)
    if ok.sum() >= 5:
        idx_ok = np.flatnonzero(ok)
        runs, start = [], idx_ok[0]
        for p_, q_ in zip(idx_ok[:-1], idx_ok[1:]):
            if fs_[q_] / fs_[p_] - 1.0 > C_MAX_GAP:
                runs.append((start, p_))
                start = q_
        runs.append((start, idx_ok[-1]))
        r0, r1 = max(runs, key=lambda r: np.log(fs_[r[1]] / fs_[r[0]]) if r[1] > r[0] else -1)
        seg = ok.copy()
        seg[:r0] = False
        seg[r1 + 1:] = False
        if seg.sum() >= 5:
            band = (float(fs_[r0]), float(fs_[r1]))
            m = (fs_ >= band[0]) & (fs_ <= band[1])
            c_fill[m] = np.exp(np.interp(np.log(fs_[m]), np.log(fs_[seg]), np.log(cc[seg])))
    inb = (fs_ >= band[0]) & (fs_ <= band[1]) if np.isfinite(band).all() else np.zeros(len(fs_), dtype=bool)
    res = dict(f=fs_, c=np.where(inb, cc, np.nan), lo=np.where(inb, lo, np.nan), hi=np.where(inb, hi, np.nan),
               ok=ok & inb, c_fill=c_fill, band=np.array(band), fwd=a["c"], bwd=b["c"],
               fwd_ok=a["ok"] & inb, bwd_ok=b["ok"] & inb, outside=ok & ~inb, n_windows=nh, n_files=len(sel), ch0=int(chans[0]), ch1=int(chans[-1]),
               aperture=aperture, tones=f[tones])
    if USE_CACHE:
        try:
            rp = os.path.join(CACHE_FOLDER, "results", f"cmeas_{key}.npz")
            os.makedirs(os.path.dirname(rp), exist_ok=True)
            with open(rp + ".tmp", "wb") as fh:
                np.savez(fh, **res)
            os.replace(rp + ".tmp", rp)
        except OSError as e:
            log(f"  ! cannot write the result cache ({e})")
    return res


def c_at(C, fq):
    if not np.isfinite(C["band"]).all():
        return np.full(len(fq), np.nan)
    m = (fq >= C["band"][0]) & (fq <= C["band"][1])
    out = np.full(len(fq), np.nan)
    good = np.isfinite(C["c_fill"])
    out[m] = np.exp(np.interp(np.log(fq[m]), np.log(C["f"][good]), np.log(C["c_fill"][good])))
    return out


def rms_band(C, fny_s, fny_d):
    if RMS_BAND != "auto":
        return float(RMS_BAND[0]), float(RMS_BAND[1])
    if not np.isfinite(C["band"]).all():
        return None
    a = max(float(C["band"][0]), 2.0 / RMS_STEP_SEC)
    b = min(float(C["band"][1]), 0.95 * fny_s, 0.95 * fny_d)
    return (a, b) if b > a * 1.2 else None


def seis_vel_gain(inv, tr, f):
    """Counts PSD -> velocity PSD gain, with response water-level and taper.

    Invalid frequencies including above instrument Nyquist get zero gain.
    """
    f = np.asarray(f, dtype=np.float64)
    g = np.zeros(len(f), dtype=np.float64)
    nyq = 0.5 * float(tr.stats.sampling_rate)
    hi1 = SEIS_PREFILT_HIGH_FRACTION[0]*nyq
    hi2 = SEIS_PREFILT_HIGH_FRACTION[1]*nyq
    ok = (f >= SEIS_PREFILT_LO_HZ[0]) & (f < hi2) & (f > 0)
    if not np.any(ok):
        return g
    H = np.asarray(response_for(inv, tr)[0].get_evalresp_response_for_frequencies(f[ok], output='VEL'))
    ampsq = np.abs(H)**2
    good = np.isfinite(ampsq) & (ampsq > 0)
    if not np.any(good):
        return g
    floor = max(float(np.nanmax(ampsq[good])) * 10**(-SEIS_RESPONSE_WATERLEVEL_DB/10), 1e-300)
    ff = f[ok]
    taper = np.ones(len(ff))
    a,b = SEIS_PREFILT_LO_HZ
    m = ff < b
    taper[m] = np.sin(0.5*np.pi*np.clip((ff[m]-a)/max(b-a,1e-12),0,1))**2
    m = ff > hi1
    taper[m] = np.cos(0.5*np.pi*np.clip((ff[m]-hi1)/max(hi2-hi1,1e-12),0,1))**2
    gain = (taper**2)/np.maximum(ampsq, floor)
    gain[~good] = 0
    g[ok] = gain
    return g


def envelope(y, fs, gain, df):
    n = int(round(RMS_STEP_SEC * fs))
    k = len(y) // n
    if k == 0:
        return np.zeros(0)
    Y = y[:k * n].reshape(k, n)
    bad = np.isnan(Y).any(axis=1)
    Y = np.where(bad[:, None], 0.0, Y)
    Y = Y - Y.mean(axis=1, keepdims=True)
    win = 0.5 - 0.5 * np.cos(2.0 * np.pi * np.arange(n) / n)
    F = np.fft.rfft(Y * win, axis=1)
    P = (F.real ** 2 + F.imag ** 2) * (2.0 / (fs * np.sum(win ** 2)))
    r = np.sqrt(np.sum(P * gain[None, :], axis=1) * df) * 1e6
    r[bad] = np.nan
    return r


def diff_gain(f, L):
    """1 / sinc^2(f/fs): undoes the roll-off of the first difference used to turn
    phase (or strain) into strain rate. 1 for data recorded as a rate."""
    if not DAS_DIFF_CORRECTION or L.get("unit_kind") not in ("phase", "strain"):
        return np.ones(len(np.atleast_1d(f)))
    s = np.sinc(np.asarray(f, dtype=np.float64) / float(L["fs"]))
    return 1.0 / np.maximum(s, 0.3) ** 2


def compute(stamped, file_sec, ta, tb, L, index, sid, fs_s, inv, C):
    fs_d = L["fs"]
    fny_d, fny_s = fs_d / 2.0, fs_s / 2.0
    g0 = np.floor(ta / CELL_SEC) * CELL_SEC
    n_cells = int(np.ceil((tb - g0) / CELL_SEC))
    band = rms_band(C, fny_s, fny_d)
    files = [(os.path.basename(p), os.path.getsize(p)) for p in files_between(stamped, file_sec, ta, tb)]
    key = hashlib.md5(json.dumps(dict(files=files, seis=[(os.path.basename(p), e.get("size")) for p, e in index],
                                      sid=sid, ta=ta, tb=tb, dist=SELECTED_DIST_M, cell=CELL_SEC, tiers=TIERS, bl=TIER_BLEND,
                                      nb=N_FREQ_BINS, fmin=F_MIN, env=[RMS_STEP_SEC, band], dc=DAS_DIFF_CORRECTION,
                                      cf=np.round(np.nan_to_num(C["c_fill"]), 2).tolist(),
                                      resp=[os.path.basename(x) for x in response_files()], cable=CABLE, reader=reader_tag(),
                                      off=DISTANCE_OFFSET_M, v=CACHE_VERSION, sat=sat_settings_tag()), sort_keys=True, default=str).encode()).hexdigest()[:12]
    for folder in (cache_folders() if USE_CACHE and not _rebuild else []):
        cand = os.path.join(folder, "results", f"dasseis3_{key}.npz")
        if os.path.exists(cand):
            try:
                with np.load(cand, allow_pickle=False) as h:
                    log(f"  spectrograms from the result cache ({os.path.basename(cand)})")
                    return {k: h[k] for k in h.files}
            except Exception:
                pass
    edges = np.geomspace(F_MIN, min(F_MAX, fny_d*0.99), int(N_FREQ_BINS) + 1)
    centres = np.sqrt(edges[:-1] * edges[1:])
    inst = {}
    for name, fs, fny in (("d", fs_d, fny_d), ("s", fs_s, fny_s)):
        tiers = tier_setup(fs, fny)
        for t in tiers:
            ft = np.fft.rfftfreq(t["nper"], 1.0 / t["fs"])
            use = (centres >= t["lo_b"]) & (centres <= t["hi_b"])
            t["f"] = ft
            t["map"] = log_map(ft, centres, edges, use)
            t["use"] = use
        ne = int(round(RMS_STEP_SEC * fs))
        fe = np.fft.rfftfreq(ne, 1.0 / fs)
        inst[name] = dict(fs=fs, fny=fny, tiers=tiers, W=tier_weights(centres, tiers), fe=fe, inb=centres <= fny)
        if name == "d":
            ce = c_at(C, fe)
            g = np.zeros(len(fe))
            if band is not None:
                m = (fe >= band[0]) & (fe <= band[1]) & np.isfinite(ce) & (fe > 0)
                g[m] = DAS_STRAIN_RATE_TO_STRAIN_PER_S**2 * ce[m] ** 2 / (2.0 * np.pi * fe[m]) ** 2 * diff_gain(fe[m], L)
            inst[name]["ge"] = g
    pad = max(t["ctx"] for t in inst["d"]["tiers"]) / 2.0
    S_d = np.full((n_cells, len(centres)), np.nan, dtype=np.float32)
    S_s = np.full((n_cells, len(centres)), np.nan, dtype=np.float32)
    cov_d, cov_s = np.zeros(n_cells), np.zeros(n_cells)
    tier_cov_d = np.zeros((len(inst["d"]["tiers"]), n_cells), dtype=bool)
    tier_cov_s = np.zeros((len(inst["s"]["tiers"]), n_cells), dtype=bool)
    spc = int(round(CELL_SEC / RMS_STEP_SEC))
    env_d = np.full(n_cells * spc, np.nan)
    env_s = np.full(n_cells * spc, np.nan)

    satc = {k: np.zeros((2, n_cells), dtype=np.float32) for k in ("d", "s")}
    cells_per_block = max(1, int(round(BLOCK_MIN * 60.0 / CELL_SEC)))
    n_blocks = int(np.ceil(n_cells / cells_per_block))
    ch_used = None
    t_run = time.time()
    for bi, c0 in enumerate(range(0, n_cells, cells_per_block), 1):
        c1 = min(n_cells, c0 + cells_per_block)
        b0, b1 = g0 + c0 * CELL_SEC, g0 + c1 * CELL_SEC
        yd, ch, fl_d = das_window(stamped, file_sec, b0 - pad, b1 + pad, SELECTED_DIST_M, fs_d)
        ch_used = ch if ch is not None else ch_used
        ys, tr0 = seis_block(index, sid, b0 - pad, b1 + pad)
        fl_s = None
        if ys is not None:
            ys, im, ib = fix_saturation(ys, fs_s, "seis")
            fl_s = np.zeros(len(ys), dtype=np.int8)
            fl_s[ib] = 1
            fl_s[im] = 2
        if tr0 is not None and "ge" not in inst["s"]:
            I = inst["s"]
            fe = I["fe"]
            g = np.zeros(len(fe))
            if band is not None:
                m = (fe >= band[0]) & (fe <= band[1])
                g[m] = seis_vel_gain(inv, tr0, fe[m])
            I["ge"] = g
            for t in I["tiers"]:
                t["gain"] = seis_vel_gain(inv, tr0, t["f"])
        for name, y, S, cov, env, fl in (("d", yd, S_d, cov_d, env_d, fl_d), ("s", ys, S_s, cov_s, env_s, fl_s)):
            if y is None:
                continue
            I = inst[name]
            if name == "s" and "ge" not in I:
                continue
            fs = I["fs"]
            ipad, nc = int(round(pad * fs)), int(round(CELL_SEC * fs))
            core = y[ipad:ipad + (c1 - c0) * nc]
            if len(core) != (c1-c0)*nc:
                log(f"  ! {name}: incomplete block core: expected {(c1-c0)*nc} samples, got {len(core)}")
            e = envelope(core, fs, I["ge"], 1.0 / RMS_STEP_SEC)
            env[c0 * spc:c0 * spc + len(e)] = e
            for c in range(c0, c1):
                cell = core[(c - c0) * nc:(c - c0 + 1) * nc]
                cov[c] = np.isfinite(cell).mean() if cell.size else 0.0
                fc = fl[ipad + (c - c0) * nc:ipad + (c - c0 + 1) * nc]
                if fc.size:
                    satc[name][0, c] = np.mean(fc == 1)
                    satc[name][1, c] = np.mean(fc == 2)
            lay = []
            for t in I["tiers"]:
                yt, fst = decimate_nan(y, fs, t["fs"]) if t["q"] > 1 else (y, fs)
                lay.append((t, yt, fst))
            for c in range(c0, c1):
                if cov[c] < MIN_COVERAGE:
                    continue
                tc = (c - c0 + 0.5) * CELL_SEC + pad
                acc = np.zeros(len(centres))
                wsum = np.zeros(len(centres))
                for ti, (t, yt, fst) in enumerate(lay):
                    i0 = int(round((tc - t["ctx"] / 2.0) * fst))
                    seg = yt[max(0, i0):max(0, i0) + int(round(t["ctx"] * fst))]
                    result = welch_psd_gapaware(seg, fst, t["nper"], t["flo"])
                    if result is None:
                        continue
                    fp, P, fcut, n_used = result
                    if name == "s":


                        if n_used == t["nper"]:
                            P = P * t["gain"]
                        else:
                            P = P * seis_vel_gain(inv, tr0, fp)
                    else:
                        P = P * diff_gain(fp, L)
                    v = rebin_psd_without_fabrication(fp, P, centres, t["use"], fcut)
                    if np.isfinite(v).any():
                        (tier_cov_d if name == "d" else tier_cov_s)[ti, c] = True
                    w = I["W"][ti] * np.isfinite(v)
                    with np.errstate(divide="ignore", invalid="ignore"):
                        acc += np.where(w > 0, w * np.log(np.maximum(v, 1e-300)), 0.0)
                    wsum += w
                out = np.where((wsum > 0.35) & I["inb"], np.exp(acc / np.maximum(wsum, 1e-12)), np.nan)
                S[c] = out.astype(np.float32)
        log(f"  block {bi}/{n_blocks} {from_posix(b0):%Y-%m-%d %H:%M}  ({time.time() - t_run:.0f} s)")
    db_save()
    res = dict(f=centres, fedges=edges, t=g0 + np.arange(n_cells) * CELL_SEC, S_d=S_d, S_s=S_s, cov_d=cov_d, cov_s=cov_s,
               env_t=g0 + (np.arange(n_cells * spc) + 0.5) * RMS_STEP_SEC, env_d=env_d, env_s=env_s,
               ch=-1 if ch_used is None else ch_used, fs_d=fs_d, fs_s=fs_s,
               band=np.array(band if band is not None else (np.nan, np.nan)),
               tier_cov_d=tier_cov_d, tier_cov_s=tier_cov_s, sat_d=satc["d"], sat_s=satc["s"])
    if USE_CACHE:
        try:
            rp = os.path.join(CACHE_FOLDER, "results", f"dasseis3_{key}.npz")
            os.makedirs(os.path.dirname(rp), exist_ok=True)
            with open(rp + ".tmp", "wb") as fh:
                np.savez(fh, **res)
            os.replace(rp + ".tmp", rp)
        except OSError as e:
            log(f"  ! cannot write the result cache ({e})")
    return res


def display(S, scale):
    import warnings
    with np.errstate(divide='ignore', invalid='ignore'):
        D = 10.0*np.log10(np.where(S > 0, S*scale, np.nan))
    with warnings.catch_warnings():
        warnings.simplefilter('ignore', RuntimeWarning)
        if SPEC_DISPLAY == 'absolute':
            return D, None
        med = np.nanmedian(D, axis=0, keepdims=True)
        if SPEC_DISPLAY == 'relative':
            return D-med, None
        mad = 1.4826*np.nanmedian(np.abs(D-med), axis=0, keepdims=True)


        k = int(SPEC_MAD_SMOOTH_BINS) // 2
        if k > 0:
            m0 = mad[0]
            sm = np.array([np.nanmedian(m0[max(0, i - k):i + k + 1]) if np.isfinite(m0[max(0, i - k):i + k + 1]).any()
                           else np.nan for i in range(len(m0))])
            mad = np.where(np.isfinite(sm), np.fmax(sm, m0), m0)[None, :]
        return (D-med)/np.maximum(mad, SPEC_MAD_FLOOR_DB), mad


def panel_clim(E):
    """v3: colour limits that fit the data instead of a fixed (-3, 6).

    The limits are the SPEC_CLIM_PCT percentiles of the panel; in "robust" mode
    they are never narrower than SPEC_ROBUST_CLIM, so a quiet record is not
    stretched into noise. Returns ((vmin, vmax), percent outside, norm)."""
    from matplotlib.colors import Normalize
    v = E[np.isfinite(E)]
    if not v.size:
        return (-1.0, 1.0), 0.0, Normalize(-1.0, 1.0)
    lo, hi = (float(np.percentile(v, SPEC_CLIM_PCT[0])), float(np.percentile(v, SPEC_CLIM_PCT[1])))
    if SPEC_DISPLAY == "robust":
        lo, hi = min(lo, SPEC_ROBUST_CLIM[0]), max(hi, SPEC_ROBUST_CLIM[1])
    if hi <= lo:
        hi = lo + 1.0
    clim = (lo, hi)
    if SPEC_COLOR_SCALE == "asinh" and SPEC_DISPLAY != "absolute":
        try:
            from matplotlib.colors import AsinhNorm
            norm = AsinhNorm(linear_width=float(SPEC_ASINH_WIDTH), vmin=lo, vmax=hi)
        except ImportError:
            from matplotlib.colors import SymLogNorm
            norm = SymLogNorm(linthresh=float(SPEC_ASINH_WIDTH), vmin=lo, vmax=hi, base=10)
    else:
        norm = Normalize(vmin=lo, vmax=hi)
    return clim, 100.0 * np.mean((v < clim[0]) | (v > clim[1])), norm


def plot(res, C, L, sid, ta, tb):
    import warnings
    fe, t = res["fedges"], res["t"]
    fny_s = res["fs_s"] / 2.0
    band = res["band"]
    Ed, _ = display(res["S_d"], 1.0)
    Es, _ = display(res["S_s"], 1e12)
    (cl_d, sat_d, nm_d), (cl_s, sat_s, nm_s) = panel_clim(Ed), panel_clim(Es)
    rec_d = res["sat_d"] if "sat_d" in res else np.zeros((2, len(res["t"])))
    rec_s = res["sat_s"] if "sat_s" in res else np.zeros((2, len(res["t"])))
    ed, es, et = res["env_d"], res["env_s"], res["env_t"]
    have_band = np.isfinite(band).all()
    lag_s, r, rmax, lag_best, r_sig = env_xcorr(ed, es) if have_band else (np.zeros(1), np.full(1, np.nan), np.nan, np.nan, np.nan)
    with warnings.catch_warnings():
        warnings.simplefilter("ignore", RuntimeWarning)
        both = np.isfinite(ed) & np.isfinite(es) & (es > 0) & (ed > 0)
        ratio = float(np.nanmedian(ed[both] / es[both])) if (both.any() and have_band) else np.nan
    te = mdates.date2num([from_posix(x) for x in np.r_[t, t[-1] + CELL_SEC]])
    plt.rcParams.update({
        "font.family": "DejaVu Sans",
        "font.size": FONT_AXIS_TICKS,
        "axes.labelsize": FONT_AXIS_LABEL,
        "axes.titlesize": FONT_MAIN_TITLE,
        "xtick.labelsize": FONT_AXIS_TICKS,
        "ytick.labelsize": FONT_AXIS_TICKS,
        "legend.fontsize": FONT_ANNOTATION,
    })
    fig = plt.figure(figsize=FIG_SIZE)
    gs = gridspec.GridSpec(6, 3, width_ratios=[1, 0.55, 0.015], height_ratios=[2.6, 0.9, 0.9, 2.6, 0.32, 1.5], hspace=0.16,
                           wspace=0.12)
    ax1 = fig.add_subplot(gs[0, 0:2])
    ax2 = fig.add_subplot(gs[1, 0:2], sharex=ax1)
    ax3 = fig.add_subplot(gs[2, 0:2], sharex=ax1)
    ax4 = fig.add_subplot(gs[3, 0:2], sharex=ax1)
    ax5 = fig.add_subplot(gs[5, 0:2])
    cmap = matplotlib.colormaps[CMAP_SPEC].copy()
    cmap.set_bad("0.85")
    labs = {"robust": "deviation dB - median",
            "relative": "dB re median of each frequency"}
    gl = L.get("gauge_m")
    tmid = mdates.date2num([from_posix(x + 0.5 * CELL_SEC) for x in t])
    for ax, cax, E, cl, sat, nm, rec, txt, lab_abs in (
            (ax1, fig.add_subplot(gs[0, 2]), Ed, cl_d, sat_d, nm_d, rec_d,
             f"Sintela channel {int(res['ch'])}, strain rate from {L.get('unit_kind')} ({res['fs_d']:g} Hz, GL {gl} m, dx {L['dx']:g} m)",
             "dB re 1 (n\u03b5/s)\u00b2/Hz"),
            (ax4, fig.add_subplot(gs[3, 2]), Es, cl_s, sat_s, nm_s, rec_s,
             f"seismometer {sid}, ground velocity from StationXML ({res['fs_s']:g} Hz)", "dB re 1 (\u00b5m/s)\u00b2/Hz")):
        im = ax.pcolormesh(te, fe, np.ma.masked_invalid(E.T), cmap=cmap, norm=nm, shading="flat",
                           rasterized=True)


        trans = matplotlib.transforms.blended_transform_factory(ax.transData, ax.transAxes)
        for row, col in ((0, "orange"), (1, "red")):
            m = rec[row] > 0
            if m.any():
                ax.plot(tmid[m], np.full(m.sum(), 0.995), "|", color=col, ms=5, mew=1.0, transform=trans,
                        clip_on=False, zorder=5)
        n_rep, n_msk = int(np.sum(rec[0] > 0)), int(np.sum(rec[1] > 0))
        rtxt = (f"  "
                if (n_rep or n_msk) else " ")
        ax.set_yscale("log")
        ax.set_ylim(fe[0], fe[-1])
        ax.set_ylabel("frequency [Hz]")
        if have_band:
            for fb in band:
                ax.axhline(fb, color="cyan", lw=0.8, ls=":")
        ax.text(0.005, 0.97, f"{txt}  |  colour [{cl[0]:.3g}, {cl[1]:.3g}] {SPEC_COLOR_SCALE if SPEC_DISPLAY != 'absolute' else 'linear'}, "
                f"{sat:.2f}% outside{rtxt}", transform=ax.transAxes,
                fontsize=FONT_ANNOTATION, va="top", color="white", bbox=dict(boxstyle="round,pad=0.2", fc="black", alpha=0.5, lw=0))
        cb = fig.colorbar(im, cax=cax)
        if SPEC_COLOR_SCALE == "asinh" and SPEC_DISPLAY != "absolute":

            cand = np.array([-100, -50, -20, -10, -5, -3, -2, -1, 0, 1, 2, 3, 5, 10, 20, 50, 100, 200, 500, 1000], float)
            tk = cand[(cand >= cl[0]) & (cand <= cl[1])]
            cb.set_ticks(tk)
            cb.set_ticklabels([f"{v:g}" for v in tk])
            cb.minorticks_off()
        cb.set_label(labs.get(SPEC_DISPLAY, lab_abs), fontsize=FONT_COLORBAR_LABEL)
        cb.ax.tick_params(labelsize=FONT_COLORBAR_TICKS)
    if fny_s < fe[-1]:
        ax4.axhspan(fny_s, fe[-1], color="0.75", zorder=3)
        ax4.text(0.5, 0.985, f"above the seismometer Nyquist frequency ({fny_s:g} Hz)", transform=ax4.transAxes,
                 ha="center", va="top", fontsize=FONT_ANNOTATION, color="0.2", zorder=4)
    tn = mdates.date2num([from_posix(x) for x in et])
    btxt = f"{band[0]:.2g}-{band[1]:.3g} Hz" if have_band else "no band"
    for ax, rr, col, name, unit in ((ax2, ed, "tab:red", "DAS", "estimated axial velocity from strain rate x C(f)"),
                                    (ax3, es, "tab:blue", "seismometer", "velocity")):
        ax.plot(tn, rr, color=col, lw=0.5)
        ok = np.isfinite(rr) & (rr > 0)
        if ok.any():
            ax.set_yscale("log")
            lo, hi = np.percentile(rr[ok], 0.1), rr[ok].max()
            ax.set_ylim(10 ** np.floor(np.log10(lo) - 0.05), 10 ** np.ceil(np.log10(hi) + 0.05))
        ax.set_ylabel(name)
        ax.grid(True, which="major", ls="--", alpha=0.3)
        ax.text(0.005, 0.95, f"RMS {unit}, {btxt} (band where C(f) was measured) [\u00b5m/s], {RMS_STEP_SEC:g} s steps",
                transform=ax.transAxes, fontsize=FONT_ANNOTATION, va="top", color="0.3")
    if not have_band:
        ax2.text(0.5, 0.5, "C(f) could not be measured reliably: no conversion of DAS to velocity (no assumption made)",
                 transform=ax2.transAxes, ha="center", fontsize=FONT_ANNOTATION, color="darkred")
    elif np.isfinite(ratio):
        ax2.text(0.995, 0.95, f"median projected DAS / seismometer RMS = {ratio:.2f}", transform=ax2.transAxes, fontsize=FONT_ANNOTATION,
                 va="top", ha="right", color="0.2", bbox=dict(boxstyle="round,pad=0.2", fc="white", alpha=0.8, lw=0))
    for ax in (ax1, ax2, ax3):
        plt.setp(ax.get_xticklabels(), visible=False)
    ax4.xaxis.set_major_formatter(mdates.DateFormatter("%H:%M" if tb - ta <= 2 * 86400 else "%m-%d %H:%M"))
    ax4.set_xlim(mdates.date2num(from_posix(ta)), mdates.date2num(from_posix(tb)))
    if have_band:
        ax5.plot(lag_s, r, color="tab:green", lw=1.0)
        if np.isfinite(r_sig):
            ax5.axhline(r_sig, color="0.5", lw=0.8, ls="--")
            ax5.axhline(-r_sig, color="0.5", lw=0.8, ls="--")
        if np.isfinite(lag_best):
            ax5.axvline(lag_best, color="black", lw=0.8, ls="--")
    ax5.axvline(0, color="black", lw=0.8)
    ax5.set_xlim(-LAG_MAX_SEC, LAG_MAX_SEC)
    ax5.set_xlabel("lag of DAS relative to seismometer [s] (positive = DAS late)")
    ax5.set_ylabel("corr.")
    ax5.grid(True, ls="--", alpha=0.3)
    if not np.isfinite(rmax):
        msg = "envelope cross-correlation: not available"
    elif rmax < 0.4:
        msg = (f"whole-record envelope association is weak (r={rmax:.2f}); "
               "inspect event windows before assessing timestamps")
    else:
        msg = (f"envelope similarity peak r={rmax:.2f}, lag={lag_best:+.1f} s (5-s RMS sampling) "
              )
    ax5.text(0.005, 0.95, msg, transform=ax5.transAxes, fontsize=FONT_ANNOTATION, va="top",
             bbox=dict(boxstyle="round,pad=0.2", fc="white", alpha=0.8, lw=0))
    ax1.set_title(f"DAS vs seismometer, {CELL_SEC:g} s UTC grid  |  {from_posix(ta):%Y-%m-%d %H:%M} to {from_posix(tb):%Y-%m-%d %H:%M} UTC\n"
                  f"{fe[0]:.2g}-{fe[-1]:.4g} Hz  |  tiers " +
                  ", ".join(f"{a_:g}-{(b_ if b_ else fe[-1]):.3g} Hz: {s_:g} s" for a_, b_, s_, _ in TIERS) +
                  f"\n  |  colour {SPEC_DISPLAY}, per panel  |  dotted cyan: RMS band ", fontsize=FONT_MAIN_TITLE)
    path = next_path(f"DAS_seismic_velocity_{CABLE}_{WINDOW_NAME}_Ch{int(res['ch'])}_Pos{SELECTED_DIST_M:.0f}m", "jpeg")
    fig.savefig(path, format="jpeg", dpi=DPI_SAVE, bbox_inches="tight",
                pil_kwargs={"quality": int(min(95, max(1, JPEG_QUALITY))), "optimize": True})
    plt.close(fig)
    stem = os.path.splitext(path)[0]
    np.savetxt(stem + ".csv", np.column_stack([et, ed, es]), delimiter=",", fmt="%.6g",
               header="DAS_projected_axial_velocity_rms_um_s,seis_component_velocity_rms_um_s", comments="")
    np.savetxt(stem + "_C.csv", np.column_stack([C["f"], C["c"], C["lo"], C["hi"], C["c_fill"]]), delimiter=",",
               fmt="%.6g", header="frequency_Hz,C_measured_m_s,C_low_m_s,C_high_m_s,C_used_m_s", comments="")
    coverage_path = stem + "_coverage.csv"
    tcoord = np.asarray(res["t"], dtype=np.float64)
    diag = np.column_stack([tcoord, res["cov_d"], res["cov_s"],
                            np.asarray(res["tier_cov_d"], dtype=float).T,
                            np.asarray(res["tier_cov_s"], dtype=float).T,
                            np.asarray(rec_d, dtype=float).T, np.asarray(rec_s, dtype=float).T])
    names = ["utc_epoch_s", "DAS_fraction", "Seis_fraction"] + [f"DAS_tier{i+1}_valid" for i in range(res["tier_cov_d"].shape[0])] + [f"Seis_tier{i+1}_valid" for i in range(res["tier_cov_s"].shape[0])] \
        + ["DAS_spike_bridged_frac", "DAS_clipped_masked_frac", "Seis_spike_bridged_frac", "Seis_clipped_masked_frac"]
    np.savetxt(coverage_path, diag, fmt="%.6g", delimiter=",", header=",".join(names), comments="")
    for title, cov, tier_cov in (("DAS", res["cov_d"], res["tier_cov_d"]), ("seismometer", res["cov_s"], res["tier_cov_s"])):
        log(f"  {title}: valid raw core cells {np.mean(cov >= MIN_COVERAGE)*100:.1f}% ; spectral tier availability " +
            ", ".join(f"{v*100:.0f}%" for v in np.mean(tier_cov, axis=1)))
    for title, rec, sat, cl in (("DAS", rec_d, sat_d, cl_d), ("seismometer", rec_s, sat_s, cl_s)):
        log(f"  {title}: colour [{cl[0]:.3g}, {cl[1]:.3g}] with {sat:.2f}% of cells outside; recording saturation in "
            f"{np.mean(rec[1] > 0)*100:.1f}% of cells (clipped, masked) and {np.mean(rec[0] > 0)*100:.1f}% (spikes, bridged)")
    log(f"  RMS band {btxt}; median DAS / seismometer RMS: {ratio:.2f} (projected axial vs seismometer component, not instrument calibration)")
    log(f"  envelope cross-correlation: r = {rmax:.2f} at {lag_best:+.1f} s, significance level {r_sig:.2f}")
    log(f"  saved: {path}  (+ .csv, _C.csv)")


def main():
    global _rebuild, SELECTED_DIST_M
    ap = argparse.ArgumentParser(description="Sintela DAS vs seismometer spectrogram with C(f) measured from the DAS array")
    ap.add_argument("--start")
    ap.add_argument("--end")
    ap.add_argument("--rebuild", action="store_true")
    ap.add_argument("--inspect", metavar="FILE", help="print the HDF5 structure and the values this script reads, then stop")
    a, _ = ap.parse_known_args()
    _rebuild = bool(a.rebuild)
    if a.inspect:
        inspect_file(a.inspect)
        L = file_info(a.inspect)
        log("\nvalues used by this script:")
        for k in ("dataset", "time_axis", "n_t", "n_ch", "fs", "fs_src", "pulse_rate", "dx", "dx_src", "gauge_m",
                  "gauge_src", "unit_kind", "unit_src", "raw_scale", "raw_scale_src", "start_locus", "time_dataset"):
            log(f"  {k:14s} {L.get(k)}")
        return
    check_settings()
    t_start = parse_window_time(a.start or START_TIME)
    t_end = parse_window_time(a.end or END_TIME)
    if t_end <= t_start:
        raise StopRun("END_TIME is before START_TIME")
    ta, tb = to_posix(t_start), to_posix(t_end)
    log(f"\n{t_start:%Y-%m-%d %H:%M:%S} -> {t_end:%Y-%m-%d %H:%M:%S} UTC")
    stamped, file_sec = list_files(DATA_FOLDER, RECURSIVE)
    if DATA_FILES:
        names = {os.path.basename(n) for n in DATA_FILES}
        stamped = [r for r in stamped if os.path.basename(r[0]) in names]
    check_window(stamped, file_sec, ta, tb)
    sel = [r for r in stamped if to_posix(r[1]) < tb and to_posix(r[1]) + file_sec > ta]
    if not sel:
        raise StopRun("no DAS files in the window")
    L = layout_of(sel[0][0])
    if SELECTED_CHANNEL is not None:
        if not 0 <= int(SELECTED_CHANNEL) < L["n_ch"]:
            raise StopRun(f"SELECTED_CHANNEL {SELECTED_CHANNEL} is outside 0..{L['n_ch'] - 1}")
        SELECTED_DIST_M = x0_of(L) + int(SELECTED_CHANNEL) * L["dx"]
    jsel = int(round((SELECTED_DIST_M - x0_of(L)) / L["dx"]))
    if not 0 <= jsel < L["n_ch"]:
        raise StopRun(f"SELECTED_DIST_M {SELECTED_DIST_M:g} m is channel {jsel}, outside 0..{L['n_ch'] - 1} "
                      f"(dx {L['dx']:g} m)")
    dur = L["n_t"] / L["fs"]
    log(f"  Sintela data: {L['dataset']} {'(time, channel)' if L['time_axis'] == 0 else '(channel, time)'}, "
        f"{L['n_ch']} channels, {L['n_t']} samples = {dur:.1f} s per file; unit {L['unit_kind']} ({L['unit_src']}), "
        f"scale {L['raw_scale']:g} ({L['raw_scale_src']}), pulse rate {L.get('pulse_rate')}")
    if L.get("start_locus") is not None:
        log(f"  (StartLocusIndex = {L['start_locus']:g}; positions here count from channel 0 of RawData)")
    if dur > 1.1 * file_sec:
        raise StopRun(f"{L['n_t']} samples at {L['fs']:g} Hz last {dur:.1f} s but files start every {file_sec:.1f} s: "
                      f"the sampling rate ({L['fs_src']}) is wrong. Set SAMPLING_RATE_HZ (about {L['n_t'] / file_sec:.6g} Hz?)")
    if dur < 0.9 * file_sec:
        log(f"  ! files hold {dur:.1f} s but start every {file_sec:.1f} s: gaps between files, or check the sampling rate "
            f"({L['fs_src']})")
    log(f"  DAS metadata: fs {L['fs']:g} Hz ({L['fs_src']}), dx {L['dx']:g} m ({L['dx_src']}), GL {L.get('gauge_m')} m "
        f"({L.get('gauge_src')}), channel 0 at {x0_of(L):g} m ({L.get('x0_src')}); {SELECTED_DIST_M:g} m = channel "
        f"{int(round((SELECTED_DIST_M - x0_of(L)) / L['dx']))}")
    paths, _ = convert_seismic()
    index = seis_index(paths)
    sid, fs_s = choose_seis_id(index, ta, tb)
    inv = load_inventory()
    log(f"  seismometer: {sid} ({fs_s:g} Hz from the data headers), response from {len(response_files())} StationXML file(s)")
    log("\n  measuring the apparent velocity C(f) along the fibre")
    C = measure_c(stamped, file_sec, ta, tb, L)
    if np.isfinite(C["band"]).all():
        cu = C["c_fill"][np.isfinite(C["c_fill"])]
        log(f"  C(f) measured over {C['band'][0]:.2f}-{C['band'][1]:.1f} Hz: {cu.max():.0f} -> {cu.min():.0f} m/s "
            f"({int(C['ok'].sum())} reliable frequencies)")
    else:
        log("  ! C(f) could not be measured reliably: DAS is shown in strain rate only, no velocity conversion")
    res = compute(stamped, file_sec, ta, tb, L, index, sid, fs_s, inv, C)
    ok_d = np.mean(np.isfinite(res["S_d"]).any(axis=1))
    ok_s = np.mean(np.isfinite(res["S_s"]).any(axis=1))
    log(f"  cells with any spectral data: DAS {100 * ok_d:.0f} %, seismometer {100 * ok_s:.0f} %")
    if np.mean(res["tier_cov_d"][0]) < 0.80:
        log("  ! Low-frequency DAS tier has limited usable uninterrupted data. Its grey regions are genuine unresolved bins; see _coverage.csv.")
    plot(res, C, L, sid, ta, tb)
    log("\nDone.")


if __name__ == "__main__":
    try:
        main()
    except StopRun as stop:
        print(f"\nSTOPPED: {stop}")
