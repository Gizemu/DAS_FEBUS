def draw_trace(ax, tn, x, color, label=None, lw=WAVE_LINEWIDTH, px=None, zorder=2):
    n = len(x)
    px = int(px or 3000)
    k = n // (2 * px)
    if k >= 2:
        m = (n // k) * k
        xb = np.asarray(x[:m], np.float64).reshape(-1, k)
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", RuntimeWarning)
            lo = np.nanmin(xb, axis=1)
            hi = np.nanmax(xb, axis=1)
        valid = np.isfinite(xb).any(axis=1)
        lo[~valid] = np.nan
        hi[~valid] = np.nan
        t0 = np.asarray(tn[:m:k], np.float64)
        t1 = np.asarray(tn[k - 1:m:k], np.float64)
        tb = 0.5 * (t0 + t1)
        ax.fill_between(tb, lo, hi, where=np.isfinite(lo) & np.isfinite(hi), color=color,
                        lw=0.35, edgecolor=color, rasterized=True, label=label, zorder=zorder)
        return tb, hi
    y = np.ma.masked_invalid(x)
    ax.plot(tn, y, color=color, lw=lw, rasterized=n > 20000, label=label, zorder=zorder)
    return tn, np.asarray(y.filled(np.nan), np.float64)


def time_axis(ax, label=True):
