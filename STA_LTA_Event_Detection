UTC = datetime.timezone.utc


def log(msg=""):
    print(msg, flush=True)


class StopRun(Exception):
    pass


def to_posix(dt):
    return dt.replace(tzinfo=UTC).timestamp()


def utc_text(t, fmt="%Y-%m-%d %H:%M:%S"):
    return datetime.datetime.fromtimestamp(float(t), tz=UTC).strftime(fmt)


def filename_time(name):
    m = re.search(r"(\d{4})\W(\d{2})\W(\d{2})[_T\s](\d{2})\W(\d{2})\W(\d{2})(?:[.,](\d{1,6}))?_?UTC", name)
    if not m:
        return None
    g = m.groups()
    us = int((g[6] or "0").ljust(6, "0")[:6])
    return to_posix(datetime.datetime(*[int(x) for x in g[:6]], us))


def epoch_seconds(t):
    t = np.asarray(t, dtype=np.float64).ravel()
    if not t.size or not np.isfinite(t[0]):
        return None
    a = abs(t[0])
    for lim, f in ((1e17, 1e-9), (1e14, 1e-6), (1e11, 1e-3), (1e8, 1.0)):
        if a >= lim:
            return t * f
    return None


def h5_attrs(f):
    out = {}

    def visit(name, obj):
        for k, v in obj.attrs.items():
            out[f"/{name}/{k}".lower()] = v
    f.visititems(visit)
    for k, v in f.attrs.items():
        out[f"/{k}".lower()] = v
    return out


def attr_num(attrs, names):
    for n in names:
        for k, v in attrs.items():
            if k.endswith("/" + n.lower()):
                try:
                    if isinstance(v, (bytes, np.bytes_)):
                        v = v.decode("utf-8", "ignore")
                    if isinstance(v, str):
                        m = re.match(r"\s*([-+]?\d*\.?\d+(?:[eE][-+]?\d+)?)", v)
                        if m:
                            return float(m.group(1))
                        continue
                    return float(np.ravel(v)[0])
                except (TypeError, ValueError, IndexError):
                    continue
    return None


def _vec(attrs, name, default=None):
    if name not in attrs:
        return None if default is None else np.atleast_1d(np.asarray(default, np.float64)).ravel()
    v = attrs[name]
    if isinstance(v, (bytes, np.bytes_, str)):
        try:
            v = float(v.decode() if isinstance(v, (bytes, np.bytes_)) else v)
        except ValueError:
            return None if default is None else np.atleast_1d(np.asarray(default, np.float64)).ravel()
    return np.atleast_1d(np.asarray(v, np.float64)).ravel()


def febus_unit(name):
    key = re.sub(r"[^a-z]", "", name.split("[")[0].lower())
    if key in FEBUS_UNITS:
        return FEBUS_UNITS[key]
    for k in sorted(FEBUS_UNITS, key=len, reverse=True):
        if key.startswith(k):
            return FEBUS_UNITS[k]
    return FEBUS_DEFAULT_UNIT


def febus_find(f):
    skipped = []
    for gname in f:
        g = f[gname]
        if not isinstance(g, h5py.Group):
            continue
        for sname in g:
            s = g[sname]
            if not isinstance(s, h5py.Group) or "time" not in s:
                continue
            for zname in s:
                z = s[zname]
                if zname == "time" or not isinstance(z, h5py.Group):
                    continue
                if FEBUS_ZONE and zname != FEBUS_ZONE:
                    continue
                for dname in z:
                    ds = z[dname]
                    if not (isinstance(ds, h5py.Dataset) and ds.ndim == 3):
                        continue
                    if FEBUS_DATASET and dname.lower() != FEBUS_DATASET.lower():
                        continue
                    if febus_unit(dname) is None:
                        skipped.append(dname)
                        continue
                    return s, z, ds
    if skipped:
        raise StopRun(f"Febus dataset(s) {skipped} are not a recognised time series (e.g. PSD products); "
                      f"set FEBUS_DATASET and FEBUS_DEFAULT_UNIT if one of them is")
    return None


def febus_layout(path, f, hit):
    s, z, ds = hit
    za = z.attrs
    n_blk, n_pad, n_ch = (int(v) for v in ds.shape)
    spacing = _vec(za, "Spacing")
    if spacing is None or len(spacing) < 2:
        raise StopRun(f"Febus zone {z.name} has no Spacing attribute")
    origin = _vec(za, "Origin", [0.0, 0.0])
    extent = _vec(za, "Extent", [0, n_ch - 1, 0, n_pad - 1])
    tv = epoch_seconds(np.asarray(s["time"][...], np.float64).ravel())
    if tv is None:
        raise StopRun(f"Febus time vector in {os.path.basename(path)} is not an epoch time")
    if DAS_FS_HZ:
        dt = 1.0 / DAS_FS_HZ
    elif "Version" in za:
        dt = float(spacing[1]) / 1000.0
    else:
        fz = _vec(za, "SamplingRate")
        dt = 1.0 / float(fz[0]) if fz is not None and 0 < fz[0] < 1e8 else float(spacing[1]) / 1000.0
    br = _vec(za, "BlockRate", [0.0])[0] / 1000.0
    d_tv = np.diff(tv)
    if br > 0:
        block_time, bt_src = 1.0 / br, "BlockRate"
    elif len(d_tv) and np.any(d_tv > 0):
        good = d_tv[(d_tv > 0) & (d_tv < 1.5 * np.median(d_tv[d_tv > 0]))]
        block_time, bt_src = float(np.mean(good)), "time vector"
    else:
        block_time, bt_src = None, None
    ov_attr = _vec(za, "Overlap", None)
    ov_attr = ov_attr if ov_attr is not None else _vec(za, "BlockOverlap", None)
    if block_time is not None:
        keep = int(round(block_time / dt))
    else:
        ov = float(ov_attr[0]) if ov_attr is not None else 0.0
        keep = int(round(n_pad / (1 + ov / 100.0)))
        block_time = keep * dt
    if n_pad < keep <= 1.03 * n_pad:
        keep = n_pad
    if keep > n_pad:
        log(f"  ! {os.path.basename(path)}: block period {block_time:g} s holds {keep} samples, the blocks only "
            f"{n_pad}: the blocks are not contiguous, gaps stay empty")
        keep = n_pad
    keep = max(1, keep)
    q, r = divmod(n_pad - keep, 2)
    i0, i1 = q, n_pad - 1 - (q + r)
    n_keep = i1 - i0 + 1
    if ov_attr is not None and n_pad > keep and block_time is not None:
        ov_expect = 100.0 * (n_pad - keep) / keep
        if abs(ov_expect - float(ov_attr[0])) > 1.5:
            log(f"  ! {os.path.basename(path)}: BlockOverlap {float(ov_attr[0]):g} % but {n_pad} samples per block "
                f"of {block_time:g} s imply {ov_expect:.1f} %; using the block period")
    t_off = float(origin[1]) / 1000.0 if len(origin) > 1 else 0.0
    if len(tv) == n_blk:
        tb = tv + t_off + i0 * dt
    else:
        tb = tv[0] + t_off + i0 * dt + np.arange(n_blk) * n_keep * dt
    step = n_keep * dt
    runs, b0 = [], 0
    for b in range(1, n_blk):
        if abs(tb[b] - (tb[b0] + (b - b0) * step)) > 0.5 * step:
            runs.append((b0, b, float(tb[b0])))
            b0 = b
    runs.append((b0, n_blk, float(tb[b0])))
    fs = float(f"{1.0 / dt:.9g}")
    gl_attr = _vec(za, "GaugeLength")
    gl = DAS_GAUGE_LENGTH_M or (float(gl_attr[0]) if gl_attr is not None else None)
    dx = DAS_DX_M or float(spacing[0])
    kind, scale = febus_unit(ds.name.rsplit("/", 1)[-1])
    return dict(format="febus", path=path, dataset=ds.name, n_t=n_blk * n_keep, n_ch=n_ch, fs=fs,
                gauge=gl, dx=dx, dist0=float(origin[0]) + float(extent[0]) * dx, t0=runs[0][2],
                t1=runs[-1][2] + (runs[-1][1] - runs[-1][0]) * step, kind=kind, scale=scale,
                febus=dict(i0=i0, i1=i1, n_keep=n_keep, n_pad=n_pad, runs=runs, block_time=block_time,
                           block_time_src=bt_src, zone=z.name))


def sintela_layout(path, f):
    ds = next((f[p] for p in RAW_DATASET_PATHS if p in f and isinstance(f[p], h5py.Dataset)), None)
    if ds is None:
        return None
    attrs = h5_attrs(f)
    dims = str(attrs.get(f"{ds.name}/dimensions".lower(), "")).lower()
    time_axis = 1 if dims.strip("[]'\" b").startswith(("locus", "loci", "channel", "distance")) else 0
    n_t, n_ch = (ds.shape[0], ds.shape[1]) if time_axis == 0 else (ds.shape[1], ds.shape[0])
    t_s, fs_t = None, None
    for k in ("RawDataTime", "Time", "time", "Timestamps"):
        if k in ds.parent and ds.parent[k].size == n_t:
            tt = ds.parent[k]
            t_s = epoch_seconds(np.array([tt[0], tt[n_t - 1]], dtype=np.float64))
            if t_s is not None and n_t > 1 and t_s[1] > t_s[0]:
                fs_t = (n_t - 1) / float(t_s[1] - t_s[0])
            break
    fs_attr = attr_num(attrs, ["OutputDataRate", "SamplingRate", "SampleRate"])
    fs = DAS_FS_HZ
    if fs is None:
        if fs_t and fs_attr and abs(fs_t / fs_attr - 1) < 2e-3:
            fs = fs_attr
        else:
            fs = fs_t or fs_attr or attr_num(attrs, ["PulseRate"])
    if not fs:
        raise StopRun("no DAS sampling rate in the file attributes: set DAS_FS_HZ")
    fs = float(f"{fs:.9g}")
    gl = DAS_GAUGE_LENGTH_M or attr_num(attrs, ["GaugeLength", "GageLength"])
    dx = DAS_DX_M or attr_num(attrs, ["SpatialSamplingInterval", "ChannelSpacing"]) or gl
    if SINTELA_UNIT in ("phase", "phase_rate") and not gl:
        raise StopRun("no gauge length in the file attributes: set DAS_GAUGE_LENGTH_M")
    t0 = float(t_s[0]) if t_s is not None else filename_time(os.path.basename(path))
    if t0 is None:
        raise StopRun(f"no start time for {os.path.basename(path)}")
    return dict(format="sintela", path=path, n_t=int(n_t), n_ch=int(n_ch), time_axis=time_axis, fs=fs,
                gauge=float(gl) if gl else None, dx=float(dx), dist0=0.0, t0=t0, t1=t0 + n_t / fs,
                dataset=ds.name, kind=SINTELA_UNIT, scale=1.0)


@functools.lru_cache(maxsize=None)
def das_layout(path):
    with h5py.File(path, "r") as f:
        if DAS_FORMAT in ("auto", "febus"):
            hit = febus_find(f)
            if hit is not None:
                return febus_layout(path, f, hit)
            if DAS_FORMAT == "febus":
                raise StopRun(f"{os.path.basename(path)} is not a Febus A1 DAS file (no Source*/Zone*/<data>)")
        L = sintela_layout(path, f)
        if L is None:
            raise StopRun(f"{os.path.basename(path)}: neither a Febus zone nor a Sintela RawData dataset")
        return L


def read_raw(L, c0, c1, t_lo, t_hi):
    out = []
    with h5py.File(L["path"], "r") as f:
        ds = f[L["dataset"]]
        if L["format"] == "febus":
            fb = L["febus"]
            step = fb["n_keep"] / L["fs"]
            for b0, b1, ts in fb["runs"]:
                k0 = max(b0, b0 + int(math.floor((t_lo - ts) / step)))
                k1 = min(b1, b0 + int(math.ceil((t_hi - ts) / step)))
                if k1 <= k0:
                    continue
                x = ds[k0:k1, fb["i0"]:fb["i1"] + 1, c0:c1]
                out.append((ts + (k0 - b0) * step, np.asarray(x, np.float64).reshape(-1, c1 - c0)))
        else:
            fs = L["fs"]
            i0 = max(0, int(math.floor((t_lo - L["t0"]) * fs)))
            i1 = min(L["n_t"], int(math.ceil((t_hi - L["t0"]) * fs)) + 1)
            if i1 > i0:
                raw = ds[i0:i1, c0:c1] if L["time_axis"] == 0 else ds[c0:c1, i0:i1].T
                out.append((L["t0"] + i0 / fs, np.asarray(raw, np.float64)))
    return out


def merge_segments(segs):
    segs = sorted(segs, key=lambda s: s[0])
    out, worst = [], 0.0
    for t0, fs, x, L in segs:
        if out:
            pt, pfs, parts, pL, n_prev = out[-1]
            same = pfs == fs and pL["kind"] == L["kind"]
            gap = t0 - (pt + n_prev / pfs)
            if same and gap < -DAS_MERGE_TOL_SEC:
                k = int(round(-gap * fs))
                if k >= len(x):
                    continue
                x, t0 = x[k:], t0 + k / fs
                gap = t0 - (pt + n_prev / pfs)
            if same and abs(gap) <= DAS_MERGE_TOL_SEC:
                parts.append(x)
                out[-1] = (pt, pfs, parts, pL, n_prev + len(x))
                worst = max(worst, abs(gap))
                continue
        out.append((t0, fs, [x], L, len(x)))
    return [(t0, fs, np.concatenate(parts, axis=0), L) for t0, fs, parts, L, _ in out], worst


def fill_nans(x, fs):
    bad = ~np.isfinite(x)
    if not bad.any():
        return x, np.zeros(len(x), bool)
    long_mask = np.zeros(len(x), bool)
    x = x.copy()
    n_max = int(round(DAS_NAN_MAX_FILL_SEC * fs))
    idx = np.arange(len(x))
    for j in range(x.shape[1]):
        b = bad[:, j]
        if not b.any():
            continue
        if b.all():
            long_mask[:] = True
            x[:, j] = 0.0
            continue
        x[b, j] = np.interp(idx[b], idx[~b], x[~b, j])
        edges = np.flatnonzero(np.diff(np.r_[0, b.astype(int), 0]))
        for a_, b_ in zip(edges[::2], edges[1::2]):
            if b_ - a_ > n_max:
                long_mask[a_:b_] = True
    return x, long_mask


def phase_to_strain():
    return WAVELENGTH / (4.0 * np.pi * NEFF * STRAIN_OPTIC_COEFF)


def ratio(fs_in, fs_out):
    fr = Fraction(fs_out / fs_in).limit_denominator(1000)
    return fr.numerator, fr.denominator


def to_strain_rate(x, fs, L):
    kind = L["kind"]
    x = x * L["scale"]
    if kind in ("phase", "strain"):
        d = np.diff(x, axis=0)
        if kind == "phase":
            wrapped = PHASE_WRAPPED
            if wrapped == "auto":
                wrapped = bool(np.nanmax(np.abs(x)) <= np.pi * 1.0001 and np.nanmax(np.abs(d)) > np.pi)
            if wrapped:
                d = (d + np.pi) % (2 * np.pi) - np.pi
        d = np.concatenate([d[:1], d], axis=0) * fs
    elif kind in ("strain_rate", "phase_rate"):
        d = x
    else:
        raise StopRun(f"unknown DAS quantity {kind!r}")
    if kind in ("phase", "phase_rate"):
        if not L["gauge"]:
            raise StopRun("phase data need the gauge length: set DAS_GAUGE_LENGTH_M")
        d = d * phase_to_strain() / L["gauge"]
    return d


def resolve_ref_channel(L0):
    if DAS_REF_DISTANCE_M is not None:
        ch = int(round((float(DAS_REF_DISTANCE_M) - L0["dist0"]) / L0["dx"]))
        if not 0 <= ch < L0["n_ch"]:
            raise StopRun(f"DAS_REF_DISTANCE_M = {DAS_REF_DISTANCE_M} m is outside the zone "
                          f"({L0['dist0']:g}-{L0['dist0'] + (L0['n_ch'] - 1) * L0['dx']:g} m)")
        log(f"  DAS_REF_DISTANCE_M = {DAS_REF_DISTANCE_M:g} m -> channel {ch} "
            f"({L0['dist0'] + ch * L0['dx']:.2f} m)")
        return ch
    return int(DAS_REF_CHANNEL)


def load_das(t_a, t_b):
    files = das_files((t_a, t_b))
    cand = []
    for p in files:
        ft = name_time(os.path.basename(p))
        if ft is not None and (ft > t_b + 120 or ft < t_a - 3 * 3600):
            continue
        cand.append(p)
    pad = max(5.0, 5.0 / BAND_HZ[0])
    layouts = []
    for p in cand:
        try:
            L = das_layout(p)
        except Exception as e:
            log(f"  ! {os.path.basename(p)}: {e}")
            continue
        if L["t1"] > t_a - pad and L["t0"] < t_b + pad:
            layouts.append(L)
    if not any(L["t1"] > t_a and L["t0"] < t_b for L in layouts):
        raise StopRun("no DAS file covers the requested window")
    layouts.sort(key=lambda L: L["t0"])
    L0 = next(L for L in layouts if L["t1"] > t_a)
    ref = resolve_ref_channel(L0)
    c0, c1 = ref, ref + 1
    segs = []
    for L in layouts:
        if c1 > L["n_ch"]:
            raise StopRun(f"channel {ref} requested, {os.path.basename(L['path'])} has {L['n_ch']} channels")
        for t0, x in read_raw(L, c0, c1, t_a - pad, t_b + pad):
            segs.append((t0, L["fs"], x, L))
    merged, worst = merge_segments(segs)
    n = int(round((t_b - t_a) * COMMON_FS_HZ))
    out = np.full((n, c1 - c0), np.nan, np.float32)
    n_nan, n_long = 0, 0
    for t0, fs, x, L in merged:
        n_nan += int((~np.isfinite(x)).sum())
        x, long_mask = fill_nans(x, fs)
        y = to_strain_rate(x, fs, L)
        up, down = ratio(fs, COMMON_FS_HZ)
        if (up, down) != (1, 1):
            y = resample_poly(y, up, down, axis=0, padtype="line")
        if long_mask.any():
            tm = np.arange(len(y)) / COMMON_FS_HZ
            gap = np.interp(tm, np.arange(len(long_mask)) / fs, long_mask.astype(float)) > 0
            y[gap] = np.nan
            n_long += int(long_mask.sum())
        i0 = int(round((t0 - t_a) * COMMON_FS_HZ))
        j0, j1 = max(0, -i0), min(len(y), n - i0)
        if j1 > j0:
            out[i0 + j0:i0 + j1] = y[j0:j1]
    cover = float(np.isfinite(out[:, 0]).mean())
    for k, L in enumerate(layouts):
        log(f"  DAS {k + 1}/{len(layouts)}  {os.path.basename(L['path'])}")
    extra = ""
    if L0["format"] == "febus":
        fb = L0["febus"]
        extra = (f", {fb['zone'].rsplit('/', 1)[-1]}/{L0['dataset'].rsplit('/', 1)[-1]}, blocks of "
                 f"{fb['n_pad']} samples keeping {fb['n_keep']} (period {fb['block_time']:g} s from "
                 f"{fb['block_time_src']})")
    log(f"  DAS ({L0['format']}{extra})")
    log(f"  {len(layouts)} file(s), {len(merged)} continuous segment(s), largest join {1000 * worst:.1f} ms, "
        f"fs {L0['fs']:g} Hz -> {COMMON_FS_HZ:g} Hz, GL {L0['gauge']} m, dx {L0['dx']:.4g} m, "
        f"ch {ref} at {L0['dist0'] + ref * L0['dx']:.1f} m, coverage {100 * cover:.1f} %"
        + (f", {n_nan} NaN raw samples ({n_nan - n_long} interpolated, {n_long} in runs > "
           f"{DAS_NAN_MAX_FILL_SEC:g} s kept as gaps)" if n_nan else ""))
    if cover == 0:
        raise StopRun(f"DAS channel {ref} has no valid samples in the window (all NaN, e.g. beyond the fibre end): "
                      f"choose another DAS_REF_CHANNEL")
    return out, L0, ref

SKIP_EXT = (".xml", ".txt", ".csv", ".json", ".png", ".jpg", ".jpeg", ".pdf", ".log", ".tmp")


def open_seismic(path, **kw):
    from obspy import read
    if path.lower().endswith(".gz"):
        with gzip.open(path, "rb") as fh:
            return read(io.BytesIO(fh.read()), **kw)
    return read(path, **kw)


def parse_time(text):
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M", "%Y-%m-%d"):
        try:
            return to_posix(datetime.datetime.strptime(str(text).strip(), fmt))
        except ValueError:
            continue
    raise StopRun(f"cannot read the time {text!r}: use 'YYYY-MM-DD HH:MM:SS'")


def configured_window():
    if str(START_TIME).strip().lower() == "auto":
        return None
    t_a = parse_time(START_TIME)
    t_b = parse_time(END_TIME) if END_TIME else t_a + DURATION_MIN * 60
    if t_b <= t_a:
        raise StopRun(f"END_TIME {utc_text(t_b)} is not after START_TIME {utc_text(t_a)}")
    if (t_b - t_a) / 3600 > MAX_WINDOW_HOURS:
        raise StopRun(f"the window is {(t_b - t_a) / 3600:.1f} h, longer than MAX_WINDOW_HOURS = {MAX_WINDOW_HOURS:g} h "
                      f"(memory grows with the window length); split it or raise MAX_WINDOW_HOURS")
    if (t_b - t_a) < 4 * SEG_SEC:
        raise StopRun(f"the window is shorter than 4 segments of SEG_SEC = {SEG_SEC:g} s")
    return t_a, t_b


def cache_dir():
    d = CACHE_FOLDER or os.path.join(OUTPUT_FOLDER, "_cache")
    os.makedirs(d, exist_ok=True)
    return d


def name_time(name):
    t = filename_time(name)
    if t is not None:
        return t
    m = re.search(r"(20\d{2})[-_.]?([01]\d)[-_.]?([0-3]\d)[T_\-\s]?([0-2]\d)[-_.:]?([0-5]\d)[-_.:]?([0-5]\d)", name)
    if not m:
        return None
    try:
        return to_posix(datetime.datetime(*[int(x) for x in m.groups()]))
    except ValueError:
        return None


def quick_span(path):
    if not path.lower().endswith(".gz"):
        try:
            from obspy.io.mseed.util import get_record_information
            a = get_record_information(path)
            size = os.path.getsize(path)
            b = get_record_information(path, offset=size - a["record_length"]) if size > a["record_length"] else a
            t0 = min(a["starttime"].timestamp, b["starttime"].timestamp)
            t1 = max(a["endtime"].timestamp, b["endtime"].timestamp)
            return t0, t1, "record headers"
        except Exception:
            pass
    t = name_time(os.path.basename(path))
    if t is not None:
        return t, None, "file name"
    return None, None, "unknown"


def window_files(files, t_a, t_b):
    keep, spans = [], []
    how = {"record headers": 0, "file name": 0, "unknown": 0}
    for p in files:
        t0, t1, h = quick_span(p)
        how[h] += 1
        if t0 is None:
            keep.append(p)
            continue
        spans.append((t0, t1 if t1 is not None else t0))
        if t1 is not None:
            if t1 >= t_a - 60 and t0 <= t_b + 60:
                keep.append(p)
        elif t_a - SEIS_NAME_MARGIN_H * 3600 <= t0 <= t_b + 60:
            keep.append(p)
    log(f"  {len(keep)} of {len(files)} seismic files overlap the window "
        f"(times from record headers: {how['record headers']}, file names: {how['file name']}, "
        f"unknown, kept anyway: {how['unknown']})")
    if not keep and spans:
        raise StopRun(f"no seismic file overlaps {utc_text(t_a)} - {utc_text(t_b)} UTC.\n"
                      f"    seismic files span {utc_text(min(a for a, _ in spans))} - "
                      f"{utc_text(max(b for _, b in spans))} UTC\n"
                      f"    set START_TIME / END_TIME inside that span")
    return keep


def seis_index(files, win=None):
    tag = "all" if win is None else f"{utc_text(win[0], '%Y%m%d_%H%M%S')}_{utc_text(win[1], '%Y%m%d_%H%M%S')}"
    cache = os.path.join(cache_dir(), f"_seismic_index_{SEIS_STATION}_{tag}.json")
    idx = {}
    if os.path.exists(cache):
        try:
            with open(cache, encoding="utf-8") as fh:
                idx = json.load(fh)
        except Exception:
            idx = {}
    changed, out = False, []
    for p in files:
        k = os.path.abspath(p)
        st_ = os.stat(p)
        e = idx.get(k)
        if e is None or e.get("size") != st_.st_size or abs(e.get("mtime", 0) - st_.st_mtime) > 2:
            try:
                st = open_seismic(p, headonly=True)
                e = {"size": st_.st_size, "mtime": st_.st_mtime,
                     "traces": [[t.id, t.stats.starttime.timestamp, t.stats.endtime.timestamp,
                                 float(t.stats.sampling_rate)] for t in st]}
            except Exception as ex:
                e = {"size": st_.st_size, "mtime": st_.st_mtime, "traces": [], "error": str(ex)[:200]}
            idx[k] = e
            changed = True
        out.append((p, e))
    if changed:
        try:
            with open(cache + ".tmp", "w", encoding="utf-8") as fh:
                json.dump(idx, fh)
            os.replace(cache + ".tmp", cache)
        except OSError:
            pass
    return out


def station_codes():
    return [SEIS_STATION] + [a for a in SEIS_STATION_ALIASES if a]


def name_has_station(path):
    name = os.path.basename(path)
    return any(re.search(rf"(^|[^A-Za-z0-9]){re.escape(c)}([^A-Za-z0-9]|$)", name) for c in station_codes())


def merge_intervals(iv, gap=1.0):
    out = []
    for a_, b_ in sorted(iv):
        if out and a_ <= out[-1][1] + gap:
            out[-1][1] = max(out[-1][1], b_)
        else:
            out.append([a_, b_])
    return out


def intersect_intervals(x, y):
    out, i, j = [], 0, 0
    while i < len(x) and j < len(y):
        a_, b_ = max(x[i][0], y[j][0]), min(x[i][1], y[j][1])
        if b_ > a_:
            out.append([a_, b_])
        if x[i][1] < y[j][1]:
            i += 1
        else:
            j += 1
    return out


def select_seismic(index):
    import fnmatch
    found, groups, errors = {}, {}, [(p, e["error"]) for p, e in index if e.get("error")]
    for p, e in index:
        for tid, t0, t1, fs in e.get("traces", []):
            net, sta, loc, cha = (tid.split(".") + ["", "", "", ""])[:4]
            rec = found.setdefault(tid, [np.inf, -np.inf, 0, fs])
            rec[0], rec[1], rec[2] = min(rec[0], t0), max(rec[1], t1), rec[2] + 1
            if not (fnmatch.fnmatchcase(net, SEIS_NETWORK) and fnmatch.fnmatchcase(loc, SEIS_LOCATION)
                    and fnmatch.fnmatchcase(cha, SEIS_CHANNELS)) or len(cha) < 3:
                continue
            by_hdr = any(fnmatch.fnmatchcase(sta, c) for c in station_codes())
            by_name = SEIS_MATCH_FILENAME and name_has_station(p)
            if not (by_hdr or by_name):
                continue
            g = groups.setdefault((net, sta, loc, cha[:2]), {"fs": 0.0, "comps": {}, "how": "header" if by_hdr else "file name"})
            g["fs"] = max(g["fs"], fs)
            g["comps"].setdefault(cha, []).append((p, t0, t1))
    if errors:
        log(f"  ! {len(errors)} of {len(index)} files could not be read, e.g. "
            f"{os.path.basename(errors[0][0])}: {errors[0][1]}")
    usable = {k: g for k, g in groups.items() if len(g["comps"]) >= 3 and g["fs"] >= SEIS_MIN_FS_HZ}
    if not usable:
        lines = "\n".join(f"      {k}: {v[2]} file(s), {v[3]:g} Hz, {utc_text(v[0])} - {utc_text(v[1])}"
                          for k, v in sorted(found.items())[:40]) or "      (no readable seismic traces)"
        raise StopRun(f"no three-component set of at least {SEIS_MIN_FS_HZ:g} Hz in {SEIS_FOLDER} for station "
                      f"{'/'.join(station_codes())} ({len(index)} files scanned).\n"
                      f"    traces found in the folder:\n{lines}\n"
                      f"    set SEIS_STATION / SEIS_STATION_ALIASES / SEIS_CHANNELS accordingly")
    key = max(usable, key=lambda k: (usable[k]["fs"], sum(len(v) for v in usable[k]["comps"].values())))
    g = usable[key]
    comps = sorted(g["comps"])[:3] if len(g["comps"]) == 3 else sorted(
        g["comps"], key=lambda c: (c[-1] not in "ZNE123", c))[:3]
    ids = {f"{key[0]}.{key[1]}.{key[2]}.{c}": g["how"] for c in comps}
    ignored = sorted({tid.split(".")[3] for tid in found} - set(comps))
    log(f"  using {', '.join(sorted(ids))} ({g['fs']:g} Hz, matched by {g['how']})")
    if ignored:
        log(f"  ignored channels: {', '.join(ignored)}")
    per_comp = [merge_intervals([(t0, t1) for _, t0, t1 in g["comps"][c]], gap=2.0 / g["fs"] + 0.05) for c in comps]
    cover = per_comp[0]
    for iv in per_comp[1:]:
        cover = intersect_intervals(cover, iv)
    files = sorted({(p, t0, t1) for c in comps for p, t0, t1 in g["comps"][c]}, key=lambda x: x[1])
    return dict(ids=ids, cover=cover, files=files, fs=g["fs"])


def das_file_start(p):
    t = name_time(os.path.basename(p))
    if t is not None:
        return t, True
    try:
        return das_layout(p)["t0"], False
    except Exception:
        return None, False


def das_files(win=None):
    if not os.path.isdir(DAS_FOLDER):
        raise StopRun(f"DAS_FOLDER does not exist: {DAS_FOLDER}")
    pats = [DAS_PATTERN] if isinstance(DAS_PATTERN, str) else list(DAS_PATTERN)
    found = []
    for pat in pats:
        found += glob.glob(os.path.join(DAS_FOLDER, "**" if DAS_RECURSIVE else "", pat), recursive=DAS_RECURSIVE)
    seen, files = set(), []
    for p in sorted(set(found)):
        b = os.path.basename(p)
        if b.startswith("._") or b in seen or os.sep + "_cache" in p:
            continue
        seen.add(b)
        files.append(p)
    if not files:
        subs = sorted(d for d in os.listdir(DAS_FOLDER) if os.path.isdir(os.path.join(DAS_FOLDER, d)))
        raise StopRun(f"no DAS files matching {', '.join(pats)} in {DAS_FOLDER}"
                      f"{' or its subfolders' if DAS_RECURSIVE else ''}.\n"
                      f"    subfolders there: {', '.join(subs[:30]) or 'none'}\n"
                      f"    set DAS_FOLDER to the folder that holds the DAS .h5 files")
    if win is None:
        return files
    t_a, t_b = win
    named = [(name_time(os.path.basename(p)), p) for p in files]
    near = sorted((abs(ft - t_a), p) for ft, p in named if ft is not None and t_a - 6 * 3600 <= ft <= t_b)
    dur = 3600.0
    for _, p in near[:3] or [(0, files[0])]:
        try:
            L = das_layout(p)
            dur = L["t1"] - L["t0"]
            break
        except Exception:
            continue
    kept, unnamed = [], 0
    for ft, p in named:
        if ft is None:
            unnamed += 1
            try:
                L = das_layout(p)
                if L["t1"] > t_a and L["t0"] < t_b:
                    kept.append(p)
            except Exception:
                continue
        elif ft - 60 < t_b and ft + dur + 60 > t_a:
            kept.append(p)
    log(f"  {len(kept)} of {len(files)} DAS files overlap the window"
        + (f" ({unnamed} without a time in the name were checked by header)" if unnamed else ""))
    if not kept:
        ts = [t for t, _ in named if t is not None]
        span = f"{utc_text(min(ts))} - {utc_text(max(ts) + dur)} UTC" if ts else "unknown"
        raise StopRun(f"no DAS file in {DAS_FOLDER} overlaps {utc_text(t_a)} - {utc_text(t_b)} UTC.\n"
                      f"    DAS files span {span}")
    return kept


def das_coverage(win=None):
    files = das_files(win)
    by_dir = {}
    for p in files:
        by_dir.setdefault(os.path.dirname(p), []).append(p)
    for d, fl in sorted(by_dir.items()):
        ts = [t for t in (name_time(os.path.basename(x)) for x in fl) if t is not None]
        span = f", {utc_text(min(ts), '%Y-%m-%d %H:%M')} - {utc_text(max(ts), '%Y-%m-%d %H:%M')} UTC" if ts else ""
        log(f"  DAS folder {os.path.relpath(d, DAS_FOLDER)}: {len(fl)} files{span}")
    dur = None
    for p in files[:: max(1, len(files) // 20)] + files[:5]:
        try:
            L = das_layout(p)
            dur = L["t1"] - L["t0"]
            break
        except Exception:
            continue
    if dur is None:
        raise StopRun(f"none of the DAS files in {DAS_FOLDER} could be opened as Febus or Sintela HDF5")
    iv = []
    for p in files:
        t, by_name = das_file_start(p)
        if t is not None:
            iv.append((t, t + dur))
    cover = merge_intervals(iv, gap=2.0)
    return cover, len(files), dur


def describe_intervals(iv, n=12):
    rows = [f"      {utc_text(a_, '%Y-%m-%d %H:%M')} - {utc_text(b_, '%Y-%m-%d %H:%M')} UTC "
            f"({(b_ - a_) / 3600:.1f} h)" for a_, b_ in iv[:n]]
    if len(iv) > n:
        rows.append(f"      ... {len(iv) - n} more")
    return "\n".join(rows) or "      none"


def choose_window(sel, win=None):
    das_iv, n_das, dur = das_coverage(win)
    seis_iv = merge_intervals(sel["cover"], gap=1.0)
    common = [iv for iv in intersect_intervals(das_iv, seis_iv) if iv[1] - iv[0] >= 2 * SEG_SEC]
    log(f"  DAS: {n_das} files of {dur:g} s, {utc_text(das_iv[0][0], '%Y-%m-%d %H:%M')} - "
        f"{utc_text(das_iv[-1][1], '%Y-%m-%d %H:%M')} UTC in {len(das_iv)} block(s)")
    log(f"  seismometer: {utc_text(seis_iv[0][0], '%Y-%m-%d %H:%M')} - "
        f"{utc_text(seis_iv[-1][1], '%Y-%m-%d %H:%M')} UTC in {len(seis_iv)} block(s)")
    need = DURATION_MIN * 60
    if win is not None:
        t_a, t_b = win
        need = t_b - t_a
        ov = sum(max(0.0, min(b_, t_b) - max(a_, t_a)) for a_, b_ in common)
        if ov < 4 * SEG_SEC:
            raise StopRun(f"DAS and seismometer do not both cover {utc_text(t_a)} - {utc_text(t_b)} UTC.\n"
                          f"    DAS in the window:\n{describe_intervals(das_iv)}\n"
                          f"    seismometer in the window:\n{describe_intervals(seis_iv)}\n"
                          f"    choose START_TIME / END_TIME where both record")
        if ov < 0.8 * need:
            log(f"  ! only {ov / 60:.0f} of {need / 60:.0f} min are covered by both instruments")
        return t_a, t_b
    if not common:
        raise StopRun(f"DAS and seismometer never record at the same time.\n"
                      f"    DAS:\n{describe_intervals(das_iv)}\n    seismometer:\n{describe_intervals(seis_iv)}")
    long_ = [iv for iv in common if iv[1] - iv[0] >= need]
    a_, b_ = (long_[0] if long_ else max(common, key=lambda iv: iv[1] - iv[0]))
    t_a = math.ceil(a_ / 60.0) * 60.0
    t_b = min(b_, t_a + need)
    if t_b - t_a < need:
        log(f"  ! longest common period is {(t_b - t_a) / 60:.0f} min, shorter than DURATION_MIN = {DURATION_MIN:g}")
    log(f"  START_TIME = auto -> {utc_text(t_a)} UTC (first period covered by both)")
    log(f"  periods covered by both:\n{describe_intervals(common, 6)}")
    return t_a, t_b


def inv_channel(inv, tr):
    net, sta, loc, cha = tr.stats.network, tr.stats.station, tr.stats.location, tr.stats.channel
    t = tr.stats.starttime
    allc = [(n, s, c) for n in inv for s in n for c in s]
    exact = [x for x in allc if x[0].code == net and x[1].code == sta and x[2].location_code == loc
             and x[2].code == cha and x[2].is_active(time=t)]
    if exact:
        return exact[0], "exact id"
    same = [x for x in allc if x[2].code == cha]
    timed = [x for x in same if x[2].is_active(time=t)] or same
    pref = [x for x in timed if x[1].code in station_codes()] or timed
    if not pref:
        raise StopRun(f"no channel {cha} in RESPONSE_FILES for {tr.id}; channels there: "
                      f"{sorted({x[2].code for x in allc})}")
    return pref[0], "channel code"


def load_inventory():
    from obspy import read_inventory, Inventory
    inv = Inventory(networks=[], source="merged")
    files = sorted({p for g in RESPONSE_FILES for p in glob.glob(g)})
    for p in files:
        try:
            inv += read_inventory(p)
        except Exception as e:
            log(f"  ! response file {os.path.basename(p)}: {e}")
    if not inv.networks:
        raise StopRun("no readable StationXML in RESPONSE_FILES")
    log(f"  StationXML: {len(files)} file(s)")
    return inv


def unit_vector(az, dip):
    a, d = math.radians(az), math.radians(dip)
    return np.array([math.cos(d) * math.sin(a), math.cos(d) * math.cos(a), -math.sin(d)])


def component_vector(comp):
    comp = comp.upper()
    if comp in ("N", "1"):
        return unit_vector(SEIS_H1_AZIMUTH_DEG, 0)
    if comp in ("E", "2"):
        return unit_vector(SEIS_H1_AZIMUTH_DEG + 90, 0)
    if comp in ("Z", "3", "U"):
        return unit_vector(0, -90)
    raise StopRun(f"unknown component {comp!r} in SEIS_COMPONENT_MAP (use Z, N, E)")


def seed_component(cha):
    c = cha[-1].upper()
    return {"Z": "Z", "N": "N", "E": "E", "1": "N", "2": "E", "3": "Z"}.get(c)


def scan_seismic(win=None):
    files = sorted(p for p in glob.glob(os.path.join(SEIS_FOLDER, "**" if SEIS_RECURSIVE else "", SEIS_PATTERN),
                                        recursive=SEIS_RECURSIVE)
                   if os.path.isfile(p) and not p.lower().endswith(SKIP_EXT))
    if not files:
        raise StopRun(f"no files matching {SEIS_PATTERN!r} in {SEIS_FOLDER}")
    if win is not None:
        files = window_files(files, *win)
    log(f"  reading headers of {len(files)} seismic files (cache in {cache_dir()})")
    return select_seismic(seis_index(files, win))


def load_seismic(t_a, t_b, inv, sel):
    from obspy import Stream, UTCDateTime
    ids = sel["ids"]
    need = sorted({p for p, t0, t1 in sel["files"] if t1 > t_a - 60 and t0 < t_b + 60})
    st = Stream()
    for p in need:
        try:
            part = open_seismic(p, starttime=UTCDateTime(t_a - 60), endtime=UTCDateTime(t_b + 60))
        except Exception as e:
            log(f"  ! {os.path.basename(p)}: {e}")
            continue
        st += Stream([t for t in part if t.id in ids])
    if not len(st):
        raise StopRun("the selected seismic files returned no samples in the window")
    log(f"  seismic: {len(need)} file(s) read")
    st.merge(method=1)
    st = st.split()
    n = int(round((t_b - t_a) * COMMON_FS_HZ))
    grids, vectors, info, coords, used = {}, {}, {}, None, {}
    for tr in st:
        cha = tr.stats.channel
        (net_i, sta_i, ch_i), how = inv_channel(inv, tr)
        key = f"{net_i.code}.{sta_i.code}.{ch_i.location_code}.{ch_i.code}"
        if cha not in used:
            used[cha] = key
            log(f"  response for {tr.id}: {key} (matched by {how})")
        if coords is None:
            coords = {"latitude": ch_i.latitude if ch_i.latitude is not None else sta_i.latitude,
                      "longitude": ch_i.longitude if ch_i.longitude is not None else sta_i.longitude}
        try:
            nyq = tr.stats.sampling_rate / 2.0
            tr.detrend("demean")
            tr.stats.response = ch_i.response
            tr.remove_response(inventory=None, output="VEL", water_level=SEIS_WATER_LEVEL_DB,
                               pre_filt=(SEIS_PREFILT_LO_HZ[0], SEIS_PREFILT_LO_HZ[1], 0.8 * nyq, 0.95 * nyq),
                               taper=True, taper_fraction=0.02)
        except Exception as e:
            raise StopRun(f"response removal failed for {tr.id} with {key}: {e}")
        y = tr.data.astype(np.float64)
        up, down = ratio(tr.stats.sampling_rate, COMMON_FS_HZ)
        if (up, down) != (1, 1):
            y = resample_poly(y, up, down, padtype="line")
        t0 = tr.stats.starttime.timestamp + SEIS_TIME_SHIFT_SEC
        i0 = int(round((t0 - t_a) * COMMON_FS_HZ))
        g = grids.setdefault(cha, np.full(n, np.nan))
        j0, j1 = max(0, -i0), min(len(y), n - i0)
        if j1 > j0:
            g[i0 + j0:i0 + j1] = y[j0:j1]
        if cha not in vectors:
            if SEIS_COMPONENT_MAP and cha in SEIS_COMPONENT_MAP:
                comp = SEIS_COMPONENT_MAP[cha].upper()
                vectors[cha] = component_vector(comp)
                info[cha] = f"{comp} (SEIS_COMPONENT_MAP)"
            elif ch_i.azimuth is not None and ch_i.dip is not None:
                vectors[cha] = unit_vector(ch_i.azimuth, ch_i.dip)
                info[cha] = f"azimuth {ch_i.azimuth:g}, dip {ch_i.dip:g} (StationXML {key})"
            else:
                vectors[cha] = None
                info[cha] = f"no azimuth/dip in StationXML {key}"
            info[cha] += f", {tr.stats.sampling_rate:g} Hz"
    chans = sorted(grids)
    if len(chans) < 3:
        raise StopRun(f"three components needed, found {chans}")
    chans = chans[:3]
    bad = any(vectors[c] is None for c in chans) or abs(np.linalg.det(np.vstack(
        [vectors[c] if vectors[c] is not None else np.zeros(3) for c in chans]))) < 0.3
    if bad:
        seed = {c: seed_component(c) for c in chans}
        if sorted(v or "" for v in seed.values()) != ["E", "N", "Z"]:
            raise StopRun("seismometer orientations are missing or not independent ("
                          + "; ".join(f"{c}: {info[c]}" for c in chans)
                          + "): set SEIS_COMPONENT_MAP, e.g. {'CH1': 'N', 'CH2': 'E', 'CHZ': 'Z'}")
        log("  ! StationXML azimuth/dip are placeholders (" + "; ".join(f"{c}: {info[c].split(',')[0]}"
            for c in chans) + ")")
        log("    using the SEED channel convention: " + ", ".join(f"{c} = {seed[c]}" for c in chans)
            + f", component 1 at azimuth {SEIS_H1_AZIMUTH_DEG:g}°")
        log("    set SEIS_COMPONENT_MAP / SEIS_H1_AZIMUTH_DEG if the sensor was installed differently")
        for c in chans:
            vectors[c] = component_vector(seed[c])
            info[c] = f"{seed[c]} (SEED convention, StationXML orientation missing)" + ", " + info[c].split(", ")[-1]
    U = np.vstack([vectors[c] for c in chans])
    X = np.vstack([grids[c] for c in chans])
    ENZ = np.linalg.solve(U, np.nan_to_num(X)).T
    ENZ[~np.all(np.isfinite(X), axis=0)] = np.nan
    for c in chans:
        log(f"  seismometer {c}: {info[c]}")
    sid = f"{st[0].stats.network}.{SEIS_STATION}"
    log(f"  seismometer: {sid}, coverage {100 * np.isfinite(ENZ[:, 0]).mean():.1f} % of the window")
    return ENZ.astype(np.float32), sid, coords, {c: info[c] for c in chans}


def station_location(coords_xml):
    if SEIS_STATION_COORDS:
        return {"latitude": float(SEIS_STATION_COORDS[0]), "longitude": float(SEIS_STATION_COORDS[1])}, \
            "SEIS_STATION_COORDS"
    if STATION_LOCATIONS_FILE and os.path.exists(STATION_LOCATIONS_FILE):
        try:
            import pandas as pd
            ext = os.path.splitext(STATION_LOCATIONS_FILE)[1].lower()
            df = (pd.read_excel(STATION_LOCATIONS_FILE) if ext in (".xlsx", ".xls")
                  else pd.read_csv(STATION_LOCATIONS_FILE, sep=None, engine="python"))
            norm = {re.sub(r"[^a-z]", "", str(c).lower()): c for c in df.columns}
            lat_c = next((norm[k] for k in norm if k.startswith("lat")), None)
            lon_c = next((norm[k] for k in norm if k.startswith(("lon", "lng"))), None)
            if lat_c and lon_c:
                for c in [x.upper() for x in station_codes()]:
                    for _, r in df.iterrows():
                        txt = " ".join(str(v) for v in r.values if isinstance(v, str)).upper()
                        if re.search(rf"(^|[^A-Z0-9]){re.escape(c)}([^A-Z0-9]|$)", txt):
                            return ({"latitude": float(r[lat_c]), "longitude": float(r[lon_c])},
                                    f"{os.path.basename(STATION_LOCATIONS_FILE)} ({c})")
                log(f"  ! {SEIS_STATION} not found in {os.path.basename(STATION_LOCATIONS_FILE)}")
        except Exception as e:
            log(f"  ! {os.path.basename(STATION_LOCATIONS_FILE)}: {e}")
    if coords_xml and coords_xml.get("latitude") and abs(coords_xml["latitude"]) > 1e-6:
        return coords_xml, "StationXML"
    return None, "none"


def fibre_geometry(channels, dx, station_coords, coord_src):
    chs = np.asarray(channels)
    geo = dict(az=np.full(len(chs), np.nan), dist=np.full(len(chs), np.nan), source="none",
               nearest=None, nearest_dist=np.nan, coord_src=coord_src)
    if FIBRE_AZIMUTH_DEG is not None:
        geo["az"][:] = float(FIBRE_AZIMUTH_DEG)
        geo["source"] = f"FIBRE_AZIMUTH_DEG = {FIBRE_AZIMUTH_DEG}"
        return geo
    if not FIBRE_CHANNELS_CSV or not os.path.exists(FIBRE_CHANNELS_CSV):
        log("  ! no fibre channel table and no FIBRE_AZIMUTH_DEG: the fibre-axial projection is not possible")
        return geo
    tab = np.genfromtxt(FIBRE_CHANNELS_CSV, delimiter=",", names=True, dtype=None, encoding="utf-8")
    ch_t = np.asarray(tab["channel"], int)
    lat, lon = np.asarray(tab["latitude"], float), np.asarray(tab["longitude"], float)
    lat0 = float(np.nanmean(lat))
    kx, ky = 111320.0 * math.cos(math.radians(lat0)), 110540.0
    X, Y = lon * kx, lat * ky
    k = max(1, int(round(AZIMUTH_HALF_WIN_M / dx)))
    for i, c in enumerate(chs):
        a = np.searchsorted(ch_t, c - k)
        b = np.searchsorted(ch_t, c + k, side="right") - 1
        if a < len(ch_t) and b > a:
            geo["az"][i] = math.degrees(math.atan2(X[b] - X[a], Y[b] - Y[a])) % 360
    geo["source"] = os.path.basename(FIBRE_CHANNELS_CSV)
    if station_coords:
        sx, sy = station_coords["longitude"] * kx, station_coords["latitude"] * ky
        d_all = np.hypot(X - sx, Y - sy)
        j = int(np.argmin(d_all))
        geo["nearest_dist"] = float(d_all[j])
        for i, c in enumerate(chs):
            m = np.searchsorted(ch_t, c)
            if m < len(ch_t) and ch_t[m] == c:
                geo["dist"][i] = float(d_all[m])
        if d_all[j] <= MAX_STATION_FIBRE_M:
            geo["nearest"] = int(ch_t[j])
            log(f"  {SEIS_STATION} position from {coord_src}: nearest channel {ch_t[j]}, {d_all[j]:.1f} m from the fibre")
            if not (chs[0] <= ch_t[j] <= chs[-1]):
                log(f"  ! nearest channel {ch_t[j]} is outside the analysed channels {chs[0]}-{chs[-1]}")
        else:
            log(f"  ! {SEIS_STATION} position from {coord_src} is {d_all[j]:.0f} m from the fibre: not used "
                f"(set SEIS_STATION_COORDS or STATION_LOCATIONS_FILE)")
    ok = np.isfinite(geo["az"])
    if ok.any():
        log(f"  fibre azimuth from {geo['source']}: {np.nanmin(geo['az']):.0f}-{np.nanmax(geo['az']):.0f} deg "
            f"over channels {chs[ok].min()}-{chs[ok].max()}")
    return geo


def effective_band(native_rates):
    lo, hi = float(BAND_HZ[0]), float(BAND_HZ[1])
    cap = 0.45 * min([COMMON_FS_HZ] + [float(r) for r in native_rates if r])
    if hi > cap:
        log(f"  ! BAND_HZ upper corner {hi:g} Hz is above 0.45 x the lowest sampling rate: using {cap:.3g} Hz")
        hi = float(f"{cap:.3g}")
    if lo >= hi:
        raise StopRun(f"band {lo:g}-{hi:g} Hz is empty: lower BAND_HZ[0]")
    return lo, hi


def bandpass(x, band):
    sos = butter(4, [band[0], band[1]], btype="bandpass", fs=COMMON_FS_HZ, output="sos")
    return sosfiltfilt(sos, np.asarray(x, np.float64), axis=0)


def by_segment(x, ok, func, band):
    out = np.full(len(x), np.nan)
    edges = np.flatnonzero(np.diff(np.r_[0, ok.astype(int), 0]))
    pad = int(round(5.0 / band[0] * COMMON_FS_HZ))
    for a, b in zip(edges[::2], edges[1::2]):
        if b - a < int(LTA_SEC * COMMON_FS_HZ):
            continue
        p_ = min(pad, b - a - 1)
        y = func(np.pad(np.asarray(x[a:b], np.float64), (p_, p_), mode="reflect"))
        out[a:b] = y[p_:p_ + (b - a)]
    return out


def quantities():
    q = QUANTITY_PAIR.replace(" ", "").lower()
    if q in ("strain_rate/acceleration", "strainrate/acceleration"):
        return "strain_rate", "acceleration"
    if q in ("strain/velocity",):
        return "strain", "velocity"
    raise StopRun("QUANTITY_PAIR must be 'strain_rate/acceleration' or 'strain/velocity'")


def prepare_traces(das, enz, geo, iref, band):
    q_das, q_seis = quantities()
    ok_d = np.isfinite(das[:, iref])
    ok_s = np.all(np.isfinite(enz), axis=1)
    if SEIS_COMPONENT == "axial" and np.isfinite(geo["az"][iref]):
        a_ = math.radians(float(geo["az"][iref]))
        v = enz[:, 0] * math.sin(a_) + enz[:, 1] * math.cos(a_)
        comp = f"fibre-axial (az {float(geo['az'][iref]):.0f}°)"
    else:
        k = {"E": 0, "N": 1, "Z": 2}.get(str(SEIS_COMPONENT).upper(), 0)
        v = enz[:, k]
        comp = "ENZ"[k] + (" (no fibre azimuth)" if SEIS_COMPONENT == "axial" else "")
    if q_das == "strain_rate":
        d = by_segment(das[:, iref], ok_d, lambda z: bandpass(z, band), band) * 1e9
        d_unit, d_name, d_si = "nε/s", "strain rate", 1e-9
    else:
        d = by_segment(das[:, iref], ok_d,
                       lambda z: bandpass(np.cumsum(z - z.mean()) / COMMON_FS_HZ, band), band) * 1e9
        d_unit, d_name, d_si = "nε", "strain", 1e-9
    vb = by_segment(v, ok_s, lambda z: bandpass(z, band), band)
    if q_seis == "acceleration":
        s = np.gradient(vb, 1.0 / COMMON_FS_HZ) * 1e3
        s_unit, s_name, s_si = "mm/s²", "acceleration", 1e-3
    else:
        s = vb * 1e6
        s_unit, s_name, s_si = "µm/s", "velocity", 1e-6
    return dict(d=d, s=s, d_unit=d_unit, s_unit=s_unit, d_name=d_name, s_name=s_name, comp=comp,
                d_si=d_si, s_si=s_si, band=band)


def make_equivalent_acceleration(T):
    if T["d_name"] != "strain rate" or T["s_name"] != "acceleration":
        raise StopRun("Equivalent acceleration plots require QUANTITY_PAIR = 'strain_rate/acceleration'")
    if not np.isfinite(FK_APPARENT_VELOCITY_MPS) or FK_APPARENT_VELOCITY_MPS <= 0:
        raise StopRun("FK_APPARENT_VELOCITY_MPS must be a finite positive velocity in m/s")
    A = dict(T)
    A["d"] = np.asarray(T["d"], dtype=np.float64) * FK_APPARENT_VELOCITY_MPS * 1e-6
    A["d_unit"] = "mm/s²"
    A["d_name"] = "estimated axial acceleration"
    A["d_si"] = 1e-3
    A["equivalent_velocity_mps"] = float(FK_APPARENT_VELOCITY_MPS)
    A["equivalent_velocity_source"] = FK_VELOCITY_SOURCE
    return A


def sta_lta(x):
    from obspy.signal.trigger import classic_sta_lta
    ok = np.isfinite(x)
    y = np.where(ok, x, 0.0)
    nsta, nlta = int(round(STA_SEC * COMMON_FS_HZ)), int(round(LTA_SEC * COMMON_FS_HZ))
    r = classic_sta_lta(y, nsta, nlta)
    bad = ~ok
    if bad.any():
        cum_bad = np.r_[0, np.cumsum(bad.astype(np.int64))]
        idx = np.arange(len(bad))
        left = np.maximum(0, idx - nlta + 1)
        r[(cum_bad[idx + 1] - cum_bad[left]) > 0] = 0.0
    r[:nlta] = 0.0
    return r


def detect(r, x, t0):
    from obspy.signal.trigger import trigger_onset
    on_off = trigger_onset(r, TRIGGER_ON, TRIGGER_OFF) if np.nanmax(r) >= TRIGGER_ON else []
    ev = []
    for a, b in on_off:
        if (b - a) / COMMON_FS_HZ < MIN_EVENT_SEC:
            continue
        if ev and (a - ev[-1]["off_i"]) / COMMON_FS_HZ < DECLUSTER_SEC:
            ev[-1]["off_i"] = int(b)
            continue
        ev.append(dict(on_i=int(a), off_i=int(b)))
    npre = int(round(PRE_EVENT_NOISE_SEC * COMMON_FS_HZ))
    for e in ev:
        a, b = e["on_i"], max(e["off_i"], e["on_i"] + 1)
        seg = x[a:b]
        pre = x[max(0, a - npre):a]
        sig_e2 = float(np.nanmean(seg ** 2)) if np.isfinite(seg).any() else np.nan
        sig_n2 = float(np.nanmean(pre ** 2)) if len(pre) and np.isfinite(pre).any() else np.nan
        exc = max(sig_e2 - sig_n2, 0.0) / sig_n2 if sig_n2 and np.isfinite(sig_n2) else np.nan
        e.update(t_on=t0 + a / COMMON_FS_HZ, t_off=t0 + b / COMMON_FS_HZ, dur=(b - a) / COMMON_FS_HZ,
                 peak_ratio=float(np.max(r[a:b])), peak_amp=float(np.nanmax(np.abs(seg))),
                 snr_total=sig_e2 / sig_n2 if sig_n2 else np.nan,
                 snr_excess_db=10 * math.log10(exc) if exc and exc > 0 else np.nan)
    return ev


def match(ev_d, ev_s):
    pairs, used_s = [], set()
    for i, e in enumerate(ev_d):
        best, bj = None, None
        for j, f in enumerate(ev_s):
            if j in used_s:
                continue
            dt = e["t_on"] - f["t_on"]
            if abs(dt) <= MATCH_TOL_SEC and (best is None or abs(dt) < abs(best)):
                best, bj = dt, j
        if bj is not None:
            used_s.add(bj)
            pairs.append((i, bj, best))
            e["match"] = "common"
            ev_s[bj]["match"] = "common"
    for e in ev_d:
        e.setdefault("match", "DAS only")
    for f in ev_s:
        f.setdefault("match", "seismometer only")
    for k, (i, j, _) in enumerate(sorted(pairs, key=lambda p: ev_d[p[0]]["t_on"]), 1):
        ev_d[i]["id"] = ev_s[j]["id"] = f"C{k:02d}"
    for ev, tag in ((ev_d, "D"), (ev_s, "S")):
        k = 0
        for e in ev:
            if e["match"] != "common":
                k += 1
                e["id"] = f"{tag}{k:02d}"
    return sorted(pairs, key=lambda p: ev_d[p[0]]["t_on"])


def pair_metrics(T, e, f):
    n = len(T["d"])
    pad = int(round(0.5 * COMMON_FS_HZ))
    a = max(0, min(e["on_i"], f["on_i"]) - pad)
    b = min(n, max(e["off_i"], f["off_i"]) + pad)
    d, s = T["d"][a:b], T["s"][a:b]
    ok = np.isfinite(d) & np.isfinite(s)
    out = dict(cc=np.nan, cc_lag=np.nan, polarity=1.0, c_app=np.nan, win=(a, b))
    if ok.sum() < 10:
        return out
    d0, s0 = d[ok] - d[ok].mean(), s[ok] - s[ok].mean()
    den = math.sqrt(float(np.sum(d0 ** 2) * np.sum(s0 ** 2)))
    if den == 0:
        return out
    cc = correlate(d0, s0, mode="full") / den
    lags = correlation_lags(len(d0), len(s0), mode="full")
    m = np.abs(lags) <= int(round(CC_MAX_LAG_SEC * COMMON_FS_HZ))
    k = int(np.argmax(np.abs(cc[m])))
    out["cc"] = float(cc[m][k])
    out["cc_lag"] = float(lags[m][k] / COMMON_FS_HZ)
    out["polarity"] = 1.0 if out["cc"] >= 0 else -1.0
    pd_, ps_ = float(np.max(np.abs(d0))), float(np.max(np.abs(s0)))
    if pd_ > 0:
        out["c_app"] = ps_ * T["s_si"] / (pd_ * T["d_si"])
    return out


def wilson(k, n, z=1.96):
    if n == 0:
        return np.nan, np.nan, np.nan
    p = k / n
    den = 1 + z * z / n
    c = (p + z * z / (2 * n)) / den
    h = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / den
    return p, max(0.0, c - h), min(1.0, c + h)


def stats(ev_d, ev_s, pairs, metrics, hours):
    n_d, n_s, n_c = len(ev_d), len(ev_s), len(pairs)
    pd_, lo, hi = wilson(n_c, n_s)
    pr, plo, phi = wilson(n_c, n_d)
    lags = np.array([p[2] for p in pairs])
    S = dict(n_d=n_d, n_s=n_s, n_c=n_c, n_d_only=n_d - n_c, n_s_only=n_s - n_c, pd=pd_, pd_ci=(lo, hi),
             prec=pr, prec_ci=(plo, phi), far_per_h=(n_d - n_c) / hours if hours > 0 else np.nan)
    S["pd_txt"] = f"{pd_:.2f} [{lo:.2f}–{hi:.2f}]" if n_s else "n/a"
    S["prec_txt"] = f"{pr:.2f} [{plo:.2f}–{phi:.2f}]" if n_d else "n/a"
    if len(lags):
        S["lag_med"] = float(np.median(lags))
        S["lag_iqr"] = (float(np.percentile(lags, 25)), float(np.percentile(lags, 75)))
        S["lag_txt"] = f"{S['lag_med'] * 1000:+.0f} ms"
    else:
        S["lag_txt"] = "n/a"
    cc = np.array([m["cc"] for m in metrics], float)
    ca = np.array([m["c_app"] for m in metrics], float)
    S["cc_med"] = float(np.nanmedian(np.abs(cc))) if np.isfinite(cc).any() else np.nan
    S["c_app_med"] = float(np.nanmedian(ca)) if np.isfinite(ca).any() else np.nan
    good = [m["cc_lag"] for m in metrics if np.isfinite(m["cc"]) and abs(m["cc"]) >= CC_MIN_FOR_CLOCK]
    S["cc_lag_n"] = len(good)
    S["cc_lag_med"] = float(np.median(good)) if good else np.nan
    return S


