                transform=ax.get_xaxis_transform(), clip_on=False, zorder=5)
        if labels:
            ax.annotate(e.get("id", ""), (tnum(e["t_on"]), 1.0), xycoords=ax.get_xaxis_transform(),
                        xytext=(0, 8), textcoords="offset points", ha="center", va="bottom",
                        fontsize=FONT_TICK - 2, color=c, fontweight="bold", annotation_clip=False)


def fig_overview(T, R_d, R_s, ev_d, ev_s, info, base, equivalent=False):
    n = len(T["d"])
    if not (len(T["s"]) == len(R_d) == len(R_s) == n):
        raise StopRun("DAS, seismic and STA/LTA arrays must have the same time-grid length")
    tn = tnum(info["t_a"] + np.arange(n) / COMMON_FS_HZ)
    das_valid = np.isfinite(T["d"])
    seis_valid = np.isfinite(T["s"])
    fig = new_figure(FIGSIZE)
    gs = fig.add_gridspec(5, 1, height_ratios=[1.05, 1.0, 0.62, 1.0, 0.62])
    hdr = fig.add_subplot(gs[0])
    hdr.axis("off")
    axes = [fig.add_subplot(gs[1])]
    for i in range(2, 5):
        axes.append(fig.add_subplot(gs[i], sharex=axes[0]))
    px = FIGSIZE[0] * DPI * 0.9
    labels = (len(ev_d) + len(ev_s)) <= LABEL_EVENTS_MAX
    band = T["band"]

    shared_lim = None
    if equivalent:
        finite = np.r_[np.abs(np.asarray(T["d"])[np.isfinite(T["d"])]),
                       np.abs(np.asarray(T["s"])[np.isfinite(T["s"])])]
        shared_lim = (max(1e-10, float(np.percentile(finite, WAVE_CLIP_PERCENTILE)) * 1.08) if finite.size else 1.0) / 2.0

    def mark_unavailable(ax, valid):
        missing = ~valid
        if not np.any(missing):
            return
        edges = np.flatnonzero(np.diff(np.r_[0, missing.astype(np.int8), 0]))
        for a, b in zip(edges[::2], edges[1::2]):
            if (b - a) / COMMON_FS_HZ >= 1.0:
                ax.axvspan(tnum(info["t_a"] + a / COMMON_FS_HZ),
                           tnum(info["t_a"] + b / COMMON_FS_HZ),
                           color="0.6", alpha=0.12, lw=0, zorder=-2)

    def wave(ax, x, color, ev, ylab, half_original_seismic=False):
        draw_trace(ax, tn, x, color, px=px)
        fin = np.abs(x[np.isfinite(x)])
        lim = shared_lim if shared_lim is not None else (
            max(1e-12, float(np.percentile(fin, WAVE_CLIP_PERCENTILE)) * 1.08) if fin.size else 1.0)
        if half_original_seismic and not equivalent:
            lim /= 2.0
        ax.set_ylim(-lim, lim)
        ax.set_ylabel(ylab)
        shade_events(ax, ev, labels)

    def stalta(ax, r, color, ev):
        tb, hi = draw_trace(ax, tn, r, color, lw=0.9, px=px)
        ax.fill_between(tb, TRIGGER_ON, hi, where=hi >= TRIGGER_ON, color=color, alpha=0.35,
                        lw=0, interpolate=True, rasterized=True)
        ax.axhline(TRIGGER_ON, color="black", lw=1.0, ls="--", alpha=0.35, zorder=4)
        ax.axhline(TRIGGER_OFF, color=COLOR_OFF, lw=1.0, ls="-.", alpha=0.35, zorder=4)
        top = max(TRIGGER_ON * 2.0, float(np.nanmax(r)) * 1.12 if np.isfinite(r).any() else 0)
        ax.set_ylim(0, top)
        ax.set_ylabel("STA/LTA")
        shade_events(ax, ev, False)

    dist = f" ({info['ref_dist']:.1f} m)" if np.isfinite(info.get("ref_dist", np.nan)) else ""
    wave(axes[0], T["d"], COLOR_DAS, ev_d, f"{T['d_name'].capitalize()}\n({T['d_unit']})")
    stalta(axes[1], np.where(das_valid, R_d, np.nan), COLOR_DAS, ev_d)
    wave(axes[2], T["s"], COLOR_SEIS, ev_s, f"{T['s_name'].capitalize()}\n({T['s_unit']})",
         half_original_seismic=True)
    stalta(axes[3], np.where(seis_valid, R_s, np.nan), COLOR_SEIS, ev_s)
    for ax, valid in zip(axes, (das_valid, das_valid, seis_valid, seis_valid)):
        mark_unavailable(ax, valid)
    if das_valid.any() and not das_valid[0]:
        first_d = int(np.flatnonzero(das_valid)[0])
        axes[0].text(0.003, 0.035, f"Initial DAS data gap: {first_d / COMMON_FS_HZ:.1f} s",
                     transform=axes[0].transAxes, fontsize=max(8.0, FONT_TICK - 3),
                     color="0.40", va="bottom", ha="left",
                     bbox=dict(facecolor="white", edgecolor="none", alpha=0.8, pad=1.4))

    titles = [f"(a) {info['das_name']} ch {info['ref']}{dist} — {T['d_name']}, {band[0]:g}–{band[1]:g} Hz, "
              f"{len(ev_d)} events",
              "(b) DAS STA/LTA — detections from the original strain-rate trace",
              f"(c) Seismometer {info['sid']}, {T['comp']} {T['s_name']}, {band[0]:g}–{band[1]:g} Hz, "
              f"{len(ev_s)} events",
              "(d) Seismometer STA/LTA (same detection parameters)"]
    for ax, ttl in zip(axes, titles):
        ax.set_title(ttl, loc="left", pad=18 if labels else 10)
        time_axis(ax, label=ax is axes[-1])
        ax.tick_params(labelbottom=ax is axes[-1])
        ax.margins(x=0)
    axes[-1].set_xlabel("Time (UTC)")
    axes[0].set_xlim(tnum(info["t_a"]), tnum(info["t_b"]))

    S = info["stats"]
    mode = "Acceleration" if equivalent else "Measurements"
    hdr.text(0.0, 0.99,
             f"STA/LTA event detection | {mode} | {info['das_name']} CH {info['ref']} vs {info['sid']}",
             fontsize=FONT_TITLE, fontweight="bold", va="top", ha="left", transform=hdr.transAxes)
    hdr.text(0.0, 0.80,
             f"{utc_text(info['t_a'])} – {utc_text(info['t_b'])} UTC  |  {band[0]:g}–{band[1]:g} Hz  |  "
             f"STA {STA_SEC:g} s, LTA {LTA_SEC:g} s, on {TRIGGER_ON:g}, off {TRIGGER_OFF:g}, match ±{MATCH_TOL_SEC:g} s",
             fontsize=FONT_SUBTITLE, va="top", transform=hdr.transAxes)
    hdr.text(0.0, 0.63,
             f"DAS {S['n_d']} events, seismometer {S['n_s']}, common {S['n_c']}  |  "
             f"P_D = {S['pd_txt']}  |  precision = {S['prec_txt']}\n"
             f"onset lag DAS − seis: {S['lag_txt']}",
             fontsize=FONT_SUBTITLE, va="top", transform=hdr.transAxes)
    if equivalent:
        caveat = "" if "no fibre azimuth" in T["comp"] else "Fiber-axial proxy; assumes one-dimensional traveling waves"
        hdr.text(0.0, 0.32,
                 f"DAS estimate: a = c_app × strain rate; c_app ≈ {FK_APPARENT_VELOCITY_MPS:g} m/s from f–k ",
                 fontsize=FONT_TICK, va="top", transform=hdr.transAxes)
    handles = [Patch(fc=COLOR_COMMON, alpha=0.5, label=f"common ({S['n_c']})"),
               Patch(fc=COLOR_DAS, alpha=0.5, label=f"DAS only ({S['n_d_only']})"),
               Patch(fc=COLOR_SEIS, alpha=0.5, label=f"seismometer only ({S['n_s_only']})"),
               Line2D([], [], color="black", ls="--", lw=1.3, label=f"trigger on {TRIGGER_ON:g}"),
               Line2D([], [], color=COLOR_OFF, ls="-.", lw=1.3, label=f"detrigger off {TRIGGER_OFF:g}")]
    hdr.legend(handles=handles, loc="lower left", bbox_to_anchor=(0.0, 0.03), ncol=5,
               handlelength=2.2, columnspacing=1.8, borderaxespad=0.0)
    return save_figure(fig, base)


def fig_gallery(T, ev_d, ev_s, pairs, metrics, info, base, equivalent=False):
    if not pairs:
        return []
    order = sorted(range(len(pairs)), key=lambda k: -np.nan_to_num(ev_d[pairs[k][0]]["snr_excess_db"], nan=-99))
    order = sorted(order[:GALLERY_MAX])
    ncol = min(GALLERY_NCOLS, len(order))
    nrow = int(math.ceil(len(order) / ncol))
    fig = new_figure((5.6 * ncol + 0.6, 3.0 * nrow + 1.8))
    gs = fig.add_gridspec(nrow, ncol)
    longest = max(max(ev_d[pairs[k][0]]["dur"], ev_s[pairs[k][1]]["dur"]) for k in order)
    post_sec = float(min(GALLERY_POST_SEC, max(3.0, math.ceil(1.6 * longest + 1.0))))
    pre_sec = float(min(GALLERY_PRE_SEC, max(1.0, 0.4 * post_sec)))
    pre, post = int(pre_sec * COMMON_FS_HZ), int(post_sec * COMMON_FS_HZ)
    n = len(T["d"])
    for p, k in enumerate(order):
        i, j, dt = pairs[k]
        e, f, m = ev_d[i], ev_s[j], metrics[k]
        ax = fig.add_subplot(gs[p // ncol, p % ncol])
        a, b = max(0, e["on_i"] - pre), min(n, e["on_i"] + post)
        tt = (np.arange(a, b) - e["on_i"]) / COMMON_FS_HZ
        d, s = T["d"][a:b], T["s"][a:b]
        nd = float(np.nanmax(np.abs(d))) if np.isfinite(d).any() else 0.0
        ns = float(np.nanmax(np.abs(s))) if np.isfinite(s).any() else 0.0
        if equivalent:
            ax.plot(tt, d, color=COLOR_DAS, lw=1.0, label=f"DAS est. (peak {nd:.3g} mm/s²)")
            ax.plot(tt, s, color=COLOR_SEIS, lw=1.0, alpha=0.85,
                    label=f"seis (peak {ns:.3g} mm/s²)")
            lim = max(1e-9, nd, ns) * 1.1
            ax.set_ylim(-lim, lim)
        else:
            ax.plot(tt, d / (nd if nd > 0 else 1.0), color=COLOR_DAS, lw=1.0,
                    label=f"DAS (peak {nd:.3g} {T['d_unit']})")
            ax.plot(tt, s * m["polarity"] / (ns if ns > 0 else 1.0), color=COLOR_SEIS, lw=1.0, alpha=0.85,
                    label=f"seis{' ×(−1)' if m['polarity'] < 0 else ''} (peak {ns:.3g} {T['s_unit']})")
            ax.set_ylim(-1.5, 1.5)
        ax.axvline(0, color=COLOR_DAS, lw=1.0, ls="--", alpha=0.25)
        ax.axvline(f["t_on"] - e["t_on"], color=COLOR_SEIS, lw=1.0, ls=":", alpha=0.25)
        ax.set_xlim(-pre_sec, post_sec)
        ax.set_title(f"{e['id']}  {utc_text(e['t_on'], '%H:%M:%S')}.{int(round(e['t_on'] % 1 * 1000)) % 1000:03d}",
                     loc="left", fontsize=FONT_LABEL)
        ax.text(0.99, 0.03,
                f"onset Δt {dt * 1000:+.0f} ms   CC {m['cc']:+.2f} at {m['cc_lag'] * 1000:+.0f} ms",
                transform=ax.transAxes, ha="right", va="bottom", fontsize=FONT_TICK - 1,
                bbox=dict(fc="white", ec="0.8", lw=0.6, alpha=0.9, pad=2.5))
        ax.legend(loc="upper right", fontsize=FONT_TICK - 2, handlelength=1.4)
        if p // ncol == nrow - 1 or p + ncol >= len(order):
            ax.set_xlabel("Time after DAS onset (s)")
        if p % ncol == 0:
            ax.set_ylabel("Acceleration (mm/s²)" if equivalent else "Normalised")
    more = f" " if len(pairs) > len(order) else ""
    title = (f"Common events{more} | {info['das_name']} ch {info['ref']} vs "
             f"{info['sid']} | {utc_text(info['t_a'])}–{utc_text(info['t_b'], '%H:%M:%S')} UTC")
    if equivalent:
        subtitle = (f"Acceleration (mm/s²), {T['band'][0]:g}–{T['band'][1]:g} Hz | "
                    f"DAS: c_app ≈ {FK_APPARENT_VELOCITY_MPS:g} m/s from f–k")
        detail = "Dashed: DAS onset; dotted: seismic onset"
    else:
        subtitle = (f"DAS {T['d_name']} ({T['d_unit']}) vs seismic {T['s_name']} ({T['s_unit']}), "
                    f"{T['band'][0]:g}–{T['band'][1]:g} Hz")
        detail = "Individually normalised, seismic polarity adjusted by CC | Dashed: DAS onset; dotted: seismic onset"
    fig.suptitle(title + "\n" + subtitle + "\n" + detail,
                 fontsize=FONT_TICK + 5, fontweight="bold")
    return save_figure(fig, base)


def fig_summary(T, ev_d, ev_s, pairs, metrics, info, base):
    S = info["stats"]
    fig = new_figure((18.0, 5.6))
    ax1, ax2, ax3 = fig.subplots(1, 3, gridspec_kw=dict(width_ratios=[0.8, 1.0, 1.0]))
    names = ["DAS", "seismometer", "common", "DAS only", "seis only"]
    vals = [S["n_d"], S["n_s"], S["n_c"], S["n_d_only"], S["n_s_only"]]
    cols = [COLOR_DAS, COLOR_SEIS, COLOR_COMMON, COLOR_DAS, COLOR_SEIS]
    bars = ax1.bar(names, vals, color=cols, alpha=0.85, edgecolor="black", lw=0.6)
    for bar_ in bars[3:]:
        bar_.set_hatch("//")
    ax1.bar_label(bars, padding=3, fontsize=FONT_TICK)
    ax1.set_ylabel("Number of events")
    ax1.set_title("(a) Event counts", loc="left")
    ax1.text(0.98, 0.97, f"P_D = {S['pd_txt']}\nprecision = {S['prec_txt']}", transform=ax1.transAxes,
             ha="right", va="top", fontsize=FONT_TICK, bbox=dict(fc="white", ec="0.8", lw=0.6, pad=3))
    ax1.tick_params(axis="x", rotation=20, which="both", bottom=False)
    ax1.set_ylim(0, max(vals + [1]) * 1.5)
    ax1.grid(axis="x", visible=False)
    lags = np.array([p[2] for p in pairs]) * 1000
    if len(lags):
        w = max(5.0, 1000.0 / COMMON_FS_HZ)
        lo_, hi_ = math.floor(lags.min() / w) * w - w, math.ceil(lags.max() / w) * w + w
        cl = np.array([m["cc_lag"] for m in metrics], float) * 1000
        cl = cl[np.isfinite(cl)]
        if cl.size:
            lo_, hi_ = min(lo_, math.floor(cl.min() / w) * w - w), max(hi_, math.ceil(cl.max() / w) * w + w)
        bins = np.arange(lo_, hi_ + w, w)
        ax2.hist(lags, bins=bins, color=COLOR_COMMON, alpha=0.85, edgecolor="black", lw=0.6, label="STA/LTA onsets")
        if cl.size:
            ax2.hist(cl, bins=bins, histtype="step", color="black", lw=1.8, label="waveform CC")
        ax2.axvline(np.median(lags), color=COLOR_COMMON, lw=1.8, ls="--", label=f"median onset {np.median(lags):+.0f} ms")
        if np.isfinite(S["cc_lag_med"]):
            ax2.axvline(S["cc_lag_med"] * 1000, color="black", lw=1.5, ls=":",
                        label=f"median CC {S['cc_lag_med'] * 1000:+.0f} ms")
        ax2.axvline(0, color="0.5", lw=1.0)
        ax2.legend(loc="upper right")
    else:
        ax2.text(0.5, 0.5, "no common events", ha="center", va="center", transform=ax2.transAxes)
    ax2.set_xlabel("Lag DAS − seismometer (ms)")
    ax2.set_ylabel("Count")
    ax2.set_title("(b) Time lag of common events", loc="left")
    if pairs:
        xs = np.array([np.nanmax(np.abs(T["s"][m["win"][0]:m["win"][1]])) for m in metrics])
        ys = np.array([np.nanmax(np.abs(T["d"][m["win"][0]:m["win"][1]])) for m in metrics])
        cc = np.abs([m["cc"] for m in metrics])
        sc = ax3.scatter(xs, ys, c=cc, cmap="viridis", vmin=0, vmax=1, s=70, edgecolor="black", lw=0.6, zorder=3)
        cb = fig.colorbar(sc, ax=ax3, pad=0.01)
        cb.set_label("|CC|")
        import matplotlib.ticker as mticker
        ax3.set_xscale("log")
        ax3.set_yscale("log")
        x0, x1 = xs.min() / 3, xs.max() * 3
        y0, y1 = ys.min() / 3, ys.max() * 3
        ax3.set_xlim(x0, x1)
        ax3.set_ylim(y0, y1)
        for c in (100, 300, 1000, 3000, 10000):
            k_ = T["s_si"] / (c * T["d_si"])
            ax3.plot([x0, x1], [x0 * k_, x1 * k_], color="0.6", lw=0.9, ls="--", zorder=1)
            xl = min(x1, y1 / k_) / 1.35
            if xl * k_ > y0 and xl > x0:
                ax3.text(xl, xl * k_, f"{c:g} m/s", rotation=0, ha="right", va="bottom",
                         fontsize=FONT_TICK - 2, color="0.35", bbox=dict(fc="white", ec="none", pad=0.5, alpha=0.8))
        for axis in (ax3.xaxis, ax3.yaxis):
            axis.set_major_locator(mticker.LogLocator(base=10, subs=(1.0, 2.0, 5.0)))
            axis.set_major_formatter(mticker.FuncFormatter(lambda v, _: f"{v:g}"))
            axis.set_minor_formatter(mticker.NullFormatter())
        for k, (i, j, _) in enumerate(pairs):
            if len(pairs) <= LABEL_EVENTS_MAX:
                ax3.annotate(ev_d[i]["id"], (xs[k], ys[k]), xytext=(5, 4), textcoords="offset points",
                             fontsize=FONT_TICK - 3)
        med = f", median c ≈ {S['c_app_med']:.0f} m/s" if np.isfinite(S["c_app_med"]) else ""
        ax3.set_title(f"(c) Peak amplitudes{med}", loc="left")
    else:
        ax3.text(0.5, 0.5, "no common events", ha="center", va="center", transform=ax3.transAxes)
        ax3.set_title("(c) Peak amplitudes", loc="left")
    ax3.set_xlabel(f"Seismometer peak {T['s_name']} ({T['s_unit']})")
    ax3.set_ylabel(f"DAS peak {T['d_name']} ({T['d_unit']})")
    fig.suptitle(f"Detection summary — {info['das_name']} ch {info['ref']} vs {info['sid']}, "
                 f"{utc_text(info['t_a'])} – {utc_text(info['t_b'], '%H:%M:%S')} UTC",
                 fontsize=FONT_SUBTITLE + 2, fontweight="bold")
    return save_figure(fig, base)


def utc_ms(t):
    t = round(float(t), 3)
    return f"{utc_text(math.floor(t))}.{int(round((t - math.floor(t)) * 1000)) % 1000:03d}"


def report(ev_d, ev_s, pairs, metrics, S, T, info):
    L = ["STA/LTA event detection report", ""]
    L.append(f"window          : {utc_text(info['t_a'])} – {utc_text(info['t_b'])} UTC")
    L.append(f"DAS             : {info['das_desc']}")
    L.append(f"                  ch {info['ref']} ({info['ref_dist']:.1f} m), {T['d_name']} ({T['d_unit']})")
    L.append(f"seismometer     : {info['sid']} {T['comp']}, {T['s_name']} ({T['s_unit']}), "
             f"time shift applied {SEIS_TIME_SHIFT_SEC:+g} s")
    L.append(f"band            : {T['band'][0]:g}–{T['band'][1]:g} Hz, {COMMON_FS_HZ:g} Hz sampling")
    L.append(f"STA/LTA         : STA {STA_SEC:g} s, LTA {LTA_SEC:g} s, trigger on {TRIGGER_ON:g}, off {TRIGGER_OFF:g}, "
