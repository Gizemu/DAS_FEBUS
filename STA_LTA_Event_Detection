    L.append(f"matching        : onsets within ±{MATCH_TOL_SEC:g} s")
    L.append(f"coverage        : DAS {100 * info['cov_d']:.1f} %, seismometer {100 * info['cov_s']:.1f} %")
    L.append("")
    L.append(f"DAS events               : {S['n_d']}")
    L.append(f"seismometer events       : {S['n_s']}")
    L.append(f"common (TP)              : {S['n_c']}")
    L.append(f"DAS only (FP vs seis)    : {S['n_d_only']}  ({S['far_per_h']:.2f} per hour)")
    L.append(f"seismometer only (FN)    : {S['n_s_only']}")
    L.append(f"P_D = TP/(TP+FN)         : {S['pd_txt']}  (Wilson 95 %)")
    L.append(f"precision = TP/(TP+FP)   : {S['prec_txt']}  (Wilson 95 %)")
