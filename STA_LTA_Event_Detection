    fmt.zero_formats = ["", "%Y", "%b", "%b-%d", "%H:%M", "%H:%M:%S"]
    fmt.offset_formats = ["", "%Y", "%Y-%b", "%Y-%m-%d UTC", "%Y-%m-%d UTC", "%Y-%m-%d UTC"]
    ax.xaxis.set_major_formatter(fmt)
    ax.xaxis.set_minor_locator(mdates.AutoDateLocator(tz=UTC, minticks=30, maxticks=80))


