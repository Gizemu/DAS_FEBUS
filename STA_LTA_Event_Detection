        L.append(f"waveform |CC|            : median {S['cc_med']:.2f} "
                 f"(DAS {T['d_name']} vs seis {T['s_name']})")
    if S["cc_lag_n"]:
        L.append(f"time offset from CC      : median {S['cc_lag_med'] * 1000:+.0f} ms "
                 f"(DAS − seis) over {S['cc_lag_n']} events "
                 f"with |CC| ≥ {CC_MIN_FOR_CLOCK:g}")
    if np.isfinite(S["c_app_med"]):
        L.append(f"peak amplitude ratio    : median {S['c_app_med']:.0f} m/s")
        L.append("    (peak seismic acceleration divided by peak DAS strain rate; "
                 "NOT an independent wave velocity estimate)")
    L.append("")
    L.append(f"f-k velocity reference      : {FK_APPARENT_VELOCITY_MPS:g} m/s (assumed constant for plots)")
    L.append(f"f-k indicative range       : {FK_VELOCITY_RANGE_MPS[0]:g}–{FK_VELOCITY_RANGE_MPS[1]:g} m/s")
    L.append(f"f-k reference              : {FK_VELOCITY_SOURCE}")
    L.append("DAS estimated acceleration : a[mm/s^2] = c_app[m/s] × DAS_strain_rate[nstrain/s] × 1e-6")
    L.append("Interpretation             : one-dimensional wave proxy, not directly measured acceleration; "
             "geometry, coupling, dispersion and 3D wave motion can change the amplitudes")
    L.append("")
    L.append("common events")
    L.append("  ID   DAS onset (UTC)          seis onset (UTC)          lag (ms)  STA/LTA DAS  seis   "
             "SNRexc DAS   seis      CC   CC lag (ms)  c (m/s)")
    for (i, j, dt), m in zip(pairs, metrics):
        e, f = ev_d[i], ev_s[j]
        L.append(f"  {e['id']}  {utc_ms(e['t_on'])}  {utc_ms(f['t_on'])}  {dt * 1000:+8.0f}  {e['peak_ratio']:11.1f}  "
                 f"{f['peak_ratio']:5.1f}  {e['snr_excess_db']:7.1f} dB {f['snr_excess_db']:5.1f} dB  "
                 f"{m['cc']:+5.2f}  {m['cc_lag'] * 1000:+10.0f}  {m['c_app']:7.0f}")
    probs = []
    if S["n_s"] == 0:
        probs.append("no seismometer events: P_D cannot be evaluated (lower TRIGGER_ON or check the window)")
    if S["n_d"] == 0:
        probs.append("no DAS events: check the DAS data or lower TRIGGER_ON")
    tol = max(0.02, 2.0 / COMMON_FS_HZ)
    if S["cc_lag_n"] >= 3 and abs(S["cc_lag_med"]) > tol:
        probs.append(f"waveform cross-correlation gives a time offset of {S['cc_lag_med'] * 1000:+.0f} ms "
                     f"(DAS − seis, {S['cc_lag_n']} events): set SEIS_TIME_SHIFT_SEC = "
                     f"{SEIS_TIME_SHIFT_SEC + S['cc_lag_med']:+.3f} to align the instruments")
    elif S["cc_lag_n"] < 3 and "lag_med" in S and abs(S["lag_med"]) > 0.2:
        probs.append(f"median onset lag {S['lag_med'] * 1000:+.0f} ms: consistent with a clock offset; "
                     f"set SEIS_TIME_SHIFT_SEC = {SEIS_TIME_SHIFT_SEC + S['lag_med']:+.3f} to align the instruments "
                     f"(onset lags are biased towards the later-triggering sensor; too few well-correlated events "
                     f"for a cross-correlation estimate)")
    if info["cov_d"] < 0.95 or info["cov_s"] < 0.95:
        probs.append("data gaps in the window (STA/LTA is set to 0 for one LTA length after each gap)")
    if T["band"][1] < BAND_HZ[1]:
        probs.append(f"band capped at {T['band'][1]:g} Hz by the sampling rate (BAND_HZ = {BAND_HZ[1]:g} Hz)")
    if info.get("orientation_note"):
        probs.append(info["orientation_note"])
    L.append("")
    L.append("status: " + ("OK" if not probs else f"{len(probs)} point(s) to check"))
    for p in probs:
        L.append(f"  - {p}")
    return "\n".join(L)


def write_events_csv(path, ev_d, ev_s, T):
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("id,sensor,onset_utc,offset_utc,duration_s,match,peak_sta_lta,peak_amplitude,unit,snr_total,"
                 "snr_excess_db\n")
        rows = [("DAS", e, T["d_unit"]) for e in ev_d] + [("seismometer", e, T["s_unit"]) for e in ev_s]
        for name, e, unit in sorted(rows, key=lambda r: r[1]["t_on"]):
            fh.write(f"{e['id']},{name},{utc_ms(e['t_on'])},{utc_ms(e['t_off'])},{e['dur']:.3f},{e['match']},"
                     f"{e['peak_ratio']:.3f},{e['peak_amp']:.6g},{unit},{e['snr_total']:.4g},"
                     f"{e['snr_excess_db']:.2f}\n")


def next_number(folder, prefix):
    n = 0
    for p in glob.glob(os.path.join(folder, f"{prefix}_*")):
        m = re.fullmatch(re.escape(prefix) + r"_(\d{3,})(?:_[a-z0-9]+)*\.(?:png|pdf|svg|jpe?g|csv|txt)",
                         os.path.basename(p))
        if m:
            n = max(n, int(m.group(1)))
    return f"{n + 1:03d}"


def main(argv=None):
    global START_TIME, END_TIME, DAS_REF_CHANNEL, DAS_REF_DISTANCE_M, TRIGGER_ON, TRIGGER_OFF, STA_SEC, \
        LTA_SEC, SEIS_TIME_SHIFT_SEC, DAS_FOLDER, OUTPUT_FOLDER, FK_APPARENT_VELOCITY_MPS
    ap = argparse.ArgumentParser(description="STA/LTA event detection: DAS (Febus/Sintela) vs seismometer")
    ap.add_argument("--start")
    ap.add_argument("--end")
    ap.add_argument("--ref-channel", type=int)
    ap.add_argument("--ref-distance", type=float, help="optical distance (m) instead of a channel index")
    ap.add_argument("--das-folder")
    ap.add_argument("--output")
    ap.add_argument("--on", type=float)
    ap.add_argument("--off", type=float)
    ap.add_argument("--sta", type=float)
    ap.add_argument("--lta", type=float)
    ap.add_argument("--seis-shift", type=float)
    ap.add_argument("--fk-velocity", type=float, help="assumed f-k apparent velocity (m/s) used to estimate DAS acceleration")
    a = ap.parse_args(argv)
    START_TIME = a.start or START_TIME
    END_TIME = a.end or END_TIME
    DAS_REF_CHANNEL = a.ref_channel if a.ref_channel is not None else DAS_REF_CHANNEL
    DAS_REF_DISTANCE_M = a.ref_distance if a.ref_distance is not None else DAS_REF_DISTANCE_M
    DAS_FOLDER = a.das_folder or DAS_FOLDER
    OUTPUT_FOLDER = a.output or OUTPUT_FOLDER
    TRIGGER_ON = a.on or TRIGGER_ON
    TRIGGER_OFF = a.off or TRIGGER_OFF
    STA_SEC = a.sta or STA_SEC
    LTA_SEC = a.lta or LTA_SEC
    SEIS_TIME_SHIFT_SEC = a.seis_shift if a.seis_shift is not None else SEIS_TIME_SHIFT_SEC
    FK_APPARENT_VELOCITY_MPS = a.fk_velocity if a.fk_velocity is not None else FK_APPARENT_VELOCITY_MPS
    if TRIGGER_OFF >= TRIGGER_ON:
        raise StopRun("TRIGGER_OFF must be lower than TRIGGER_ON")

    win = configured_window()
    log(f"\nSTA/LTA: DAS {'distance ' + format(DAS_REF_DISTANCE_M, 'g') + ' m' if DAS_REF_DISTANCE_M is not None else 'ch ' + str(DAS_REF_CHANNEL)}"
        f" vs {SEIS_STATION}, window " + ("auto" if win is None else f"{utc_text(win[0])} - {utc_text(win[1])} UTC"))
    log("\nseismometer")
    inv = load_inventory()
    sel = scan_seismic(win)
    log("\ntime window")
    t_a, t_b = choose_window(sel, win)
    log("\nseismometer data")
    import contextlib
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        enz, sid, coords_xml, comp_info = load_seismic(t_a, t_b, inv, sel)
    text = buf.getvalue()
    print(text, end="")
    orientation_note = ("seismometer orientation from the SEED channel convention (StationXML azimuth/dip are "
                        "placeholders)") if "placeholders" in text else None
    log("\nDAS")
    das, L0, ref = load_das(t_a, t_b)
    log("\nfibre geometry")
    coords, coord_src = station_location(coords_xml)
    geo = fibre_geometry(np.array([ref]), L0["dx"], coords, coord_src)

    log("\nSTA/LTA")
    raw_first = np.flatnonzero(np.isfinite(das[:, 0]))
    if len(raw_first):
        log(f"  DAS input first valid sample: {utc_text(t_a + raw_first[0] / COMMON_FS_HZ)} UTC "
            f"({raw_first[0] / COMMON_FS_HZ:.3f} s after window start)")
    band = effective_band([L0["fs"], sel.get("fs")])
    T = prepare_traces(das, enz, geo, 0, band)
    first_d = np.flatnonzero(np.isfinite(T["d"]))
    first_s = np.flatnonzero(np.isfinite(T["s"]))
    if len(first_d):
        log(f"  DAS first valid plotted sample: {utc_text(t_a + first_d[0] / COMMON_FS_HZ)} UTC "
            f"({first_d[0] / COMMON_FS_HZ:.3f} s after window start)")
    if len(first_s):
        log(f"  seismic first valid plotted sample: {utc_text(t_a + first_s[0] / COMMON_FS_HZ)} UTC "
            f"({first_s[0] / COMMON_FS_HZ:.3f} s after window start)")
    T_acc = make_equivalent_acceleration(T)
    log(f"  estimated DAS acceleration: c_app = {FK_APPARENT_VELOCITY_MPS:g} m/s from the displayed f-k ridge")
    log(f"  indicative tracked ridge range: {FK_VELOCITY_RANGE_MPS[0]:g}-{FK_VELOCITY_RANGE_MPS[1]:g} m/s")
    if "no fibre azimuth" in T["comp"]:
        log("  ! seismic E component is not a verified fibre-axial projection: amplitudes are illustrative only")
    R_d, R_s = sta_lta(T["d"]), sta_lta(T["s"])
    ev_d, ev_s = detect(R_d, T["d"], t_a), detect(R_s, T["s"], t_a)
    pairs = match(ev_d, ev_s)
    metrics = [pair_metrics(T, ev_d[i], ev_s[j]) for i, j, _ in pairs]
    S = stats(ev_d, ev_s, pairs, metrics, (t_b - t_a) / 3600.0)
    das_name = {"febus": "Febus DAS", "sintela": "Sintela DAS"}[L0["format"]]
    das_desc = f"{das_name}, {os.path.basename(L0['path'])}"
    if L0["format"] == "febus":
        das_desc += f" ({L0['febus']['zone'].strip('/')}/{L0['dataset'].rsplit('/', 1)[-1]})"
    das_desc += f", {L0['fs']:g} Hz, GL {L0['gauge']} m, dx {L0['dx']:.4g} m"
    info = dict(t_a=t_a, t_b=t_b, ref=ref, ref_dist=L0["dist0"] + ref * L0["dx"], sid=sid, stats=S,
                orientation_note=orientation_note, das_name=das_name, das_desc=das_desc,
                cov_d=float(np.isfinite(T["d"]).mean()), cov_s=float(np.isfinite(T["s"]).mean()))

    os.makedirs(OUTPUT_FOLDER, exist_ok=True)
    prefix = (f"STALTA_{L0['format'].capitalize()}_{SEIS_STATION}_ch{ref}_{utc_text(t_a, '%Y%m%d_%H%M%S')}_"
              f"{int(round((t_b - t_a) / 60))}min")
    num = next_number(OUTPUT_FOLDER, prefix)
    base = os.path.join(OUTPUT_FOLDER, f"{prefix}_{num}")
    log("\nfigures")
    plot_style()
    figs = fig_gallery(T, ev_d, ev_s, pairs, metrics, info, base + "_gallery_original")
    figs += fig_overview(T, R_d, R_s, ev_d, ev_s, info, base + "_overview_original")
    figs += fig_gallery(T_acc, ev_d, ev_s, pairs, metrics, info, base + "_gallery_mmps2", equivalent=True)
    figs += fig_overview(T_acc, R_d, R_s, ev_d, ev_s, info, base + "_overview_mmps2", equivalent=True)
    rep = report(ev_d, ev_s, pairs, metrics, S, T, info)
    rpt = base + "_report.txt"
    with open(rpt, "w", encoding="utf-8") as fh:
        fh.write(rep + "\n")
    csv = base + "_events.csv"
    write_events_csv(csv, ev_d, ev_s, T)
    log("\n" + rep)
    log("\nsaved:\n" + "\n".join(f"  {p}" for p in figs + [rpt, csv]))
    return dict(ev_d=ev_d, ev_s=ev_s, pairs=pairs, metrics=metrics, stats=S, T=T, T_acc=T_acc,
                R_d=R_d, R_s=R_s, info=info, figures=figs, report=rpt, csv=csv, layout=L0)


if __name__ == "__main__":
    try:
        main()
    except StopRun as e:
        log(f"\nSTOP: {e}")
        raise SystemExit(1)
