class Progress:

    def __init__(self, label, n, every=10.0):
        self.label, self.n, self.every = label, int(n), float(every)
        self.t0 = self.t_last = _time.time()

    def step(self, i, extra=""):
        now = _time.time()
        done = i + 1
        if now - self.t_last >= self.every or done == self.n:
            el = now - self.t0
            eta = el / done * (self.n - done) if done else 0.0
            print(f"  .. {self.label} {done}/{self.n}  ({el:.0f} s elapsed, ~{eta:.0f} s left)"
                  f"{'  ' + extra if extra else ''}", flush=True)
            self.t_last = now


