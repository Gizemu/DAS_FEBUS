def settings_from(g: dict, description: str = "") -> Config:
    ap = argparse.ArgumentParser(description=description)
    ap.add_argument("--start", help="override START_TIME, e.g. '2025-07-18 17:00:00'")
    ap.add_argument("--end", help="override END_TIME")
    ap.add_argument("--rebuild", action="store_true", help="rebuild the timeline cache")
    a, _ = ap.parse_known_args()
    missing = [k for k in _REQUIRED if g.get(k) in (None, "")]
    if missing:
        raise SystemExit(f"set {', '.join(missing)} at the top of the script")
    kw = {}
    for name, (key, default) in _SHARED.items():
        kw[key] = g.get(name, default)
    kw["start_utc"] = str(a.start or kw["start_utc"]).strip().replace(" ", "T")
    kw["end_utc"] = str(a.end or kw["end_utc"]).strip().replace(" ", "T")
    try:
        t0, t1 = UTCDateTime(kw["start_utc"]), UTCDateTime(kw["end_utc"])
    except Exception as exc:
        raise SystemExit(f"cannot read START_TIME / END_TIME: {exc}")
    if t1 <= t0:
        raise SystemExit(f"END_TIME {t1} is not after START_TIME {t0}")
    kw["rebuild_cache"] = bool(kw["rebuild_cache"] or a.rebuild)
    ch = kw["das_channels"]
    kw["das_channels"] = [int(c) for c in ch] if isinstance(ch, (list, tuple)) else [int(ch)]
    if kw["gauge_length"] is None:
        kw["gauge_length"] = float("nan")
    kw["pre_filt"] = list(kw["pre_filt"]) if kw["pre_filt"] else None
    sta = str(kw["seis_station"] or str(kw["seis_select"]).split(".")[1]).upper()
    kw["seis_station"] = sta
    resp = kw["inventory"]
    kw["inventory"] = {sta: resp} if resp else "auto"
    kw["fig_width"], kw["fig_height"] = (float(v) for v in kw["fig_size"])
    kw["cache_dir"] = kw["cache_dir"] or kw["outdir"]
    kw.update(das_net_code="DA", seis_station_dirs={}, seis_component=None,
              component_azimuth_tolerance_deg=35.0, seis_remove_response=True,
              fs_target=None, obliquity=1.0, gauge_correct=False, gauge_water=0.2,
              acc_db_range=None, vel_db_range=None)
    os.makedirs(kw["outdir"], exist_ok=True)
    os.makedirs(kw["cache_dir"], exist_ok=True)
    return Config(**kw)


def fallback_gauge_length(cfg, value):
    if np.isfinite(value) and value > 0:
        return float(value)
    if cfg.gauge_length and np.isfinite(cfg.gauge_length):
        return float(cfg.gauge_length)
    raise SystemExit("the DAS files have no GaugeLength: set GAUGE_LENGTH_M")


from scipy import stats as _stats


def rms_series(tl, cfg, quantity):
    if tl["seis_units"] not in ("VEL", "ACC", "DISP"):
        raise SystemExit("the seismometer is in COUNTS (no response removed): amplitudes cannot "
                         "be compared. Check RESPONSE_FILE.")
    _dp, _sp, d, s = timeline_envelopes(tl, cfg, quantity)
    return d, s


def coverage_text(cfg, tl, d, s):
    g = tl["grid"]
    t0, t1 = window_of(cfg)
    sta = tl["seed_id"].split(".")[1]
    return (f"{t0.strftime('%Y-%m-%d %H:%M')} - {t1.strftime('%H:%M' if t1 - t0 < 86400 else '%m-%d %H:%M')} UTC"
            f"  |  coverage: DAS {int(np.isfinite(d).sum())}/{g.n_bins}; {sta} "
            f"{int(np.isfinite(s).sum())}/{g.n_bins} bins")


def amplitude_agreement(d, s):
    ok = np.isfinite(d) & np.isfinite(s) & (d > 0) & (s > 0)
    out = dict(n=int(ok.sum()), r_log=np.nan, r_lin=np.nan, ratio=np.nan,
               slope=np.nan, intercept=np.nan, slope_lo=np.nan, slope_hi=np.nan)
    if ok.sum() < 5:
        return out
    x, y = np.log10(s[ok]), np.log10(d[ok])
    out["r_log"] = float(np.corrcoef(x, y)[0, 1])
    out["r_lin"] = float(np.corrcoef(s[ok], d[ok])[0, 1])
    out["ratio"] = float(np.median(d[ok] / s[ok]))
    if np.subtract(*np.percentile(x, [90, 10])) >= 0.3:
        b, a, lo, hi = _stats.theilslopes(y, x, method="joint")
        out.update(slope=float(b), intercept=float(a), slope_lo=float(lo), slope_hi=float(hi))
    return out


def save_figure(fig, cfg, suffix):
    stem, _ = out_path(cfg, suffix)
    fig.savefig(stem + ".png", dpi=cfg.dpi, bbox_inches="tight")
    plt.close(fig)
    print(f"  wrote {stem}.png", flush=True)
    return stem


def main():
    cfg = settings_from(globals(), __doc__)
    banner("Sintela DAS vs seismometer: RMS scatter", cfg,
             {"DAS channel": cfg.das_channels[0], "seismometer": cfg.seis_select, "quantity": cfg.quantity})
    tl = build_timeline(cfg, cfg.use_cache, cfg.rebuild_cache)
    d, s = rms_series(tl, cfg, cfg.quantity)
    agr = amplitude_agreement(d, s)
    sc, unit, k = (1e3, "mm/s$^2$", 3) if cfg.quantity == "ACC" else (1e6, r"$\mu$m/s", 6)
    name = "acceleration" if cfg.quantity == "ACC" else "velocity"
    g = tl["grid"]
    ok = np.isfinite(d) & np.isfinite(s) & (d > 0) & (s > 0)
    hours = (np.arange(g.n_bins) + 0.5) * cfg.bin_s / 3600.0
    fig, ax = plt.subplots(figsize=(cfg.fig_width, cfg.fig_height))
    pts = ax.scatter(s[ok] * sc, d[ok] * sc, c=hours[ok], s=10, cmap="viridis", alpha=0.85, lw=0)
    v = np.concatenate([s[ok], d[ok]]) * sc
    lim = (10 ** np.floor(np.log10(v.min())), 10 ** np.ceil(np.log10(v.max())))
    xx = np.array(lim)
    ax.plot(xx, xx, "k--", lw=1, label="1:1")
    if np.isfinite(agr["slope"]):
        yy = 10 ** (agr["intercept"] + agr["slope"] * (np.log10(xx) - k) + k)
        ax.plot(xx, yy, color="tab:orange", lw=1.4,
                label=f"Theil-Sen slope {agr['slope']:.2f} [{agr['slope_lo']:.2f}, {agr['slope_hi']:.2f}]")
    ax.set_xscale("log")
    ax.set_yscale("log")
    ax.set_xlim(lim)
    ax.set_ylim(lim)
    ax.set_aspect("equal", adjustable="box")
    ax.set_xlabel(f"{tl['seed_id']} RMS {name} [{unit}]")
    ax.set_ylabel(f"DAS ch{cfg.das_channels[0]} RMS {name} [{unit}]")
    ax.grid(alpha=0.3, which="both")
    ax.legend(fontsize=8, loc="lower right")
    ax.text(0.03, 0.97, f"n = {agr['n']} bins\nPearson r (log) = {agr['r_log']:.2f}\n"
                        f"Pearson r (linear) = {agr['r_lin']:.2f}\nmedian DAS/seis = {agr['ratio']:.2f}",
            transform=ax.transAxes, va="top", fontsize=9, bbox=dict(fc="w", ec="0.7", alpha=0.9, pad=3))
    cb = fig.colorbar(pts, ax=ax, fraction=0.046, pad=0.03)
    cb.set_label("hours from 17:00 UTC Time", fontsize=12)
    ax.set_title(f"{cfg.env_fmin:g}-{cfg.env_fmax:g} Hz, "
                 f"{cfg.bin_s:g} s bins, c_app {cfg.c_app:g} m/s\n{coverage_text(cfg, tl, d, s)}", fontsize=9)
    save_figure(fig, cfg, f"rms_scatter_{cfg.quantity.lower()}")
    print(f"  Pearson r = {agr['r_log']:.2f} (log), {agr['r_lin']:.2f} (linear); median DAS/seis "
          f"{agr['ratio']:.3f}; Theil-Sen slope {agr['slope']:.3f} [{agr['slope_lo']:.3f}, {agr['slope_hi']:.3f}], "
          f"fit DAS/seis at the median amplitude {10 ** (agr['intercept'] + (agr['slope'] - 1) * np.nanmedian(np.log10(s[ok]))):.3f}")


if __name__ == "__main__":
    main()
