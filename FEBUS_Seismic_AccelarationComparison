def trace_data(tr) -> np.ndarray:
    if np.ma.isMaskedArray(tr.data):
        return np.ma.filled(tr.data.astype(np.float64), np.nan)
    return np.asarray(tr.data, dtype=np.float64)


LAMBDA_VAC = 1550.12e-9
N_EFF = 1.4682
XI = 0.78063422216


def phase_to_strain_factor(gauge_length: float) -> float:
    return LAMBDA_VAC / (4.0 * np.pi * float(gauge_length) * N_EFF * XI)


_TS_RE = re.compile(
    r"(\d{4})[-_]?(\d{2})[-_]?(\d{2})[T_ ](\d{2})[.:_-]?(\d{2})[.:_-]?(\d{2})")


def das_filename_time(path):
    m = _TS_RE.search(os.path.basename(path))
    if not m:
        return None
    try:
        return UTCDateTime(*(int(v) for v in m.groups()))
    except Exception:
        return None


def _epoch_to_utc(v):
    v = float(v)
    av = abs(v)
    if av > 1e17:
        v /= 1e9
    elif av > 1e14:
        v /= 1e6
    elif av > 1e11:
        v /= 1e3
    return UTCDateTime(v)


def _value_to_utc(v):
    if v is None:
        return None
    if isinstance(v, np.ndarray):
        if v.size == 0:
            return None
        v = np.ravel(v)[0]
    if isinstance(v, bytes):
        v = v.decode("utf-8", errors="ignore")
    if isinstance(v, str):
        text = v.strip()
        if not text:
            return None
        try:
            dt = datetime.fromisoformat(text.replace("Z", "+00:00"))
            if dt.tzinfo is None:
                dt = dt.replace(tzinfo=timezone.utc)
            return UTCDateTime(dt.astimezone(timezone.utc))
        except ValueError:
            try:
                return _epoch_to_utc(float(text))
            except Exception:
                return None
    try:
        return _epoch_to_utc(float(v))
    except Exception:
        return None


def _h5_attr_num(obj, *names, default=None):
    if obj is None:
        return default
    for n in names:
        if n in obj.attrs:
            v = obj.attrs[n]
            try:
                if isinstance(v, bytes):
                    v = v.decode("utf-8", errors="ignore")
                if isinstance(v, np.ndarray):
                    v = np.ravel(v)[0]
                return float(v)
            except Exception:
                continue
    return default


def _h5_attr_time(obj, *names):
    if obj is None:
        return None
    for n in names:
        if n in obj.attrs:
            t = _value_to_utc(obj.attrs[n])
            if t is not None:
                return t
    return None


def read_sintela_h5(path, first=0, last=None, header_only=False):
    with h5py.File(path, "r") as h5:
        dset = tset = None
        acq = h5.get("Acquisition")
        if acq is not None:
            for key in acq.keys():
                if key.startswith("Raw"):
                    raw = acq[key]
                    if "RawData" in raw:
                        dset, tset = raw["RawData"], raw.get("RawDataTime")
                    break
        if dset is None and "data" in h5:
            dset = h5["data"]
        if dset is None:
            cands = []
            h5.visititems(lambda n, o: cands.append((n, o))
                          if isinstance(o, h5py.Dataset) and o.ndim == 2 else None)
            if not cands:
                raise RuntimeError(f"no 2-D dataset in {path}")
            _, dset = max(cands, key=lambda kv: kv[1].size)

        dx = (_h5_attr_num(acq, "SpatialSamplingInterval", "dx") or
              _h5_attr_num(h5, "SpatialSamplingInterval", "dx", "channel_spacing"))
        gl = _h5_attr_num(acq, "GaugeLength", default=np.nan)
        fs = None
        for src in (dset.parent, acq, h5):
            fs = fs or _h5_attr_num(src, "OutputDataRate", "PulseRate", "fs",
                                    "SamplingFrequency")
        dt_attr = _h5_attr_num(h5, "dt")
        if fs is None and dt_attr:
            fs = 1.0 / dt_attr

        n0, n1 = dset.shape
        n_loci_attr = _h5_attr_num(acq, "NumberOfLoci")
        if n_loci_attr and int(n_loci_attr) in (n0, n1):
            time_first = (n1 == int(n_loci_attr))
        else:
            time_first = n0 >= n1
        nx_total = n1 if time_first else n0
        last = nx_total if last is None else min(int(last), nx_total)
        first = max(0, int(first))
        if header_only:
            data = None
        else:
            data = dset[:, first:last] if time_first else dset[first:last, :].T
            data = np.asarray(data, np.float32)

        t0 = None
        if tset is not None:
            if isinstance(tset, h5py.Dataset) and tset.size >= 2:
                try:
                    tt = np.asarray(tset[:2]).astype("float64")
                    t0 = _epoch_to_utc(tt[0])
                    step = _epoch_to_utc(tt[1]) - t0
                    if step > 0:
                        fs = 1.0 / step
                except Exception:
                    pass
            if t0 is None:
                t0 = _h5_attr_time(tset, "StartTime", "PartStartTime")
        if t0 is None:
            t0 = _h5_attr_time(dset, "PartStartTime", "StartTime")
        if t0 is None:
            t0 = _h5_attr_time(dset.parent, "PartStartTime", "StartTime")
        if t0 is None:
            t0 = _h5_attr_time(acq, "MeasurementStartTime")
        if t0 is None:
            t0 = das_filename_time(path)
        if t0 is None:
            raise RuntimeError(f"no DAS start time in metadata or filename: {path}")

    if fs is None or dx is None:
        raise RuntimeError(f"missing sampling rate or dx in {path}")
    return data, float(fs), float(dx), t0, float(gl), int(nx_total)


def das_file_index(cfg):
    paths = sorted(_glob.glob(os.path.join(cfg.das_dir, cfg.das_pattern)))
    if not paths:
        paths = sorted(_glob.glob(os.path.join(cfg.das_dir, "**", cfg.das_pattern),
                                  recursive=True))
    paths = [p for p in paths if not os.path.basename(p).startswith("._")]
    rows = [(das_filename_time(p), p) for p in paths]
    stamped = sorted([r for r in rows if r[0] is not None], key=lambda r: r[0])
    return stamped + [r for r in rows if r[0] is None]


def das_coverage(cfg) -> dict:
    rows = das_file_index(cfg)
    stamped = [(t, p) for t, p in rows if t is not None]
    out = dict(n_files=len(rows), start=None, end=None, gaps=[], nominal_s=60.0)
    if not stamped:
        return out
    if len(stamped) > 1:
        d = np.array([stamped[i + 1][0] - stamped[i][0]
                      for i in range(len(stamped) - 1)])
        out["nominal_s"] = float(np.median(d))
        for i, gap in enumerate(d):
            if gap > 1.5 * out["nominal_s"]:
                out["gaps"].append((stamped[i][0] + out["nominal_s"],
                                    stamped[i + 1][0]))
    out["start"] = stamped[0][0]
    out["end"] = stamped[-1][0] + out["nominal_s"]
    return out


def das_files_in_window(cfg):
    rows = das_file_index(cfg)
    if not rows:
        raise SystemExit(f"no DAS files matching {cfg.das_pattern!r} in "
                         f"{cfg.das_dir!r}")
    t0, t1 = window_of(cfg)
    if t0 is None:
        return [p for _t, p in rows]
    stamped = [(t, p) for t, p in rows if t is not None]
    if not stamped:
        print("  ! no DAS filename carries a UTC stamp; every file is opened")
        return [p for _t, p in rows]
    keep, prev = [], None
    for t, p in stamped:
        if t < t0:
            prev = p
            continue
        if t >= t1:
            break
        keep.append(p)
    if prev is not None:
        keep.insert(0, prev)
    if not keep:
        cov = das_coverage(cfg)
        raise SystemExit(
            f"no DAS file falls in {t0} -> {t1}.\n"
            f"The DAS directory spans {cov['start']} -> {cov['end']}. "
            f"Change START_TIME / END_TIME.")
    return keep


class StreamDecimator:

    def __init__(self, k: int, fs_in: float, taps_per_k: int = 20):
        self.k = int(k)
        self.fs_in = float(fs_in)
        self.fs_out = self.fs_in / self.k
        self.ntaps = int(taps_per_k * self.k) | 1
        self.h = signal.firwin(self.ntaps, 1.0 / self.k, window=("kaiser", 5.0))
        self.D = (self.ntaps - 1) // 2
        self.reset()

    def reset(self) -> None:
        self.pend = None
        self.base = 0
        self.t_origin = None

    def push(self, x: np.ndarray, t0):
        x = np.asarray(x, dtype=np.float64)
        if self.t_origin is None:
            self.t_origin = UTCDateTime(t0)
            pad = np.repeat(x[:1], self.D, axis=0)
            avail = np.concatenate([pad, x], axis=0)
            self.base = -self.D
        else:
            avail = np.concatenate([self.pend, x], axis=0)
        n_valid = avail.shape[0] - self.ntaps + 1
        if n_valid <= 0:
            self.pend = avail
            return None, None
        h = self.h.reshape((-1,) + (1,) * (avail.ndim - 1))
        y = signal.fftconvolve(avail, h, mode="valid", axes=0)
        c0 = self.base + self.D
        i0 = int((-c0) % self.k)
        out = y[i0::self.k]
        m0 = (c0 + i0) // self.k
        t_out = self.t_origin + (m0 * self.k) / self.fs_in
        self.base += n_valid
        self.pend = avail[n_valid:]
        if out.shape[0] == 0:
            return None, None
        return out, t_out


def das_decimation_factor(fs_in: float, fs_out) -> int | None:
    if not fs_out or fs_out >= fs_in * (1 - 1e-9):
        return None
    k = int(round(fs_in / fs_out))
    if k < 2:
        return None
    if abs(fs_in / k - fs_out) / fs_out > 0.02:
        print(f"  NOTE: {fs_in:g} Hz is not an integer multiple of {fs_out:g} Hz;"
              f" decimating by {k} to {fs_in / k:g} Hz instead")
    return k


def das_raw_to_strain(x: np.ndarray, cfg, gauge_length: float) -> np.ndarray:
    x = np.asarray(x, dtype=np.float64) * float(cfg.das_raw_scale)
    u = str(cfg.das_raw_units).lower()
    if u == "phase":
        return x * phase_to_strain_factor(gauge_length)
    if u == "strain":
        return x
    raise SystemExit(f"das_raw_units={cfg.das_raw_units!r} is not supported "
                     f"(use 'phase' or 'strain')")


def stream_das_blocks(cfg, channels=None, fs_read=None, verbose=True):
    files = das_files_in_window(cfg)
    chs = sorted({int(c) for c in (channels if channels is not None
                                   else cfg.das_channels)})
    if not chs:
        raise SystemExit("no DAS channel selected (das_channels in CONFIG)")
    first, last = min(chs), max(chs) + 1
    t0w, t1w = window_of(cfg)
    dec = None
    meta = {}
    prev_end = None
    prog = Progress("DAS files", len(files))
    for i, path in enumerate(files):
        try:
            data, fs_f, dx_f, t_file, gl_f, nx = read_sintela_h5(path, first, last)
        except Exception as exc:
            print(f"  ! skip {os.path.basename(path)}: {exc}")
            continue
        if t0w is not None:
            nt = data.shape[0]
            i0 = max(0, int(round((t0w - t_file) * fs_f)))
            i1 = min(nt, int(round((t1w - t_file) * fs_f)))
            if i0 >= nt or i1 <= i0:
                continue
            data = data[i0:i1]
            t_file = t_file + i0 / fs_f
        cols = [c - first for c in chs if 0 <= c - first < data.shape[1]]
        if len(cols) != len(chs) or first < 0:
            raise SystemExit(
                f"DAS channel(s) {[c for c in chs if c < 0 or c >= nx]} "
                f"do not exist in {os.path.basename(path)} (the file has {nx} "
                f"loci, channels 0..{nx - 1}).")
        if not meta:
            gl = fallback_gauge_length(cfg, gl_f)
            meta = dict(fs_raw=float(fs_f), dx=float(cfg.dx or dx_f),
                        gauge_length=gl, channels=list(chs), n_loci=nx)
            k = das_decimation_factor(fs_f, fs_read)
            if k:
                dec = StreamDecimator(k, fs_f)
                meta["fs"] = dec.fs_out
                if verbose:
                    print(f"  DAS decimation : {fs_f:g} -> {dec.fs_out:g} Hz (k={k}, "
                          f"continuous across files)")
            else:
                meta["fs"] = float(fs_f)
        eps = das_raw_to_strain(data[:, cols], cfg, meta["gauge_length"])
        if prev_end is not None and abs(t_file - prev_end) > 1.5 / fs_f:
            if dec:
                dec.reset()
            if verbose:
                print(f"  DAS gap        : {prev_end} -> {t_file} "
                      f"({t_file - prev_end:.1f} s)")
        prev_end = t_file + eps.shape[0] / fs_f
        if dec is None:
            yield eps, t_file, meta["fs"], meta["channels"], meta
        else:
            y, t_out = dec.push(eps, t_file)
            if y is not None:
                yield y, t_out, meta["fs"], meta["channels"], meta
        if verbose:
            prog.step(i)
    if not meta:
        raise SystemExit("no usable DAS data in that window")


