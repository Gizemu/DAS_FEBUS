                    "format", "start", "end", "fs", "npts", "note"]


def parse_seis_filename(path):
    base = os.path.basename(path)
    for pat in _SEIS_FNAME:
        m = pat.search(base)
        if not m:
            continue
        g = m.groupdict()
        try:
            t = UTCDateTime(int(g["Y"]), int(g["M"]), int(g["D"]),
                            int(g["h"]), int(g["m"]), int(g["s"]))
        except Exception:
            continue
        if g.get("ms"):
            t += int(g["ms"]) / (10 ** len(g["ms"]))
        return t, g.get("net"), g.get("sta")
    return None, None, None


def _is_waveform_candidate(path):
    b = os.path.basename(path)
    if b.startswith(".") or b == _MANIFEST:
        return False
    stem = b[:-3] if b.lower().endswith(".gz") else b
    return os.path.splitext(stem.lower())[1] not in _NON_WAVEFORM_EXT


def read_any_waveform(path, assume=None):
    tmp, rp = None, path
    try:
        if path.lower().endswith(".gz"):
            fd, tmp = tempfile.mkstemp(prefix="seis_unzip_",
                                       suffix=os.path.splitext(path[:-3])[1] or ".raw")
            os.close(fd)
            with gzip.open(path, "rb") as src, open(tmp, "wb") as dst:
                shutil.copyfileobj(src, dst)
            rp = tmp
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            if assume:
                try:
                    return read(rp, format=assume), assume
                except Exception:
                    return None, None
            try:
                st = read(rp)
                return st, getattr(st[0].stats, "_format", "auto") if len(st) else "auto"
            except Exception:
                pass
            for fmt in _CANDIDATE_FORMATS:
                try:
                    st = read(rp, format=fmt)
                    if len(st):
                        return st, fmt
                except Exception:
                    continue
    except (OSError, EOFError):
        pass
    finally:
        if tmp and os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                pass
    return None, None


def _list_raw_files(station_dir, converted_subdir):
    out = []
    conv = os.path.abspath(os.path.join(station_dir, converted_subdir))
    for root, dirs, files in os.walk(station_dir):
        dirs[:] = [d for d in dirs if not d.startswith(".") and
                   not os.path.abspath(os.path.join(root, d)).startswith(conv)]
        for f in sorted(files):
            p = os.path.join(root, f)
            if _is_waveform_candidate(p):
                out.append(p)
    return out


