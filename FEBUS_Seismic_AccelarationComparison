            st, _fmt = read_any_waveform(by_sta[("", "")][0])
            code = (str(st[0].stats.station).upper(), str(st[0].stats.network).upper()) \
                if st is not None and len(st) else (os.path.basename(d).upper(), "")
            by_sta.setdefault(code, []).extend(by_sta.pop(("", "")))
        conv_dir = os.path.join(d, cfg.converted_subdir)
        if not files and os.path.isdir(conv_dir):
            man = _read_manifest(conv_dir)
            for r in man.values():
                sid = r.get("seed_id", "")
                if sid.count(".") == 3:
                    by_sta.setdefault((sid.split(".")[1].upper(),
                                       sid.split(".")[0].upper()), [])
        for (sta, net), plist in by_sta.items():
            e = found.setdefault(sta, dict(dir=d, raw_files=[], net=net,
                                           converted_dir=conv_dir))
            e["raw_files"].extend(plist)
    if verbose:
        print(f"  seismic root   : {root}")
        if not found:
            print("  ! no station waveform files found")
        for sta, e in sorted(found.items()):
            n_conv = len(_glob.glob(os.path.join(e["converted_dir"], "*.mseed")))
            print(f"      station {sta:6s} {len(e['raw_files']):6d} raw file(s), "
                  f"{n_conv:6d} converted  [{os.path.basename(e['dir'])}]")
    return found


def _read_manifest(conv_dir) -> dict:
    path = os.path.join(conv_dir, _MANIFEST)
    out = {}
    if not os.path.exists(path):
        return out
    try:
        with open(path, newline="") as fh:
            for r in csv.DictReader(fh):
                out[(r.get("source", ""), r.get("output", ""), r.get("seed_id", ""))] = r
    except Exception as exc:
        print(f"  ! unreadable manifest {path}: {exc}")
    return out


def _write_manifest(conv_dir, rows: dict) -> None:
    path = os.path.join(conv_dir, _MANIFEST)
    tmp = path + ".tmp"
    with open(tmp, "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=_MANIFEST_FIELDS, extrasaction="ignore")
        w.writeheader()
        for r in rows.values():
            w.writerow({k: r.get(k, "") for k in _MANIFEST_FIELDS})
    os.replace(tmp, path)


def _bad_time(t):
    return t.year < 1980 or t > UTCDateTime() + 86400 * 365


def _unique_target(path):
    if not os.path.exists(path):
        return path
    stem, ext = os.path.splitext(path)
    k = 2
    while os.path.exists(f"{stem}_{k}{ext}"):
        k += 1
    return f"{stem}_{k}{ext}"


def convert_station_to_mseed(cfg, sta: str, info: dict, verbose=True) -> int:
    conv = info["converted_dir"]
    os.makedirs(conv, exist_ok=True)
    rows = _read_manifest(conv)
    done = {}
    for r in rows.values():
        done[r.get("source", "")] = (r.get("source_size", ""), r.get("source_mtime", ""))
    keep_all = str(cfg.seis_keep_channels).upper() == "ALL"
    keep = {c.strip().upper() for c in str(cfg.seis_keep_channels).split(",") if c.strip()}

    t0w, t1w = window_of(cfg)
    files = info["raw_files"]
    if t0w is not None:
        stamped = sorted((t, p) for p in files for t in [parse_seis_filename(p)[0]] if t is not None)
        if len(stamped) > 1:
            span = float(np.median(np.diff([t.timestamp for t, _p in stamped])))
            span = max(span, 60.0) * 1.5 + float(cfg.seis_pad_s)
            near = {p for t, p in stamped if t <= t1w + cfg.seis_pad_s and t + span >= t0w}
            files = [p for p in files if p in near or parse_seis_filename(p)[0] is None]
            if verbose and len(files) < len(info["raw_files"]):
                print(f"  convert {sta:6s}: {len(files)} of {len(info['raw_files'])} raw files "
                      f"can overlap {t0w} -> {t1w}")
    todo = []
    for p in files:
        try:
            stt = os.stat(p)
        except OSError:
            continue
        size, mtime = str(stt.st_size), f"{stt.st_mtime:.0f}"
        prev = done.get(p)
        if prev is not None and (prev == ("", "") or prev == (size, mtime)):
            continue
        todo.append((p, size, mtime))
    if verbose:
        print(f"  convert {sta:6s}: {len(files) - len(todo)} already "
              f"done, {len(todo)} to convert -> {conv}")
    prog = Progress("converted", len(todo))
    n_ok = n_fail = 0
    for i, (p, size, mtime) in enumerate(todo):
        base = dict(source=p, source_size=size, source_mtime=mtime)
        st, fmt = read_any_waveform(p, cfg.seis_assume_format)
        good = Stream()
        if st is not None:
            for tr in st:
                fs = float(getattr(tr.stats, "sampling_rate", 0.0) or 0.0)
                ch = str(tr.stats.channel or "").upper()
                if fs > 0 and tr.stats.npts > 0 and (keep_all or ch in keep):
                    good.append(tr)
        if not len(good):
            n_fail += 1
            rows[(p, "", "")] = dict(base, note="FAILED: no readable waveform "
                                               "channel" if st is None else
                                     "FAILED: no requested channel")
            if verbose:
                prog.step(i, os.path.basename(p) + " (unreadable)")
            continue
        t_file, net_f, sta_f = parse_seis_filename(p)
        for tr in good:
            s = tr.stats
            if t_file is not None and _bad_time(s.starttime):
                s.starttime = t_file
            if not s.network and net_f:
                s.network = net_f.upper()[:2]
            if not s.station and sta_f:
                s.station = sta_f.upper()[:5]
        groups = {}
        for tr in good:
            groups.setdefault(tr.id, Stream()).append(tr)
        for sid, sub in groups.items():
            try:
                sub.merge(method=1, fill_value=None)
                sub = sub.split()
            except Exception:
                pass
            for tr in sub:
                tr.data = (np.ascontiguousarray(tr.data, dtype=np.int32)
                           if np.issubdtype(np.asarray(tr.data).dtype, np.integer)
                           else np.ascontiguousarray(tr.data, dtype=np.float32))
            s0 = sub[0].stats
            name = (f"{s0.network}.{s0.station}.{s0.location}.{s0.channel}__"
                    f"{min(t.stats.starttime for t in sub).strftime('%Y%m%dT%H%M%SZ')}__"
                    f"{max(t.stats.endtime for t in sub).strftime('%Y%m%dT%H%M%SZ')}.mseed")
            target = _unique_target(os.path.join(conv, name))
            sub.write(target, format="MSEED", reclen=4096)
            rows[(p, target, sid)] = dict(
                base, output=target, seed_id=sid, format=fmt,
                start=str(min(t.stats.starttime for t in sub)),
                end=str(max(t.stats.endtime for t in sub)),
                fs=sub[0].stats.sampling_rate, npts=sum(t.stats.npts for t in sub),
                note="")
        n_ok += 1
        if (i + 1) % 25 == 0:
            _write_manifest(conv, rows)
        if verbose:
            prog.step(i, os.path.basename(p))
    if todo:
        _write_manifest(conv, rows)
    if verbose and todo:
        print(f"      converted {n_ok}, unreadable {n_fail}")
        if n_fail and not n_ok:
            print("      ! nothing could be read. Set seis_assume_format in "
                  "CONFIG to the recorder format if you know it.")
    return n_ok


def prepare_seismic(cfg, stations=None, verbose=True) -> dict:
    print("  -- seismic step 1: detect stations")
    found = detect_seismic_stations(cfg, verbose)
    want = [s.upper() for s in (stations if stations is not None
                                else cfg.seis_stations)] or sorted(found)
    missing = [s for s in want if s not in found]
    if missing:
        raise SystemExit(f"station(s) {missing} not found under {cfg.seis_root}. "
                         f"Detected: {sorted(found)}")
    print("  -- seismic step 2: convert to MiniSEED (incremental)")
    if cfg.seis_convert:
        for s in want:
            convert_station_to_mseed(cfg, s, found[s], verbose)
    else:
        print("      seis_convert = False: using existing MiniSEED only")
    return {s: found[s] for s in want}


def _converted_rows(info):
    conv = info["converted_dir"]
    rows = []
    for r in _read_manifest(conv).values():
        out = r.get("output", "")
        if not out or not r.get("seed_id"):
            continue
        if not os.path.exists(out):
            alt = os.path.join(conv, os.path.basename(out))
            if not os.path.exists(alt):
                continue
            out = alt
        try:
            rows.append((r["seed_id"], UTCDateTime(r["start"]), UTCDateTime(r["end"]),
                         out))
        except Exception:
            continue
    if rows:
        return rows
    for p in sorted(_glob.glob(os.path.join(conv, "**", "*"), recursive=True)):
        if os.path.splitext(p)[1].lower() not in MSEED_EXT:
            continue
        try:
            for tr in read(p, headonly=True):
                rows.append((tr.id, tr.stats.starttime, tr.stats.endtime, p))
        except Exception:
            continue
    return rows


def seismic_coverage(stations: dict) -> dict:
    cov = {}
    for info in stations.values():
        for sid, t0, t1, _p in _converted_rows(info):
            a = cov.get(sid)
            cov[sid] = ((t0, t1, 1) if a is None else
                        (min(a[0], t0), max(a[1], t1), a[2] + 1))
    return cov


def _inventory_files_for(cfg, sta: str, info: dict, channel: str | None):
    spec = cfg.inventory
    if isinstance(spec, dict):
        spec = spec.get(sta, spec.get(sta.upper(), "auto"))
    if spec and spec != "auto":
        return [spec]
    cands = []
    for pat in ("*.xml", "*.XML", "*.stationxml", "RESP*", "*.dataless"):
        cands += _glob.glob(os.path.join(info["dir"], "**", pat), recursive=True)
    cands = sorted({c for c in cands if not os.path.basename(c).startswith("._")
                    and os.path.basename(c) != _MANIFEST})
    if channel:
        best = [c for c in cands if sta.upper() in os.path.basename(c).upper()
                and channel.upper() in os.path.basename(c).upper()]
        if best:
            return best
    named = [c for c in cands if sta.upper() in os.path.basename(c).upper()]
    return named or cands


def load_station_inventory(cfg, stations: dict, channel: str | None = None,
                           verbose=True):
    inv = Inventory(networks=[], source="combined")
    n_ok = 0
    for sta, info in stations.items():
        files = _inventory_files_for(cfg, sta, info, channel)
        if channel and len(files) == 1 and os.path.exists(files[0]):
            try:
                has = bool(read_inventory(files[0]).select(station=sta, channel=channel))
            except Exception:
                has = False
            if not has:
                cfg_auto = Config(**{**vars(cfg), "inventory": "auto"})
                files = files + [f for f in _inventory_files_for(cfg_auto, sta, info, channel)
                                 if f not in files]
        for f in files:
            try:
                inv += read_inventory(f)
                n_ok += 1
                if verbose:
                    print(f"  inventory      : {sta} <- {f}")
            except Exception as exc:
                if verbose:
                    print(f"  ! inventory {f} unreadable: {exc}")
    return inv if n_ok else None


def remove_response(st: Stream, inv, cfg, output=None, taper_frac=0.05,
                    taper_max_s=None, verbose=True):
    output = (output or cfg.seis_output).upper()
    if inv is None or not cfg.seis_remove_response:
        if verbose:
            print("  ! seismic data stay in COUNTS (no inventory or "
                  "seis_remove_response=False): absolute levels are NOT valid")
        return st.copy(), "COUNTS"
    out = st.copy().split()
    out.detrend("linear")
    if taper_max_s:
        out.taper(0.5, type="cosine", max_length=taper_max_s)
    else:
        out.taper(taper_frac, type="cosine")
    pf = tuple(cfg.pre_filt) if cfg.pre_filt else None
    ok = Stream()
    for tr in out:
        nyq = tr.stats.sampling_rate / 2.0
        pfi = pf
        if pf and pf[3] >= nyq:
            pfi = (pf[0], pf[1], min(pf[2], 0.8 * nyq), min(pf[3], 0.9 * nyq))
        try:
            tr.remove_response(inventory=inv, output=output, pre_filt=pfi,
                               water_level=cfg.water_level, zero_mean=True,
                               taper=False)
            ok += tr
        except Exception as exc:
            print(f"  ! no usable response for {tr.id}: {exc} -- dropped")
    if not len(ok):
        raise SystemExit("the inventory matched none of the seismic traces")
    ok.merge(method=1, fill_value=None)
    if verbose:
        print(f"  response       : removed -> {output}, pre_filt={pf}, "
              f"water_level={cfg.water_level}")
    return ok, output


def check_overlap(cfg, stations: dict):
    t0, t1 = window_of(cfg)
    d = das_coverage(cfg)
    s = seismic_coverage(stations)
    print(f"  DAS coverage   : {d['start']} -> {d['end']} ({d['n_files']} files, "
          f"{len(d['gaps'])} gap(s))")
    for sid, (a, b, n) in sorted(s.items()):
        print(f"  seis coverage  : {sid:18s} {a} -> {b} ({n} file(s))")
    if t0 is None:
        return
    if d["start"] is not None and (t1 <= d["start"] or t0 >= d["end"]):
        raise SystemExit("the configured window does not intersect the DAS data")
    if s and all(t1 <= a or t0 >= b for a, b, _n in s.values()):
        raise SystemExit("the configured window does not intersect the seismic data")


def c_app_of(cfg):
    if cfg.c_app_curve:
        d = np.loadtxt(cfg.c_app_curve, delimiter=",", comments="#", ndmin=2)
        o = np.argsort(d[:, 0])
        f, c = d[o, 0], d[o, 1]
        return lambda fq: np.interp(np.asarray(fq, float), f, c, left=c[0], right=c[-1])
    val = float(cfg.c_app)
    return lambda fq: np.full(np.shape(fq), val, dtype=float)


class TimeGrid:
    def __init__(self, t_ref, bin_s, n_bins):
        self.t_ref, self.bin_s, self.n_bins = UTCDateTime(t_ref), float(bin_s), int(n_bins)

    def index(self, t):
        return int(np.floor((UTCDateTime(t) - self.t_ref) / self.bin_s))

    def start_of(self, i):
        return self.t_ref + i * self.bin_s

    def centres_dt(self):
        return [(self.t_ref + (i + 0.5) * self.bin_s).datetime for i in range(self.n_bins)]


class GriddedSpectra:

    def __init__(self, grid, fs, spec_win_s, env_band, min_coverage=0.9):
        self.grid, self.fs, self.min_coverage = grid, float(fs), min_coverage
        nper = int(2 ** np.round(np.log2(max(8.0, spec_win_s * fs))))
        self.nper = int(max(8, min(nper, int(grid.bin_s * fs))))
        self.freqs = np.fft.rfftfreq(self.nper, d=1.0 / fs)
        nyq = fs / 2.0
        lo, hi = max(env_band[0], 1e-6), min(env_band[1], 0.95 * nyq)
        self.sos = (signal.butter(4, [lo / nyq, hi / nyq], btype="band", output="sos")
                    if hi > lo else None)
        self.psd = np.full((grid.n_bins, self.freqs.size), np.nan)
        self.rms = np.full(grid.n_bins, np.nan)
        self.buf = self.t_buf = None
        self.n_filled = 0

    def feed(self, x, t0):
        x = np.asarray(x, np.float64).ravel()
        if x.size == 0:
            return
        t0 = UTCDateTime(t0)
        if self.buf is None:
            self.buf, self.t_buf = x, t0
        elif abs(t0 - (self.t_buf + self.buf.size / self.fs)) > 0.5 / self.fs:
            self.buf, self.t_buf = x, t0
        else:
            self.buf = np.concatenate([self.buf, x])
        self._drain()

    def _drain(self):
        while self.buf is not None and self.buf.size:
            i = self.grid.index(self.t_buf)
            bin_end = self.grid.start_of(i + 1)
            need = int(round((bin_end - self.t_buf) * self.fs))
            if need <= 0:
                self.buf = self.t_buf = None
                return
            if self.buf.size < need:
                return
            seg = self.buf[:need]
            if (0 <= i < self.grid.n_bins and
                    seg.size >= self.min_coverage * self.grid.bin_s * self.fs and
                    np.all(np.isfinite(seg))):
                nper = int(min(self.nper, seg.size))
                f, p = signal.welch(seg, fs=self.fs, nperseg=nper, noverlap=nper // 2,
                                    detrend="linear", scaling="density")
                self.psd[i] = p if f.size == self.freqs.size else np.interp(self.freqs, f, p)
                b = signal.sosfiltfilt(self.sos, seg) if self.sos is not None else seg
                self.rms[i] = float(np.sqrt(np.mean(b ** 2)))
                self.n_filled += 1
            self.buf = self.buf[need:]
            self.t_buf = bin_end


def pick_seis_id(cfg, stations):
    cov = seismic_coverage(stations)
    ids = sorted(cov)
    if not ids:
        raise SystemExit("no converted seismic data found")
    if cfg.seis_select:
        tok = str(cfg.seis_select)
        ids = [i for i in ids if tok == i or tok in i]
    if cfg.seis_station:
        ids = [i for i in ids if i.split(".")[1].upper() == str(cfg.seis_station).upper()]
    comp = (cfg.seis_component or "").upper()
    if comp:
        hit = [i for i in ids if i.split(".")[-1].upper().endswith(comp)]
        if not hit:
            raise SystemExit(f"component {comp!r} not identifiable in {ids}; set "
                             f"seis_select to the exact SEED id")
        ids = hit
    if not ids:
        raise SystemExit(f"seis_select/seis_station match none of {sorted(cov)}")
    if len(ids) > 1:
        print(f"  ! several ids match {ids}; using {ids[0]}")
    return ids[0]


def accumulate_das(cfg, grid):
    gs, meta = None, {}
    for block, t0, fs, _c, meta in stream_das_blocks(cfg, [int(cfg.das_channels[0])],
                                                     cfg.fs_target, True):
        if gs is None:
            gs = GriddedSpectra(grid, fs, cfg.spec_win_s, (cfg.env_fmin, cfg.env_fmax))
        gs.feed(block[:, 0], t0)
    if gs is None:
        raise SystemExit("no DAS data in that window")
    gs._drain()
    return gs, meta


def accumulate_seis(cfg, grid, seed_id, stations, inv, chunk_s=1800.0, pad_s=60.0):
    t0w, t1w = window_of(cfg)
    rows = sorted([r for info in stations.values() for r in _converted_rows(info)
                   if r[0] == seed_id and r[2] >= t0w - pad_s and r[1] <= t1w + pad_s],
                  key=lambda r: r[1])
    gs, units = None, "COUNTS"
    state = {"buf": Stream(), "end": None, "last": None}

    def ensure(fs):
        nonlocal gs
        if gs is None:
            gs = GriddedSpectra(grid, fs, cfg.spec_win_s, (cfg.env_fmin, cfg.env_fmax))
        return gs

    def flush(final):
        nonlocal units
        buf = state["buf"]
        if not len(buf):
            return
        work = buf.copy()
        work.merge(method=1, fill_value=None)
        work, units = remove_response(work, inv, cfg, taper_max_s=pad_s, verbose=False)
        if not len(work):
            state["buf"] = Stream()
            return
        t_end = max(tr.stats.endtime for tr in work)
        t_beg = min(tr.stats.starttime for tr in work)
        cut = t_end if final else t_end - pad_s
        for tr in work.slice(t_beg, cut, nearest_sample=False).split():
            if tr.stats.npts < 2:
                continue
            g = ensure(tr.stats.sampling_rate)
            if abs(tr.stats.sampling_rate - g.fs) > 1e-6:
                continue
            last = state["last"]
            if last is not None and tr.stats.starttime <= last:
                new_start = last + 1.0 / tr.stats.sampling_rate
                if new_start > tr.stats.endtime:
                    continue
                tr = tr.copy().trim(new_start, tr.stats.endtime, nearest_sample=True)
                if tr.stats.npts < 2:
                    continue
            g.feed(np.nan_to_num(trace_data(tr)), tr.stats.starttime)
            state["last"] = tr.stats.endtime
        if final:
            state["buf"], state["end"] = Stream(), None
        else:
            state["buf"], state["end"] = buf.copy().slice(cut, t_end), t_end

    prog = Progress("seismic files", len(rows))
    for i, (_sid, _a, _b, path) in enumerate(rows):
        try:
            st = read(path).select(id=seed_id)
        except Exception as exc:
            print(f"  ! skip {os.path.basename(path)}: {exc}")
            continue
        for tr in st:
            tr.data = tr.data.astype(np.float64)
        st.merge(method=1, fill_value=None)
        st.trim(t0w - pad_s, t1w + pad_s)
        st = Stream([tr for tr in st if tr.stats.npts > 0])
        if not len(st):
            continue
        tb = min(tr.stats.starttime for tr in st)
        if state["end"] is not None and abs(tb - state["end"]) > 1.0:
            flush(True)
        state["buf"] += st
        state["end"] = max(tr.stats.endtime for tr in st)
        if state["end"] - min(tr.stats.starttime for tr in state["buf"]) >= chunk_s:
            flush(False)
        prog.step(i)
    flush(True)
    if gs is None:
        raise SystemExit(f"no seismic data for {seed_id} in that window")
    gs._drain()
    return gs, units


def to_acceleration_psd(psd, freqs, kind, cfg):
    w = 2 * np.pi * freqs
    if kind == "STRAIN":
        g = (w * c_app_of(cfg)(freqs)) ** 2 / float(cfg.obliquity or 1.0) ** 2
    elif kind == "VEL":
        g = w ** 2
    elif kind == "DISP":
        g = w ** 4
    else:
        g = np.ones_like(w)
    return psd * g[None, :]


def to_velocity_psd(psd, freqs, kind, cfg):
    w = 2 * np.pi * freqs
    if kind == "STRAIN":
        g = c_app_of(cfg)(freqs) ** 2 / float(cfg.obliquity or 1.0) ** 2
    elif kind == "ACC":
        g = np.full_like(w, np.nan)
        g[w != 0] = 1.0 / w[w != 0] ** 2
    elif kind == "DISP":
        g = w ** 2
    else:
        g = np.ones_like(w)
    return psd * g[None, :]


def band_rms(psd, freqs, lo, hi):
    sel = (freqs >= lo) & (freqs <= min(hi, freqs[-1]))
    if sel.sum() < 2:
        sel = freqs > 0
    df = np.gradient(freqs)
    allnan = np.all(np.isnan(psd[:, sel]), axis=1)
    out = np.sqrt(np.nansum(psd[:, sel] * df[None, sel], axis=1))
    out[allnan] = np.nan
    return out


def _cache_sig(cfg, seed_id):
    return repr(sorted(dict(
        das_dir=str(cfg.das_dir), start=str(window_of(cfg)[0]), end=str(window_of(cfg)[1]),
        bin=float(cfg.bin_s), win=float(cfg.spec_win_s), env=(cfg.env_fmin, cfg.env_fmax),
        fs=str(cfg.fs_target), ch=int(cfg.das_channels[0]), raw=str(cfg.das_raw_units),
        scale=float(cfg.das_raw_scale), gl=float(cfg.gauge_length), sid=seed_id,
        out=str(cfg.seis_output), rr=bool(cfg.seis_remove_response),
        wl=float(cfg.water_level), pf=tuple(cfg.pre_filt or []),
        inv=repr(sorted((cfg.inventory or {}).items()))).items()))


def build_timeline(cfg, use_cache=True, rebuild=False):
    t0w, t1w = window_of(cfg)
    if t0w is None:
        raise SystemExit("start_utc is required for a timeline")
    n_bins = int(np.ceil((t1w - t0w) / cfg.bin_s))
    if n_bins < 3:
        raise SystemExit(f"only {n_bins} bins of {cfg.bin_s:g} s -- lower bin_s")
    grid = TimeGrid(t0w, cfg.bin_s, n_bins)
    stations = prepare_seismic(cfg, [cfg.seis_station] if cfg.seis_station else [])
    check_overlap(cfg, stations)
    seed_id = pick_seis_id(cfg, stations)
    print(f"  seismic id     : {seed_id}")
    print(f"  grid           : {n_bins} bins of {cfg.bin_s:g} s from {t0w}")
    cache = os.path.join(cfg.cache_dir, f"{cfg.out_prefix}_timeline_cache.npz")
    sig = _cache_sig(cfg, seed_id)
    if use_cache and not rebuild and os.path.exists(cache):
        try:
            z = np.load(cache, allow_pickle=False)
            if str(z["signature"].item()) == sig:
                das = SimpleNamespace(freqs=z["das_freqs"], psd=z["das_psd"],
                                      rms=z["das_rms"], fs=float(z["das_fs"]),
                                      n_filled=int(z["das_n"]))
                seis = SimpleNamespace(freqs=z["seis_freqs"], psd=z["seis_psd"],
                                       rms=z["seis_rms"], fs=float(z["seis_fs"]),
                                       n_filled=int(z["seis_n"]))
                meta = dict(channels=[int(cfg.das_channels[0])],
                            gauge_length=float(z["gl"]), dx=float(z["dx"]))
                print(f"  cache reused   : {cache}")
                return dict(grid=grid, das=das, seis=seis, meta=meta,
                            seis_units=str(z["units"].item()), seed_id=seed_id,
                            n_bins=n_bins)
            print("  cache          : settings changed -> rebuilding")
        except Exception as exc:
            print(f"  ! cache unreadable ({exc}); rebuilding")
    print("  -- DAS: streaming Sintela HDF5 onto the grid")
    das, meta = accumulate_das(cfg, grid)
    print(f"  DAS bins       : {das.n_filled}/{n_bins}")
    print("  -- seismic step 3: streaming MiniSEED onto the grid (response removed "
          "per 30-min chunk)")
    chan = seed_id.split(".")[-1]
    inv = load_station_inventory(cfg, stations, chan)
    seis, units = accumulate_seis(cfg, grid, seed_id, stations, inv)
    print(f"  seismic bins   : {seis.n_filled}/{n_bins} ({units})")
    if use_cache:
        np.savez_compressed(cache, signature=np.array(sig), das_freqs=das.freqs,
                            das_psd=das.psd, das_rms=das.rms, das_fs=das.fs,
                            das_n=das.n_filled, seis_freqs=seis.freqs,
                            seis_psd=seis.psd, seis_rms=seis.rms, seis_fs=seis.fs,
                            seis_n=seis.n_filled, units=np.array(units),
                            gl=meta["gauge_length"], dx=meta["dx"])
        print(f"  cache written  : {cache}")
    if das.n_filled == 0 or seis.n_filled == 0:
        raise SystemExit("one side filled no bins -- check the window")
    return dict(grid=grid, das=das, seis=seis, meta=meta, seis_units=units,
                seed_id=seed_id, n_bins=n_bins)


def timeline_envelopes(tl, cfg, quantity):
    das, seis, u = tl["das"], tl["seis"], tl["seis_units"]
    conv = to_acceleration_psd if quantity == "ACC" else to_velocity_psd
    dp = conv(das.psd, das.freqs, "STRAIN", cfg)
    sp = conv(seis.psd, seis.freqs, u, cfg)
    return (dp, sp, band_rms(dp, das.freqs, cfg.env_fmin, cfg.env_fmax),
            band_rms(sp, seis.freqs, cfg.env_fmin, cfg.env_fmax))


