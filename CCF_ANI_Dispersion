        f"{fmin:g}-{fmax:g} Hz")
    cols, names, info = [], [], []
    for sta in STATIONS:
        try:
            index = seis_index(sta)
        except StopRun as s:
            if sta["name"] == SEIS_REF_STATION:
                raise
            log(f"  ! {s}")
            continue
        inv = load_inventory(sta)[0] if SEIS_REMOVE_RESPONSE else None
        y, inf = station_trace(sta, index, ta, tb, fs, inv, SEIS_CHANNEL)
        cover = 0.0 if y is None else float(np.isfinite(y).mean())
        if y is None or cover == 0.0:
            msg = f"no {SEIS_CHANNEL} data of {sta['name']} in the window"
            if sta["name"] == SEIS_REF_STATION:
                raise StopRun(msg + " (virtual source)")
            log(f"  ! {msg}, left out")
            continue
        log(f"  {sta['name']}: {inf['sid']} at {inf['fs_native']:g} Hz -> {fs:g} Hz, {inf['resp']}, "
            f"{100 * cover:.0f} % of the window")
        cols.append(y)
        names.append(sta["name"])
        info.append(inf)
    if len(names) < 2:
        raise StopRun("fewer than 2 stations with data in the window")
    Y = np.column_stack(cols)
    iref = names.index(SEIS_REF_STATION)
    win_sec, win_ov = ccf_params(ta, tb)
    starts = window_starts(ta, tb, win_sec, win_ov)
    if MAX_WINDOWS:
        starts = starts[:int(MAX_WINDOWS)]
    if not len(starts):
        raise StopRun("the window is shorter than one CCF window")
    log(f"  CCF windows of {win_sec:g} s, {100 * win_ov:g} % overlap ({len(starts)} windows)")
    res = stack_windows([(Y, ta, starts)], iref, len(names), fs, fmin, fmax, None, win_sec)
    G = stacked(res)
    lags = res["lags"]
    coords, csrc = seis_coords()
    off, has_xy = station_offsets(names, iref, coords)
    if has_xy:
        log(f"  station distances from {csrc}: " + ", ".join(f"{n} {o:.1f} m" for n, o in zip(names, off)))
        vel, reason = velocities(G, off, lags, "seismic"), "n/a"
    else:
        vel, reason = {"causal": None, "acausal": None}, "n/a (no station coordinates)"
    log(f"  CCF: {int(res['nused'])} windows stacked ({int(res['n_skip'])} left out: missing data at "
        f"{SEIS_REF_STATION}); windows per station: " + ", ".join(f"{n} {int(c)}" for n, c in zip(names, res["cnt"])))
    log(f"  causal {vel_text(vel['causal'], reason)}, acausal {vel_text(vel['acausal'], reason)}")
    Gn = G / np.maximum(np.abs(G).max(axis=0, keepdims=True), 1e-30)
    uo = np.unique(np.round(off, 6))
    spacing = float(np.min(np.diff(uo))) if len(uo) > 1 else 1.0
    amp = 0.45 * spacing
    fig, ax = plt.subplots(figsize=FIG_SIZE)
    for j, n in enumerate(names):
        yv = off[j] + amp * Gn[:, j]
        ax.fill_between(lags, off[j], yv, where=yv > off[j], color="#b2182b", alpha=0.8, lw=0)
        ax.fill_between(lags, off[j], yv, where=yv < off[j], color="#2166ac", alpha=0.8, lw=0)
        ax.plot(lags, yv, color="k", lw=0.5)
        ax.text(lags[-1], off[j], f" {n}{' (source)' if j == iref else ''}", va="center", ha="left",
                fontsize=fz(9), fontweight="bold" if j == iref else "normal", clip_on=False)
    ax.axhline(0, color="0.35", lw=0.8, zorder=0)
    if has_xy:
        draw_picks(ax, vel, off)
        ax.set_ylabel(f"Distance [m] from virtual source {SEIS_REF_STATION}")
    else:
        ax.set_yticks(off)
        ax.set_yticklabels(names)
        ax.set_ylabel("Station (no coordinates: equal spacing)")
    ax.set_xlim(lags[0], lags[-1])
    ax.set_ylim(off.min() - 1.5 * amp, off.max() + 1.5 * amp)
    ax.set_xlabel("Lag time, tau [s]")
    ax.grid(alpha=0.2, axis="x")
    st_txt = f"{names[0]}\u2013{names[-1]}" if len(names) > 2 else ", ".join(names)
    head = f"Seismic  |  {st_txt} {SEIS_CHANNEL}, source {SEIS_REF_STATION}"
    ax.set_title(make_title(head, ta, tb, fmin, fmax, vel, reason), fontsize=fz(10))
    path = save_fig(fig, f"CCF_ANI_SEISMIC_{SITE}_{SEIS_CHANNEL}_{name}_src{SEIS_REF_STATION}_{fmin:g}-{fmax:g}Hz")
    np.savez_compressed(os.path.splitext(path)[0] + ".npz", lags=lags, offsets=off, offsets_in_m=has_xy,
                        stations=np.array(names), virtual_source=SEIS_REF_STATION, linear=res["lin"],
                        stacked=G.astype(np.float32), windows_per_station=res["cnt"], n_windows=int(res["nused"]),
                        v_causal=np.nan if vel["causal"] is None else vel["causal"]["v"],
                        v_acausal=np.nan if vel["acausal"] is None else vel["acausal"]["v"])


def process_seismic_spectrogram(ta, tb, name, fs):
    chans = list(SPEC_SEIS_CHANNELS or [SEIS_CHANNEL])
    for cha in chans:
        guarded(f"seismic spectrogram {SPEC_STATION} {cha}", seismic_spectrogram_one, ta, tb, name, fs, cha)


def sensor_brand(sensor):
    if sensor is None:
        return ""
    parts = []
    for key in ("manufacturer", "model"):
        v = str(getattr(sensor, key, "") or "").strip()
        if v and "sensor name" not in v.lower() and v.lower() not in ("none", "unknown", "n/a") and v not in parts:
            parts.append(v)
    return " ".join(parts)


def sensor_text(sensor):
    if sensor is None:
        return ""
    parts = []
    for key in ("manufacturer", "model", "type", "description"):
        v = str(getattr(sensor, key, "") or "").strip()
        if v and "sensor name" not in v.lower() and v.lower() not in ("none", "unknown", "n/a") and v not in parts:
            parts.append(v)
    return f", sensor {' '.join(parts[:2])}" if parts else ""


def seismic_spectrogram_one(ta, tb, name, fs, cha):
    sta = next((s for s in STATIONS if s["name"] == SPEC_STATION), None)
    if sta is None:
        raise StopRun(f"SPEC_STATION {SPEC_STATION!r} is not in STATIONS")
    log(f"  --- spectrogram {SPEC_STATION} {cha}")
    inv = load_inventory(sta)[0] if SEIS_REMOVE_RESPONSE else None
    y, inf = station_trace(sta, seis_index(sta), ta, tb, fs, inv, cha)
    file_gaps, file_cover = seis_file_check(sta, cha, ta, tb, y, fs)
    if y is None or not np.isfinite(y).any():
        raise StopRun(f"no {cha} data of {SPEC_STATION} in the window")
    ch = inventory_channel(inv, inf["sid"], ta)
    extra = ""
    if ch is not None:
        sens = getattr(ch[2].response, "instrument_sensitivity", None)
        extra = sensor_text(ch[2].sensor)
        if sens is not None:
            extra += f", sensitivity {sens.value:.4g} {sens.output_units}/{sens.input_units}"
    log(f"  seismic spectrogram: {inf['sid']} at {inf['fs_native']:g} Hz -> {fs:g} Hz, {inf['resp']}{extra}")
    brand = sensor_brand(ch[2].sensor) if ch is not None else ""
    head = f"Seismic  |  {brand or 'seismometer'}  |  {inf['sid']}"
    sub = "velocity  |  " if inf["unit"] == "m/s" else f"{inf['unit']}  |  "
    plot_spectrogram(y, fs, ta, tb, head, inf["unit"], f"SPEC_SEISMIC_{SITE}_{SPEC_STATION}_{cha}_{name}",
                     file_gaps, sub=sub)


def run_windows():
    global _rebuild
    import argparse
    started = datetime.datetime.now()
    ap = argparse.ArgumentParser(description=f"CCF ANI gathers and spectrograms, DAS and seismic - {SITE}")
    ap.add_argument("--window", nargs=2, metavar=("START", "END"))
    ap.add_argument("--folder", help="DAS data folder (overrides DATA_FOLDER)")
    ap.add_argument("--data", choices=("das", "seismic", "both"), help="which data (overrides DATASETS)")
    ap.add_argument("--product", choices=("ccf", "spectrogram", "both"), help="which plots (overrides PRODUCTS)")
    ap.add_argument("--list", action="store_true", help="print the coverage of the DAS and seismic data")
    ap.add_argument("--check-seismic", action="store_true",
                    help="for every window, station and channel: what the seismic files on disk contain (no plots)")
    ap.add_argument("--inspect")
    ap.add_argument("--inspect-seismic", metavar="FILE", help="show what a seismic file contains, read three ways")
    ap.add_argument("--rebuild", action="store_true", help="read the h5 / seismic files again, rewrite all caches")
    a, _ = ap.parse_known_args()
    _rebuild = bool(a.rebuild)
    if a.inspect:
        inspect_file(a.inspect)
        return
    if a.inspect_seismic:
        inspect_seismic_file(a.inspect_seismic, SEIS_CHANNEL)
        return
    check_settings()
    sets = {"das": {"DAS"}, "seismic": {"SEISMIC"}, "both": {"DAS", "SEISMIC"}}[a.data] if a.data else \
        {str(d).upper() for d in DATASETS}
    prods = {"ccf": {"CCF"}, "spectrogram": {"SPECTROGRAM"}, "both": {"CCF", "SPECTROGRAM"}}[a.product] \
        if a.product else {str(p).upper() for p in PRODUCTS}
    do_das, do_seis = "DAS" in sets, "SEISMIC" in sets
    if not (do_das or do_seis) or not prods <= {"CCF", "SPECTROGRAM"} or not prods:
        raise StopRun("DATASETS must hold 'DAS' / 'SEISMIC' and PRODUCTS 'CCF' / 'SPECTROGRAM'")
    folder = a.folder or DATA_FOLDER
    log(f"site {SITE}  |  data: {', '.join(sorted(sets))}  |  plots: {', '.join(sorted(prods))}")
    stamped = file_sec = None
    if do_das:
        try:
            stamped, file_sec = list_files(folder, CABLE, RECURSIVE)
        except StopRun as stop:
            log(f"  DAS skipped: {stop}")
    if a.list:
        if stamped:
            describe_coverage(stamped, file_sec, CABLE)
        if do_seis:
            for sta in STATIONS:
                try:
                    describe_seis_coverage(sta, seis_index(sta))
                except StopRun as stop:
                    print(f"station {sta['name']}: {stop}")
        return
    windows = WINDOWS
    if a.window:
        t0, t1 = parse_window_time(a.window[0]), parse_window_time(a.window[1])
        windows = [(a.window[0], a.window[1], f"{t0:%Y-%m-%d_%H%M}_{t1:%H%M}")]
    if a.check_seismic:
        check_seismic(windows)
        return
    das_used = set()
    for ws, we, name in windows:
        t_start, t_end = parse_window_time(ws), parse_window_time(we)
        log(f"\n{'=' * 65}\n{name}: {t_start:%Y-%m-%d %H:%M:%S} -> {t_end:%Y-%m-%d %H:%M:%S} UTC\n{'=' * 65}")
        if t_end <= t_start:
            log("  [!] end before start, skipped")
            continue
        ta, tb = to_posix(t_start), to_posix(t_end)
        if do_das and stamped:
            log("--- DAS")

            def das_job():
                check_window(stamped, file_sec, ta, tb)
                paths = files_between(stamped, file_sec, ta, tb)
                if not paths:
                    raise StopRun("no files in the window")
                das_used.update(paths)
                L = report_metadata(paths[0], CABLE)
                process_das(stamped, file_sec, ta, tb, name, L, prods)
            guarded("DAS", das_job)
        if do_seis:
            log("--- seismic")

            def seis_job():
                fs = seismic_rate()
                if "CCF" in prods:
                    guarded("seismic CCF", process_seismic_ccf, ta, tb, name, fs)
                if "SPECTROGRAM" in prods:
                    guarded("seismic spectrogram", process_seismic_spectrogram, ta, tb, name, fs)
            guarded("seismic", seis_job)
    log("\nAll windows completed.")
    das_paths = None
    if stamped:
        das_paths = [p for p, _ in stamped] if META_DAS_SCOPE == "all" else sorted(das_used)
    guarded("metadata report", write_metadata_report, das_paths, folder, STATIONS if do_seis else [], started)


if __name__ == "__main__":
    try:
        run_windows()
    except StopRun as stop:
        print(f"\nSTOPPED: {stop}")
