        raise StopRun("WINDOWS must be a list of (start, end, name)")


def read_febus(path, chans, part=None):
    with open_h5(path) as f:
        ds, L = file_layout(f, CABLE)
        ch = np.asarray(chans, dtype=int)
        if ch.size == 0 or ch.min() < 0 or ch.max() >= L["n_ch"]:
            raise ValueError(f"channels outside 0..{L['n_ch'] - 1} in {os.path.basename(path)}")
        tb = find_time_array(f)
        tb = None if tb is None else np.asarray(tb, dtype=np.float64).ravel()
        nb, spb, fs = L["n_blocks"], L["spb"], L["fs"]
        nk = L["n_keep"]
        if tb is not None and tb.size == nb and nb > 1:
            d = np.diff(tb)
            d = d[d > 0]
            if d.size:
                step = int(round(np.median(d) * fs))
                if 0 < step <= spb:
                    nk = step
        bsel = slice(0, nb)
        if part is not None:
            n = min(nb, int(part[1]))
            bsel = slice(0, n) if part[0] == "head" else slice(nb - n, nb)
        a = (spb - nk) // 2
        c0, c1 = int(ch.min()), int(ch.max()) + 1
        if c1 - c0 <= 4 * len(ch):
            raw = ds[bsel, a:a + nk, c0:c1][:, :, ch - c0]
        else:
            raw = np.stack([ds[bsel, a:a + nk, int(c)] for c in ch], axis=-1)
        raw = raw.astype(np.float32)
    if tb is not None and tb.size == nb:
        tsel = tb[bsel]
    else:
        tsel = None
    if tsel is None:
        ts = parse_timestamp(os.path.basename(path))
        if ts is None:
            raise ValueError(f"no time array and no time stamp in {os.path.basename(path)}")
        t0 = to_posix(ts) + (bsel.start * nk / fs)
        return raw.reshape(-1, len(ch)), t0, L
    t0 = float(tsel[0]) - 0.5 * nk / fs
    dtb = np.diff(tb) if tb.size > 1 else np.array([])
    per = float(np.median(dtb[dtb > 0])) if np.any(dtb > 0) else nk / fs
    idx = np.round((tsel - tsel[0]) / per).astype(np.int64) * nk
    if len(idx) > 1 and (np.any(np.diff(idx) <= 0)):
        return raw.reshape(-1, len(ch)), t0, L
    if len(idx) > 1 and np.all(np.diff(idx) == nk):
        return raw.reshape(-1, len(ch)), t0, L
    x = np.full((int(idx[-1]) + nk, len(ch)), np.nan, dtype=np.float32)
    for i, k in enumerate(idx):
        x[k:k + nk] = raw[i]
    return x, t0, L


def nearest_channel(dist_m, L):
    return int(np.floor((dist_m - L["x0"]) / L["dx"] + 0.5))


def select_array(L):
    n_ch, dx = L["n_ch"], L["dx"]
    step = max(1, int(CH_STEP))
    src = nearest_channel(SOURCE_DIST_M, L)
    if not 0 <= src < n_ch:
        raise StopRun(f"SOURCE_DIST_M {SOURCE_DIST_M:g} m is outside the fibre "
                      f"({L['x0']:.0f}-{L['x0'] + (n_ch - 1) * dx:.0f} m)")
    c0 = int(np.ceil((SOURCE_DIST_M - DIST_BEFORE_M - L['x0']) / dx))
    c1 = int(np.floor((SOURCE_DIST_M + DIST_AFTER_M - L['x0']) / dx))
    if c1 > n_ch - 1:
        log(f"  ! the range is cut at the last channel of the files, Ch {n_ch - 1} "
            f"({L['x0'] + (n_ch - 1) * dx:.0f} m)")
    c0, c1 = max(0, c0), min(n_ch - 1, c1)
    left = list(range(src, c0 - 1, -step))[::-1]
    chans = left + list(range(src + step, c1 + 1, step))
    if len(chans) < 2:
        raise StopRun(f"fewer than 2 channels in the range (files have channels 0-{n_ch - 1}, dx {dx:g} m)")
    return chans, len(left) - 1


CACHE_VERSION = 4
_rebuild = False
_stats = {"hit": 0, "built": 0}


def _cache_name(path, c0, c1, step, fs_c):
    base = os.path.splitext(os.path.basename(path))[0]
    return os.path.join(CACHE_FOLDER, f"{base}_{CABLE}_ch{c0}-{c1}s{step}_fs{fs_c:g}.npz")


def _find_cache(path, chans, fs_c):
    st = os.stat(path)
    base = os.path.splitext(os.path.basename(path))[0]
    c0, c1, step = chans[0], chans[-1], (chans[1] - chans[0]) if len(chans) > 1 else 1
    cands = glob.glob(os.path.join(CACHE_FOLDER, f"{glob.escape(base)}_{CABLE}_ch*_fs{fs_c:g}.npz"))
    rx = re.compile(r"_ch(\d+)-(\d+)s(\d+)_fs")
    for cp in sorted(cands, key=len):
        m = rx.search(os.path.basename(cp))
        if not m:
            continue
        a, b, s = map(int, m.groups())
        if a <= c0 and b >= c1 and step % s == 0 and (c0 - a) % s == 0:
            try:
                with np.load(cp, allow_pickle=False) as h:
                    if (int(h["version"]) == CACHE_VERSION and int(h["src_size"]) == st.st_size
                            and abs(float(h["src_mtime"]) - st.st_mtime) < 1.0):
                        cols = (np.asarray(chans) - a) // s
                        xall = np.asarray(h["x"])
                        return xall[:, cols], float(h["t0"]), float(h["fs"]), float(h["fs_native"])
            except Exception:
                continue
    return None


def _build_cache(stamped, file_sec, k, chans, fs_c):
    from scipy.signal import resample_poly
    path = stamped[k][0]
    x, t0, L = read_febus(path, chans)
    fs = L["fs"]
    q = int(round(fs / fs_c))
    if q < 1 or abs(fs / q - fs_c) > 1e-6 * fs_c:
        raise StopRun(f"CACHE_FS {fs_c:g} Hz must be fs / integer (fs = {fs:g} Hz: e.g. {fs / max(1, round(fs / fs_c)):g})")
    t1 = t0 + len(x) / fs
    parts = [(t0, x)]
    ctx = max(2, int(np.ceil(CONTEXT_SEC)))
    for j, side in ((k - 1, "tail"), (k + 1, "head")):
        if 0 <= j < len(stamped):
            try:
                y, ty, _ = read_febus(stamped[j][0], chans, (side, ctx))
                if (side == "tail" and abs(ty + len(y) / fs - t0) < 2 * ctx) or \
                        (side == "head" and abs(ty - t1) < 2 * ctx):
                    parts.append((ty, y))
            except Exception:
                pass
    ta = min(p[0] for p in parts)
    tb = max(p[0] + len(p[1]) / fs for p in parts)
    ta = np.floor(ta * fs_c) / fs_c
    n = int(round((tb - ta) * fs)) + 1
    buf = np.full((n, len(chans)), np.nan, dtype=np.float32)
    for tp, y in sorted(parts, key=lambda p: p[0] != t0):
        i0 = int(round((tp - ta) * fs))
        s0, s1 = max(0, i0), min(n, i0 + len(y))
        if s1 > s0:
            seg = y[s0 - i0:s1 - i0]
            ok = ~np.isnan(seg[:, 0])
            buf[s0:s1][ok] = seg[ok]
    buf, _ = close_tiny_holes(buf)
    bad = np.isnan(buf).any(axis=1)
    if bad.all():
        raise StopRun(f"{os.path.basename(path)} has no data for these channels")
    filled = mirror_fill(buf.astype(np.float64), bad)
    y = resample_poly(filled, 1, q, axis=0).astype(np.float32) if q > 1 else filled.astype(np.float32)
    badd = np.zeros(len(y), dtype=bool)
    for off in range(-q // 2, q // 2 + 1):
        idx = np.clip(np.arange(len(y)) * q + off, 0, n - 1)
        badd |= bad[idx]
    y[badd] = np.nan
    tgrid = ta + np.arange(len(y)) / fs_c
    keep = (tgrid >= t0 - 1.5 / fs_c) & (tgrid < t1 + 1.5 / fs_c)
    xk, tk0 = y[keep], float(tgrid[keep][0])
    if USE_CACHE:
        try:
            os.makedirs(CACHE_FOLDER, exist_ok=True)
            st = os.stat(path)
            cp = _cache_name(path, chans[0], chans[-1], (chans[1] - chans[0]) if len(chans) > 1 else 1, fs_c)
            with open(cp + ".tmp", "wb") as fh:
                np.savez(fh, x=xk, t0=np.float64(tk0), fs=np.float64(fs_c), fs_native=np.float64(fs),
                         src_size=np.int64(st.st_size), src_mtime=np.float64(st.st_mtime),
                         version=np.int64(CACHE_VERSION))
            os.replace(cp + ".tmp", cp)
        except OSError as e:
            log(f"  ! cannot write the cache in {CACHE_FOLDER} ({e}), continuing without it")
    return xk, tk0, fs_c, fs


def load_block(stamped, file_sec, ta, tb, chans, fs_c):
    n = int(round((tb - ta) * fs_c))
    out = np.full((n, len(chans)), np.nan, dtype=np.float32)
    idx = {p: i for i, (p, _) in enumerate(stamped)}
    fs_nat = None
    for p in files_between(stamped, file_sec, ta, tb):
        got = None if (_rebuild or not USE_CACHE) else _find_cache(p, chans, fs_c)
        if got is None:
            try:
                got = _build_cache(stamped, file_sec, idx[p], chans, fs_c)
            except StopRun:
                raise
            except Exception as e:
                log(f"  skipped {os.path.basename(p)}: {e}")
                continue
            _stats["built"] += 1
        else:
            _stats["hit"] += 1
        x, t0, _, fs_nat = got
        i0 = int(round((t0 - ta) * fs_c))
        s0, s1 = max(0, i0), min(n, i0 + len(x))
        if s1 > s0:
            seg = x[s0 - i0:s1 - i0]
            ok = ~np.isnan(seg).any(axis=1)
            out[s0:s1][ok] = seg[ok]
    return out, fs_nat


def cache_report(t_start):
    log(f"  cache: {_stats['hit']} files from the cache, {_stats['built']} read from h5 and cached, "
        f"{time.time() - t_start:.0f} s")
    _stats["hit"] = _stats["built"] = 0


def result_key(**kw):
    import hashlib
    import json
    return hashlib.md5(json.dumps(kw, sort_keys=True, default=str).encode()).hexdigest()[:12]


def result_load(tag, key):
    p = os.path.join(CACHE_FOLDER, "results", f"{tag}_{key}.npz")
    if USE_CACHE and not _rebuild and os.path.exists(p):
        try:
            with np.load(p, allow_pickle=False) as h:
                log(f"  result cache hit: {os.path.basename(p)} (no data read)")
                return {k: h[k] for k in h.files}
        except Exception:
            pass
    return None


def result_save(tag, key, res):
    if not USE_CACHE:
        return
    try:
        d = os.path.join(CACHE_FOLDER, "results")
        os.makedirs(d, exist_ok=True)
        p = os.path.join(d, f"{tag}_{key}.npz")
        with open(p + ".tmp", "wb") as fh:
            np.savez(fh, **res)
        os.replace(p + ".tmp", p)
        log(f"  result cached: {os.path.basename(p)}")
    except OSError as e:
        log(f"  ! cannot write the result cache ({e})")


def window_starts(ta, tb, win, overlap):
    step = win * (1.0 - overlap)
    return ta + np.arange(0, max(0.0, tb - ta - win) + 1e-9, step)


def window_groups(starts, win, group_sec):
    groups, cur = [], []
    for s0 in starts:
        if cur and s0 + win - cur[0] > group_sec:
            groups.append(cur)
            cur = []
        cur.append(s0)
    if cur:
        groups.append(cur)
    return groups


def band_weight(f, fmin, fmax):
    edge = 0.1 * (fmax - fmin)
    w = np.zeros_like(f)
    w[(f >= fmin) & (f <= fmax)] = 1.0
    lo = (f >= fmin - edge) & (f < fmin)
    hi = (f > fmax) & (f <= fmax + edge)
    w[lo] = 0.5 - 0.5 * np.cos(np.pi * (f[lo] - (fmin - edge)) / edge)
    w[hi] = 0.5 + 0.5 * np.cos(np.pi * (f[hi] - fmax) / edge)
    return w


def spectra(X, fs, fmin, fmax, nfft):
    from scipy.signal import butter, sosfiltfilt, detrend
    from scipy.signal.windows import tukey
    from scipy.ndimage import uniform_filter1d
    X = detrend(X.astype(np.float64), axis=0) * tukey(len(X), 0.05)[:, None]
    sos = butter(4, [fmin, min(fmax, 0.49 * fs)], btype="bandpass", fs=fs, output="sos")
    X = sosfiltfilt(sos, X, axis=0)
    if TIME_NORM == "onebit":
        X = np.sign(X)
    elif TIME_NORM == "ram":
        w = max(1, int(round(RAM_WIN_SEC * fs)))
        X = X / np.maximum(uniform_filter1d(np.abs(X), w, axis=0, mode="nearest"), 1e-20)
    F = np.fft.rfft(X, n=nfft, axis=0)
    f = np.fft.rfftfreq(nfft, 1.0 / fs)
    w = band_weight(f, fmin, fmax)[:, None]
    if CCF_METHOD == "coherence":
        return F / np.maximum(np.abs(F), 1e-20) * w
    if WHITEN:
        nsm = max(1, int(round(WHITEN_SMOOTH_HZ / (f[1] - f[0]))))
        F = F / np.maximum(uniform_filter1d(np.abs(F), nsm, axis=0, mode="nearest"), 1e-20)
    return F * w


def correlate(F, iref, nfft, ml):
    Fa = F[:, iref]
    cc = np.fft.irfft(np.conj(Fa)[:, None] * F, n=nfft, axis=0)
    cc = np.concatenate([cc[-ml:], cc[:ml + 1]], axis=0)
    if CCF_METHOD == "coherence":
        return cc
    na = np.sqrt(np.sum(np.abs(Fa) ** 2))
    nb = np.sqrt(np.sum(np.abs(F) ** 2, axis=0))
    return cc / np.maximum(na * nb, 1e-30) * nfft


def stack_windows(blocks, iref, ncol, fs, fmin, fmax, min_frac=None, win_sec=60.0, common_mode=False, src_half=0):
    from scipy.signal import hilbert
    shifts = [d for d in range(-int(src_half), int(src_half) + 1) if 0 <= iref + d < ncol]
    nwin = int(round(win_sec * fs))
    nfft = int(2 ** np.ceil(np.log2(2 * nwin)))
    ml = int(round(LAG_MAX_SEC * fs))
    nl = 2 * ml + 1
    lin = np.zeros((nl, ncol))
    pha = np.zeros((nl, ncol), dtype=np.complex128)
    cnt = np.zeros(ncol)
    nused = n_skip = 0
    for X, t0, starts in blocks:
        for s0 in starts:
            i0 = int(round((s0 - t0) * fs))
            w = X[i0:i0 + nwin]
            if len(w) < nwin or np.isnan(w[:, iref]).any():
                n_skip += 1
                continue
            ok = ~np.isnan(w).any(axis=0)
            if (min_frac is not None and ok.mean() < min_frac) or ok.sum() < 2:
                n_skip += 1
                continue
            w = np.where(np.isnan(w), 0.0, w)
            if common_mode:
                w = w - np.median(w[:, ok], axis=1, keepdims=True)
            F = spectra(w, fs, fmin, fmax, nfft)
            for d in shifts:
                if not ok[iref + d]:
                    continue
                cs = correlate(F, iref + d, nfft, ml)
                cc = np.zeros_like(cs)
                okd = np.zeros(ncol, dtype=bool)
                if d >= 0:
                    cc[:, :ncol - d] = cs[:, d:]
                    okd[:ncol - d] = ok[d:]
                else:
                    cc[:, -d:] = cs[:, :ncol + d]
                    okd[-d:] = ok[:ncol + d]
                cc[:, ~okd] = 0.0
                a = hilbert(cc, axis=0)
                lin += cc
                pha += a / np.maximum(np.abs(a), 1e-30) * okd
                cnt += okd
            nused += 1
    if not nused:
        raise StopRun("no complete window (the virtual source or most traces touch missing data)")
    c1 = np.maximum(cnt, 1)
    return dict(lin=(lin / c1).astype(np.float32), coh=(np.abs(pha) / c1).astype(np.float32), cnt=cnt,
                lags=np.arange(-ml, ml + 1) / fs, nused=nused, n_skip=n_skip, fs=fs)


def stacked(res):
    lin = res["lin"].astype(np.float64)
    return lin * res["coh"].astype(np.float64) ** PWS_POWER if STACK_METHOD == "pws" else lin


def pick_velocity(G, off, lags, sign, mask=None):
    from scipy.signal import hilbert
    use = np.abs(off) >= VEL_MIN_OFFSET_M
    if mask is not None:
        use &= mask
    if use.sum() < 2:
        return None
    Gn = G[:, use] / np.maximum(np.abs(G[:, use]).max(axis=0), 1e-30)
    if Gn.shape[1] >= 10:
        Gn = Gn - np.median(Gn, axis=1, keepdims=True)
    E = np.abs(hilbert(Gn, axis=0))
    E = E / np.maximum(E.max(axis=0), 1e-30)
    a = np.abs(off[use])
    fs = 1.0 / (lags[1] - lags[0])
    cols = np.arange(len(a))
    cs = np.arange(VEL_C_MIN, VEL_C_MAX + 0.5 * VEL_C_STEP, VEL_C_STEP)
    score = np.full(len(cs), np.nan)
    for k, c in enumerate(cs):
        t = sign * a / c
        ok = np.abs(t) <= 0.95 * lags[-1]
        if ok.sum() < max(2, 0.5 * len(a)):
            continue
        idx = np.round((t[ok] - lags[0]) * fs).astype(int)
        score[k] = E[idx, cols[ok]].mean()
    if not np.isfinite(score).any():
        return None
    k = int(np.nanargmax(score))
    contrast = float(score[k] / max(np.nanmedian(score), 1e-30))
    edge = k <= 1 or k >= len(cs) - 2
    return dict(v=float(cs[k]), contrast=contrast, ok=contrast >= VEL_MIN_CONTRAST and not edge, edge=edge)


def velocities(G, off, lags, label):
    vel = {"causal": pick_velocity(G, off, lags, +1), "acausal": pick_velocity(G, off, lags, -1)}
    parts = []
    for side, m in (("+offset", off > 0), ("-offset", off < 0)):
        for lag, sg in (("causal", +1), ("acausal", -1)):
            p = pick_velocity(G, off, lags, sg, m)
            parts.append(f"{side} {lag} " + (f"{p['v']:.0f} m/s (contrast {p['contrast']:.1f})" if p else "n/a"))
    log(f"  {label} velocity by side: " + "; ".join(parts))
    return vel


def vel_text(p, reason="n/a"):
    if p is None:
        return reason
    if p.get("edge"):
        return "n/a (no clear move-out)"
    return f"{p['v']:.0f} m/s" if p["ok"] else f"~{p['v']:.0f} m/s (weak)"


def window_text(ta, tb):
    return f"{from_posix(ta):%Y-%m-%d %H:%M:%S} to {from_posix(tb):%Y-%m-%d %H:%M:%S} UTC"


def make_title(head, ta, tb, fmin, fmax, vel, reason="n/a"):
    method = "cross-coherence" if CCF_METHOD == "coherence" else "cross-correlation"
    return (f"{head}  |  {span_text(ta, tb)}\n"
            f"{method} {fmin:g}\u2013{fmax:g} Hz  |  causal {vel_text(vel['causal'], reason)}  |  "
            f"acausal {vel_text(vel['acausal'], reason)}")


def draw_picks(ax, vel, off):
    if not SHOW_PICKS:
        return
    ys = np.linspace(off.min(), off.max(), 200)
    for key, sg, col in (("causal", 1, "k"), ("acausal", -1, "0.3")):
        p = vel.get(key)
        if p:
            ax.plot(sg * np.abs(ys) / p["v"], ys, color=col, lw=0.9, ls="--")


def save_fig(fig, base):
