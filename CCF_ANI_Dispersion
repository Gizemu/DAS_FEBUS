_read_warnings = {}


def seis_read(path, headonly=False, sourcename=None, starttime=None, endtime=None):
    import warnings
    from obspy import read, UTCDateTime
    with open(path, "rb") as fh:
        raw = fh.read()
    if raw[:2] == b"\x1f\x8b":
        raw = gzip.decompress(raw)
    kw = {}
    if sourcename:
        kw["format"] = "MSEED"
        kw["sourcename"] = sourcename
    if starttime is not None:
        kw["starttime"] = UTCDateTime(starttime)
        kw["endtime"] = UTCDateTime(endtime)
    with warnings.catch_warnings(record=True) as caught:
        warnings.simplefilter("always")
        try:
            st = read(io.BytesIO(raw), headonly=headonly, **kw)
        except TypeError:
            kw.pop("sourcename", None)
            kw.pop("format", None)
            st = read(io.BytesIO(raw), headonly=headonly, **kw)
    msgs = sorted({str(w.message).splitlines()[0][:160] for w in caught
                   if "encodings" not in str(w.message)})
    if msgs:
        _read_warnings.setdefault(os.path.basename(path), set()).update(msgs)
    return st


def usable_traces(st, cha, sta_name):
    sel = st.select(channel=cha)
    mine = sel.select(station=sta_name)
    out, rejected = [], []
    for tr in (mine if len(mine) else sel):
        kind = getattr(tr.data, "dtype", np.dtype("O")).kind
        if (tr.stats.sampling_rate or 0) > 0 and tr.stats.npts > 10 and kind in "iuf":
            out.append(tr)
        else:
            rejected.append(f"{tr.id} {tr.stats.starttime} - {tr.stats.endtime}, {tr.stats.npts} samples, "
                            f"{tr.stats.sampling_rate:g} Hz, dtype {getattr(tr.data, 'dtype', '?')}")
    return out, rejected


def inspect_seismic_file(path, cha):
    print(f"seismic file {path}  ({os.path.getsize(path) / 1e6:.1f} MB)")
    for label, kw in (("headers only", dict(headonly=True)), ("full read", {}),
                      (f"only {cha} records", dict(sourcename=f"*.*.*.{cha}"))):
        try:
            st = seis_read(path, **kw)
        except Exception as ex:
            print(f"  {label}: not readable ({ex})")
            continue
        print(f"  {label}: {len(st)} traces")
        for tr in st:
            print(f"    {tr.id:18s} {tr.stats.starttime} - {tr.stats.endtime}  {tr.stats.sampling_rate:g} Hz  "
                  f"{tr.stats.npts} samples  dtype {getattr(tr.data, 'dtype', '-')}  "
                  f"encoding {getattr(getattr(tr.stats, 'mseed', None), 'encoding', '-')}")
    for m in sorted(_read_warnings.get(os.path.basename(path), [])):
        print(f"  warning: {m}")


def seis_files(sta):
    folder = sta["folder"]
    if not os.path.isdir(folder):
        raise StopRun(f"seismic folder of {sta['name']} does not exist (is the disk mounted?): {folder}")
    pat = os.path.join(folder, "**", SEIS_PATTERN) if SEIS_RECURSIVE else os.path.join(folder, SEIS_PATTERN)
    return [p for p in sorted(glob.glob(pat, recursive=SEIS_RECURSIVE))
            if os.path.isfile(p) and not os.path.basename(p).startswith(".") and not p.lower().endswith(".xml")]


def _trace_header(t):
    m = getattr(t.stats, "mseed", None)
    return {"id": t.id, "t0": t.stats.starttime.timestamp, "t1": t.stats.endtime.timestamp,
            "fs": float(t.stats.sampling_rate), "npts": int(t.stats.npts),
            "format": str(getattr(t.stats, "_format", "?")),
            "encoding": str(getattr(m, "encoding", "-")) if m else "-",
            "reclen": int(getattr(m, "record_length", 0)) if m else 0}


_seis_index_memo = {}


def seis_index(sta):
    import json
    if sta["name"] in _seis_index_memo:
        return _seis_index_memo[sta["name"]]
    paths = seis_files(sta)
    if not paths:
        raise StopRun(f"no seismic files matching {SEIS_PATTERN!r} in {sta['folder']}")
    ip = os.path.join(CACHE_FOLDER, f"seis_index_{sta['name']}.json")
    idx = {}
    if USE_CACHE and not _rebuild and os.path.exists(ip):
        try:
            with open(ip, encoding="utf-8") as fh:
                idx = json.load(fh)
        except Exception:
            idx = {}
    changed, out = False, []
    for p in paths:
        k, st_ = os.path.abspath(p), os.stat(p)
        e = idx.get(k)
        if (e is None or e.get("size") != st_.st_size or abs(e.get("mtime", -1e9) - st_.st_mtime) > 2.5
                or "traces" not in e):
            try:
                st = [t for t in seis_read(p, headonly=True) if (t.stats.sampling_rate or 0) > 0]
                e = {"size": st_.st_size, "mtime": st_.st_mtime,
                     "t0": min(t.stats.starttime.timestamp for t in st),
                     "t1": max(t.stats.endtime.timestamp for t in st),
                     "ids": sorted({f"{t.id}|{t.stats.sampling_rate:g}" for t in st}),
                     "traces": [_trace_header(t) for t in st]}
            except Exception as ex:
                e = {"size": st_.st_size, "mtime": st_.st_mtime, "t0": None, "t1": None, "ids": [], "traces": [],
                     "error": str(ex)}
            idx[k] = e
            changed = True
        out.append((p, e))
    if changed and USE_CACHE:
        try:
            os.makedirs(CACHE_FOLDER, exist_ok=True)
            with open(ip + ".tmp", "w", encoding="utf-8") as fh:
                json.dump(idx, fh)
            os.replace(ip + ".tmp", ip)
        except OSError:
            pass
    _seis_index_memo[sta["name"]] = out
    return out


def describe_seis_coverage(sta, index):
