def strain_rate_to_velocity(y, fs, c, scale):
    from scipy.signal import butter, sosfiltfilt
    from scipy.signal.windows import tukey
    sos = butter(4, DAS_VEL_HP_HZ, btype="highpass", fs=fs, output="sos")
    out = np.full(len(y), np.nan)
    pad = int(3 * fs / max(DAS_VEL_HP_HZ, 1e-3))
    for s0, s1 in contiguous_runs(np.isfinite(y)):
        if (s1 - s0) / fs < 2.0:
            continue
        seg = np.asarray(y[s0:s1], dtype=np.float64) * scale
        tw = tukey(len(seg), min(1.0, fs / max(DAS_VEL_HP_HZ, 1e-3) / len(seg)))
        seg = sosfiltfilt(sos, (seg - seg.mean()) * tw, padlen=min(pad, len(seg) - 1))
        integ = np.cumsum(seg) / fs
        integ = sosfiltfilt(sos, integ - integ.mean(), padlen=min(pad, len(integ) - 1))
        out[s0:s1] = -c * integ
    return out


def ccf_params(ta, tb):
    short = (tb - ta) <= CCF_SHORT_SEC
    ov = float(CCF_SHORT_OVERLAP if short else WINDOW_OVERLAP)
    if WINDOW_SEC:
        return float(WINDOW_SEC), ov
    win = float(np.clip((tb - ta) / float(CCF_TARGET_WINDOWS), CCF_WIN_MIN_SEC, CCF_WIN_MAX_SEC))
    return win, ov


def src_half(ta, tb):
    return int(CCF_SRC_STACK_HALF) if (tb - ta) <= CCF_SHORT_SEC else 0


def fk_fan(G, dt, dx, off):
    from scipy.signal.windows import tukey
    nl, nc = G.shape
    near = np.abs(off) < max(VEL_MIN_OFFSET_M, FK_MUTE_M)
    mute = np.ones(nc)
    mute[near] = 0.0
    T = G * mute[None, :] * tukey(nl, 0.2)[:, None] * tukey(nc, 0.05)[None, :]
    nf, nk = int(2 ** np.ceil(np.log2(2 * nl))), int(2 ** np.ceil(np.log2(2 * nc)))
    F = np.fft.fft2(T, s=(nf, nk))
    f = np.abs(np.fft.fftfreq(nf, dt))[:, None]
    k = np.abs(np.fft.fftfreq(nk, dx))[None, :]
    with np.errstate(divide="ignore", invalid="ignore"):
        c = np.where(k > 0, f / k, np.inf)
    lo = np.clip((c - 0.6 * FK_C_MIN) / (0.4 * FK_C_MIN), 0.0, 1.0)
    hi = np.clip((1.5 * FK_C_MAX - c) / (0.5 * FK_C_MAX), 0.0, 1.0)
    w = (0.5 - 0.5 * np.cos(np.pi * lo)) * (0.5 - 0.5 * np.cos(np.pi * hi))
    out = np.real(np.fft.ifft2(F * w))[:nl, :nc]
    out[:, near] = G[:, near]
    return out


_vel_picks = None


def vel_store():
    import json
    global _vel_picks
    if _vel_picks is None:
        _vel_picks = []
        fp = os.path.join(CACHE_FOLDER, f"das_velocity_picks_{CABLE}.json")
        if os.path.exists(fp):
            try:
                with open(fp, encoding="utf-8") as fh:
                    _vel_picks = json.load(fh)
            except Exception:
                _vel_picks = []
    return _vel_picks


def vel_store_add(ta, tb, c):
    import json
    picks = [p for p in vel_store() if not (abs(p["ta"] - ta) < 1 and abs(p["tb"] - tb) < 1)]
    picks.append({"ta": ta, "tb": tb, "c": c})
    _vel_picks[:] = picks
    try:
        os.makedirs(CACHE_FOLDER, exist_ok=True)
        with open(os.path.join(CACHE_FOLDER, f"das_velocity_picks_{CABLE}.json"), "w", encoding="utf-8") as fh:
            json.dump(picks, fh)
    except OSError:
        pass


def choose_das_c(ta, tb, vel):
    if DAS_VEL_C:
        return float(DAS_VEL_C), "setting"
    good = [vel[k]["v"] for k in ("causal", "acausal") if vel and vel.get(k) and vel[k]["ok"]]
    if good:
        c = float(np.mean(good))
        vel_store_add(ta, tb, c)
        return c, "CCF"
    store = [p for p in vel_store() if 1.05 * VEL_C_MIN < p["c"] < 0.95 * VEL_C_MAX]
    cands = [p for p in store if p["ta"] <= tb and p["tb"] >= ta]
    if not cands:
        cands = sorted(store, key=lambda p: min(abs(p["ta"] - tb), abs(p["tb"] - ta)))[:1]
    if cands:
        best = max(cands, key=lambda p: p["tb"] - p["ta"])
        return float(best["c"]), f"CCF {from_posix(best['ta']):%H:%M}\u2013{from_posix(best['tb']):%H:%M}"
    return float(DAS_VEL_C_FALLBACK), "assumed"


def native_channel_trace(stamped, file_sec, ta, tb, ch):
    fs = None
    paths = files_between(stamped, file_sec, ta, tb)
    folder = os.path.join(CACHE_FOLDER, "native")
    hit = built = 0
    y = None
    t_start = time.time()
    for p in paths:
        st = os.stat(p)
        base = os.path.splitext(os.path.basename(p))[0]
        cp = os.path.join(folder, f"{base}_{CABLE}_ch{ch}_native.npz")
        got = None
        if USE_CACHE and not _rebuild and os.path.exists(cp):
            try:
                with np.load(cp, allow_pickle=False) as h:
                    d = dict(h.items())
                if (int(d["version"]) == CACHE_VERSION and int(d["src_size"]) == st.st_size
                        and abs(float(d["src_mtime"]) - st.st_mtime) < 1.0):
                    got = (np.asarray(d["x"], dtype=np.float64), float(d["t0"]), float(d["fs"]))
                    hit += 1
            except Exception:
                got = None
        if got is None:
            try:
                x, t0, Lf = read_febus(p, [ch])
            except Exception as e:
                log(f"  skipped {os.path.basename(p)}: {e}")
                continue
            got = (x[:, 0].astype(np.float64), t0, float(Lf["fs"]))
            built += 1
            if USE_CACHE:
                try:
                    os.makedirs(folder, exist_ok=True)
                    with open(cp + ".tmp", "wb") as fh:
                        np.savez(fh, x=x[:, 0].astype(np.float32), t0=np.float64(t0), fs=np.float64(Lf["fs"]),
                                 src_size=np.int64(st.st_size), src_mtime=np.float64(st.st_mtime),
                                 version=np.int64(CACHE_VERSION), channel=np.int64(ch))
                    os.replace(cp + ".tmp", cp)
                except OSError as e:
                    log(f"  ! cannot write {cp} ({e})")
        x, t0, fsf = got
        if fs is None:
            fs = fsf
            y = np.full(int(round((tb - ta) * fs)), np.nan)
        i0 = int(round((t0 - ta) * fs))
        s0, s1 = max(0, i0), min(len(y), i0 + len(x))
        if s1 > s0:
            seg = x[s0 - i0:s1 - i0]
            ok = np.isfinite(seg)
            y[s0:s1][ok] = seg[ok]
    if y is None:
        raise StopRun("no DAS data could be read for the spectrogram channel")
    log(f"  native-rate Ch {ch}: {hit} files from the native cache, {built} read from h5 and cached, "
        f"{time.time() - t_start:.0f} s")
    return y, fs


def station_offsets(names, iref, coords):
    if all(n in coords for n in names):
        vals = [coords[n] for n in names]
        if all(isinstance(v, (int, float, np.integer, np.floating)) for v in vals):
            v = np.asarray(vals, dtype=float)
            return v - v[iref], True
        if all(isinstance(v, (list, tuple)) and len(v) >= 2 for v in vals):
            lat = np.radians([float(v[0]) for v in vals])
            lon = np.radians([float(v[1]) for v in vals])
            a = (np.sin((lat - lat[iref]) / 2) ** 2 +
                 np.cos(lat) * np.cos(lat[iref]) * np.sin((lon - lon[iref]) / 2) ** 2)
            return 2 * 6371000.0 * np.arcsin(np.sqrt(np.clip(a, 0, 1))), True
        log("  ! station coordinates mix numbers and (lat, lon): plotted by station order")
    elif coords:
        log(f"  ! no coordinates for {', '.join(n for n in names if n not in coords)}: "
            "plotted by station order")
    return np.arange(len(names), dtype=float) - iref, False


def seis_rate(index):
    rates = []
    for _, e in index:
        for s in e.get("ids", []):
            i, r = s.split("|")
            if i.split(".")[-1] == SEIS_CHANNEL and float(r) > 0:
                rates.append(float(r))
    if not rates:
        return None
    r = float(np.median(rates))
    return float(round(r)) if abs(r - round(r)) <= 1e-4 * r else r


def seismic_band(fs):
    fmin = float(SEIS_CC_FMIN if SEIS_CC_FMIN is not None else CC_FMIN)
    fmax = float(SEIS_CC_FMAX if SEIS_CC_FMAX is not None else CC_FMAX)
    if fmax >= 0.45 * fs:
        new = float(np.floor(0.45 * fs))
        log(f"  ! seismic band {fmin:g}-{fmax:g} Hz needs a rate above {fmax / 0.45:g} Hz; at {fs:g} Hz it ends at "
            f"{new:g} Hz (set SEIS_FS or SEIS_CC_FMAX)")
        fmax = new
    if not 0 < fmin < fmax:
        raise StopRun(f"seismic band {fmin:g}-{fmax:g} Hz is empty at {fs:g} Hz")
    return fmin, fmax


def guarded(label, fn, *args):
    try:
        fn(*args)
    except StopRun as stop:
        log(f"  {label} STOPPED: {stop}")
    except MemoryError:
        log(f"  [!] {label}: out of memory: lower GROUP_MIN, DIST_BEFORE_M / DIST_AFTER_M or raise CH_STEP")
    except Exception:
        import traceback
        log(f"  [!] {label}: error")
        traceback.print_exc()


def das_trace_and_gather(stamped, file_sec, ta, tb, L, chans, iref, ispec, products):
    fs = CACHE_FS
    files = [os.path.basename(p) for p in files_between(stamped, file_sec, ta, tb)]
    win_sec, win_ov = ccf_params(ta, tb)
    starts = window_starts(ta, tb, win_sec, win_ov)
    if MAX_WINDOWS:
        starts = starts[:int(MAX_WINDOWS)]
    res = y = None
    k_ccf = result_key(tag="ccf_das", ta=ta, tb=tb, chans=chans, iref=iref, fs=fs, win=win_sec,
                       ov=win_ov, cm=COMMON_MODE_REMOVAL, sh=src_half(ta, tb), lag=LAG_MAX_SEC, band=[CC_FMIN, CC_FMAX], m=CCF_METHOD, tn=TIME_NORM,
                       ram=RAM_WIN_SEC, wh=WHITEN, sm=WHITEN_SMOOTH_HZ, mc=DAS_MIN_COMPLETE, mw=MAX_WINDOWS,
                       files=files, v=CACHE_VERSION)
    k_tr = result_key(tag="das_trace", ta=ta, tb=tb, ch=chans[ispec], fs=fs, files=files, v=CACHE_VERSION)
    if "CCF" in products:
        if not len(starts):
            raise StopRun("the window is shorter than one CCF window")
        res = result_load("ccf_das", k_ccf)
    if "SPECTROGRAM" in products:
        got = result_load("das_trace", k_tr)
        y = None if got is None else got["y"].astype(np.float64)
    need_ccf = "CCF" in products and res is None
    need_tr = "SPECTROGRAM" in products and y is None
    if not (need_ccf or need_tr):
        return res, y
    n = int(round((tb - ta) * fs))
    ybuf = np.full(n, np.nan) if need_tr else None

    def put(X, t0):
        i0 = int(round((t0 - ta) * fs))
        s0, s1 = max(0, i0), min(n, i0 + len(X))
        if s1 > s0:
            ybuf[s0:s1] = X[s0 - i0:s1 - i0, ispec]

    def blocks():
        end = ta
        for grp in window_groups(starts, win_sec, 60.0 * GROUP_MIN):
            X, _ = load_block(stamped, file_sec, grp[0], grp[-1] + win_sec, chans, fs)
            if ybuf is not None:
                put(X, grp[0])
            end = grp[-1] + win_sec
            yield X, grp[0], grp
        if ybuf is not None:
            t = end
            while t < tb - 0.5 / fs:
                t1 = min(tb, t + 60.0 * GROUP_MIN)
                X, _ = load_block(stamped, file_sec, t, t1, chans, fs)
                put(X, t)
                t = t1
    t_read = time.time()
    log(f"  reading Ch {chans[0]}-{chans[-1]} once from the array cache for: "
        f"{', '.join(k for k, v in (('CCF', need_ccf), ('spectrogram Ch %d' % chans[ispec], need_tr)) if v)}")
    if need_ccf:
        sh = src_half(ta, tb)
        log(f"  CCF windows of {win_sec:g} s, {100 * win_ov:g} % overlap ({len(starts)} windows), common-mode "
            f"removal {'on' if COMMON_MODE_REMOVAL else 'off'}, {2 * sh + 1} virtual sources stacked by offset")
        res = stack_windows(blocks(), iref, len(chans), fs, CC_FMIN, CC_FMAX, DAS_MIN_COMPLETE, win_sec,
                            COMMON_MODE_REMOVAL, sh)
        result_save("ccf_das", k_ccf, res)
    else:
        for _ in blocks():
            pass
    cache_report(t_read)
    if need_tr:
        y = ybuf
        result_save("das_trace", k_tr, dict(y=y.astype(np.float32), ch=np.int64(chans[ispec]), fs=np.float64(fs)))
    return res, y


def plot_das_gather(res, ta, tb, name, L, chans, iref):
    dx = L["dx"] * max(1, int(CH_STEP))
    xref = L["x0"] + chans[iref] * L["dx"]
    G = stacked(res)
    lags = res["lags"]
    off = (np.asarray(chans) - chans[iref]) * L["dx"]
    if FK_FILTER:
        G = fk_fan(G, lags[1] - lags[0], dx, off)
        log(f"  f-k fan filter: apparent velocities {FK_C_MIN:g}-{FK_C_MAX:g} m/s kept")
    vel = velocities(G, off, lags, "DAS")
    log(f"  CCF: {int(res['nused'])} windows stacked ({int(res['n_skip'])} left out: missing data); "
        f"causal {vel_text(vel['causal'])}, acausal {vel_text(vel['acausal'])}")
    Gd = G / np.maximum(np.abs(G).max(axis=0, keepdims=True), 1e-30) if TRACE_NORM else G
    vm = np.percentile(np.abs(Gd), CLIP_PCT)
    dt = lags[1] - lags[0]
    fig, ax = plt.subplots(figsize=FIG_SIZE)
    im = ax.imshow(Gd.T, aspect="auto", cmap="RdBu_r", vmin=-vm, vmax=vm, origin="lower", interpolation="nearest",
                   extent=[lags[0] - dt / 2, lags[-1] + dt / 2, off[0] - dx / 2, off[-1] + dx / 2])
    ax.axhline(0, color="0.35", lw=0.8)
    draw_picks(ax, vel, off)
    ax.set_xlim(lags[0], lags[-1])
    ax.set_ylim(off[0] - dx / 2, off[-1] + dx / 2)
    ax.set_xlabel("Lag time, tau [s]")
    ax.set_ylabel(f"Distance [m] from virtual source channel {chans[iref]}")
    cb = fig.colorbar(im, ax=ax, pad=0.02)
    cb.set_label("Trace-normalised amplitude" if TRACE_NORM else
                 f"Stacked cross-{'coherence' if CCF_METHOD == 'coherence' else 'correlation'} amplitude")
    gl = f"GL {L['gauge_m']:g} m" if L.get("gauge_m") else "GL n/a"
    head = (f"DAS  |  Febus A1-R  |  {CABLE} Ch {chans[iref]} ({xref:.1f} m), Ch {chans[0]}\u2013{chans[-1]}  |  "
            f"{gl}, dx {L['dx']:g} m")
    ax.set_title(make_title(head, ta, tb, CC_FMIN, CC_FMAX, vel), fontsize=fz(10))
    path = save_fig(fig, f"CCF_ANI_DAS_{SITE}_{CABLE}_{name}_src{chans[iref]}_{CC_FMIN:g}-{CC_FMAX:g}Hz")
    np.savez_compressed(os.path.splitext(path)[0] + ".npz", lags=lags, offsets_m=off, channels=np.asarray(chans),
                        virtual_source=chans[iref], linear=res["lin"], stacked=G.astype(np.float32),
                        windows_per_channel=res["cnt"], n_windows=int(res["nused"]),
                        v_causal=np.nan if vel["causal"] is None else vel["causal"]["v"],
                        v_acausal=np.nan if vel["acausal"] is None else vel["acausal"]["v"])
    return vel


def process_das(stamped, file_sec, ta, tb, name, L, products):
    chans, iref = select_array(L)
    pos = L["x0"] + np.asarray(chans) * L["dx"]
    dspec = SOURCE_DIST_M if SPEC_DAS_DIST_M is None else SPEC_DAS_DIST_M
    want = nearest_channel(dspec, L)
    ispec = int(np.argmin(np.abs(np.asarray(chans) - want)))
    if "SPECTROGRAM" in products and chans[ispec] != want:
        raise StopRun(f"SPEC_DAS_DIST_M {dspec:g} m is outside the array {pos[0]:.0f}-{pos[-1]:.0f} m "
                      "(widen DIST_BEFORE_M / DIST_AFTER_M so that one cache serves both)")
    if "CCF" in products and not 0 < CC_FMIN < CC_FMAX < 0.45 * CACHE_FS:
        raise StopRun(f"need 0 < CC_FMIN < CC_FMAX < 0.45 x CACHE_FS = {0.45 * CACHE_FS:g} Hz")
    log(f"  DAS array Ch {chans[0]}-{chans[-1]} ({len(chans)} channels, {pos[0]:.1f}-{pos[-1]:.1f} m), "
        f"virtual source Ch {chans[iref]} ({pos[iref]:.1f} m), spectrogram Ch {chans[ispec]} ({pos[ispec]:.1f} m, "
        f"nearest to {dspec:g} m); cache {CACHE_FS:g} Hz from {L['fs']:g} Hz")
    win_files = files_between(stamped, file_sec, ta, tb)
    rows = das_meta_index(win_files)
    meta = [e for _, e in rows if "L" in e]
    nmiss = sum(e.get("missing_blocks", 0) for e in meta)
    if nmiss:
        bad = [(os.path.basename(p), e) for p, e in rows if e.get("missing_blocks")]
        log(f"  the DAS files' own block time stamps show {nmiss} missing blocks "
            f"({nmiss * meta[0]['block_sec']:.0f} s) in {len(bad)} of {len(win_files)} files of this window:")
        for n_, e in bad[:10]:
            log(f"    {n_}: {e['missing_blocks']} missing, block steps {e['step_min']:.3f} / {e['step_median']:.3f} / "
                f"{e['step_max']:.3f} s (min / median / max)")
        if len(bad) > 10:
            log(f"    ... {len(bad) - 10} more files (all listed in the metadata report)")
    native = "SPECTROGRAM" in products and (tb - ta) <= 60.0 * SPEC_NATIVE_MAX_MIN
    gather_products = set(products) - ({"SPECTROGRAM"} if native else set())
    res, y = das_trace_and_gather(stamped, file_sec, ta, tb, L, chans, iref, ispec, gather_products)
    vel = None
    if "CCF" in products:
        try:
            vel = plot_das_gather(res, ta, tb, name, L, chans, iref)
        except Exception:
            import traceback
            log("  [!] DAS CCF: error")
            traceback.print_exc()
    if "SPECTROGRAM" in products:
        c, csrc = choose_das_c(ta, tb, vel)
        scale = L.get("unit_scale") or 1.0
        if L.get("unit_kind") != "strain_rate" or scale == 1.0:
            log(f"  ! the data unit is not given as n\u03b5/s in the metadata ({L.get('dataset')}): nanostrain/s assumed")
            scale = 1e-9
        log(f"  DAS spectrogram in particle velocity: v = -c \u222b strain rate dt, c = {c:.0f} m/s ({csrc}), "
            f"strain-rate scale {scale:g}, high-pass {DAS_VEL_HP_HZ:g} Hz")
        gl = f"GL {L['gauge_m']:g} m" if L.get("gauge_m") else "GL n/a"
        head = (f"DAS  |  Febus A1-R  |  {CABLE} Ch {chans[ispec]} ({pos[ispec]:.1f} m)  |  {gl}, dx {L['dx']:g} m")
        sub = f"velocity, c = {c:.0f} m/s ({csrc})  |  "

        def spec_job():
            if native:
                yn, fsn = native_channel_trace(stamped, file_sec, ta, tb, chans[ispec])
            else:
                yn, fsn = y, CACHE_FS
            vy = strain_rate_to_velocity(yn, fsn, c, scale)
            gain = lambda fr: (scale * c) ** 2 / (2.0 * np.pi * np.maximum(fr, 1e-6)) ** 2
            plot_spectrogram(yn, fsn, ta, tb, head, "m/s", f"SPEC_DAS_{SITE}_{CABLE}_{name}_Ch{chans[ispec]}",
                             sub=sub, trace=vy, psd_gain=gain)
        guarded("DAS spectrogram", spec_job)


