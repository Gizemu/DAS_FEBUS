def next_path(base, ext):
    os.makedirs(OUTPUT_FOLDER, exist_ok=True)
    rx = re.compile(re.escape(base) + r"_(\d{4,})\.[A-Za-z0-9]+$")
    used = [int(m.group(1)) for m in map(rx.match, os.listdir(OUTPUT_FOLDER)) if m]
    return os.path.join(OUTPUT_FOLDER, f"{base}_{max(used, default=0) + 1:04d}.{ext}")



def mirror_fill(y, bad):
    n = len(y)
    for s0, s1 in contiguous_runs(bad):
        g = s1 - s0
        i = np.arange(g)
        left = y[np.clip(s0 - 1 - i, 0, n - 1)] if s0 > 0 else None
        right = y[np.clip(s1 + g - 1 - i, 0, n - 1)] if s1 < n else None
        if left is None and right is None:
            y[s0:s1] = 0.0
            continue
        if left is None:
            fill = right
        elif right is None:
            fill = left
        else:
            tt = ((i + 0.5) / g)[:, None]
            fill = np.cos(0.5 * np.pi * tt) * left + np.sin(0.5 * np.pi * tt) * right
        y[s0:s1] = np.nan_to_num(fill)
    return y


