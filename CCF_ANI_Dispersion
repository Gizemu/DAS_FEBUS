          f"{from_posix(max(e['t1'] for e in ok)):%Y-%m-%d %H:%M:%S} UTC")
    print("  channels (id|Hz): " + ", ".join(ids))


_inv_memo = {}


def load_inventory(sta):
    if sta["name"] in _inv_memo:
        return _inv_memo[sta["name"]]
    pattern = sta.get("response")
    files = sorted(glob.glob(pattern)) if pattern else []
    inv = None
    if not files:
        log(f"  ! no response file for {sta['name']} ({pattern})")
    else:
        from obspy import read_inventory
        for fpath in files:
            try:
                part = read_inventory(fpath)
            except Exception as e:
                log(f"  ! response file {os.path.basename(fpath)} not readable: {e}")
                continue
            inv = part if inv is None else inv + part
    _inv_memo[sta["name"]] = (inv, files)
    return inv, files


def inventory_coords(inv, name):
    if inv is None:
        return None
    for n in inv:
        for s in n:
            if s.code == name and s.latitude is not None and s.longitude is not None and \
                    (abs(s.latitude) > 1e-6 or abs(s.longitude) > 1e-6):
                return float(s.latitude), float(s.longitude)
    return None


def inventory_channel(inv, sid, t):
    if inv is None:
        return None
    from obspy import UTCDateTime
    net, sta, loc, cha = sid.split(".")
    for n in inv.select(network=net, station=sta, location=loc, channel=cha, time=UTCDateTime(t)):
        for s in n:
            for c in s:
                return n, s, c
    return None


def response_fallback(inv, tr):
    t = tr.stats.starttime
    cands = []
    for strict in (True, False):
        for n in inv:
            for s in n:
                if strict and s.code != tr.stats.station:
                    continue
                for c in s:
                    if c.code != tr.stats.channel or c.response is None:
                        continue
                    a, b = c.start_date, c.end_date
                    covers = (a is None or a <= t) and (b is None or b >= t)
                    dist = 0.0 if covers else min(abs(t - a) if a is not None else 1e18,
                                                  abs(t - b) if b is not None else 1e18)
                    cands.append((dist, f"{n.code}.{s.code}.{c.location_code}.{c.code}", c.response, covers, a, b))
        if cands:
            break
    return min(cands, key=lambda r: r[0]) if cands else None


_fallback_logged = set()


def remove_response_any(tr, inv, fs_n):
    fny = 0.5 * fs_n
    kw = dict(output=SEIS_OUTPUT, water_level=SEIS_WATER_LEVEL,
              pre_filt=[SEIS_PREFILT_LOW_HZ[0], SEIS_PREFILT_LOW_HZ[1], 0.9 * fny, 0.98 * fny])
    try:
        tr.remove_response(inventory=inv, **kw)
        return True
    except Exception as ex:
        first = str(ex)
    fb = response_fallback(inv, tr)
    if fb is None:
        log(f"  ! {tr.id} from {tr.stats.starttime}: no response for {tr.stats.channel} in the StationXML ({first})")
        return False
    _, fid, resp, covers, a, b = fb
    tr.stats.response = resp
    try:
        tr.remove_response(**kw)
    except Exception as ex:
        log(f"  ! {tr.id} from {tr.stats.starttime}: response of {fid} could not be applied ({ex})")
        return False
    note = (fid, tr.id, covers)
    if note not in _fallback_logged:
        _fallback_logged.add(note)
        log(f"  ! {tr.id}: no exact StationXML match ({first.splitlines()[0][:120]}); "
            f"used the response of {fid}" + ("" if covers else f" although its epoch {a} - {b} does not cover "
                                             f"{tr.stats.starttime} (nearest epoch)"))
    return True


SEIS_UNITS = {"DISP": "m", "VEL": "m/s", "ACC": "m/s\u00b2"}
_trace_memo = {}


def station_trace(sta, index, ta, tb, fs_t, inv, cha):
    from obspy import UTCDateTime, Stream
    a0, b0 = ta - SEIS_PAD_SEC, tb + SEIS_PAD_SEC
    used = [(os.path.basename(p), e["size"]) for p, e in index
            if e.get("t0") is not None and e["t1"] >= a0 and e["t0"] <= b0]
    key = result_key(tag="seis", sta=sta["name"], ta=ta, tb=tb, fs=fs_t, cha=cha,
                     resp=bool(SEIS_REMOVE_RESPONSE and inv is not None), out=SEIS_OUTPUT, wl=SEIS_WATER_LEVEL,
                     pad=SEIS_PAD_SEC, pf=list(SEIS_PREFILT_LOW_HZ), tol=SEIS_RATE_TOL, files=used, v=5)
    if key in _trace_memo:
        return _trace_memo[key]
    got = result_load("seis", key)
    if got is not None:
        _trace_memo[key] = (np.asarray(got["y"], dtype=np.float64),
                            dict(fs_native=float(got["fs_native"]), resp=str(got["resp"]), sid=str(got["sid"]),
                                 unit=str(got["unit"])))
        return _trace_memo[key]
    bad_files = [os.path.basename(p) for p, e in index if e.get("t0") is None]
    if bad_files:
        log(f"  ! {sta['name']}: {len(bad_files)} unreadable files in the folder (not used): {', '.join(bad_files[:5])}")
    trs = Stream()
    for p, e in index:
        if e.get("t0") is None or e["t1"] < a0 or e["t0"] > b0:
            continue
        if e.get("traces") and not any(t["id"].split(".")[-1] == cha and t["t1"] >= a0 and t["t0"] <= b0
                                       for t in e["traces"]):
            continue
        name_p = os.path.basename(p)
        got, how, notes = [], "", []
        for how, kw in (("selected records", dict(sourcename=f"*.*.*.{cha}", starttime=a0, endtime=b0)),
                        ("full read", dict(starttime=a0, endtime=b0)),
                        ("full read, no time selection", {})):
            try:
                st = seis_read(p, **kw)
            except Exception as ex:
                notes.append(f"{how}: not readable ({ex})")
                continue
            if how == "full read, no time selection":
                spans = [f"{t.id} {t.stats.starttime} - {t.stats.endtime}" for t in st.select(channel=cha)]
                notes.append(f"{how}: {cha} spans {'; '.join(spans[:4]) or 'none'}")
                st.trim(UTCDateTime(a0), UTCDateTime(b0))
            got, rejected = usable_traces(st, cha, sta["name"])
            if rejected:
                notes.append(f"{how}: rejected " + "; ".join(rejected[:3]))
            if got:
                break
        for tr in got:
            tr.stats.source_file = name_p
            trs.append(tr)
        if got and how != "selected records":
            log(f"  {name_p}: {cha} loaded only by '{how}'")
        if not got:
            ix = [f"{t['id']} {from_posix(t['t0']):%H:%M:%S}-{from_posix(t['t1']):%H:%M:%S}"
                  for t in e.get("traces", []) if t["id"].split(".")[-1] == cha]
            log(f"  ! {name_p}: the headers list {cha} ({'; '.join(ix[:3])}) but no usable samples were read")
            for n_ in notes:
                log(f"      {n_}")
        for m in sorted(_read_warnings.pop(name_p, [])):
            log(f"      reader warning ({name_p}): {m}")
    if not len(trs):
        _trace_memo[key] = (None, None)
        return _trace_memo[key]
    ids = sorted({t.id for t in trs})
    npts_by_id = {i: sum(t.stats.npts for t in trs if t.id == i) for i in ids}
    sid = max(ids, key=lambda i: npts_by_id[i])
    if len(ids) > 1:
        log(f"  ! {sta['name']}: several ids for {cha}: " + ", ".join(f"{i} ({npts_by_id[i]} samples)" for i in ids) +
            " - all are used, each with its own response")
    rates = np.array([t.stats.sampling_rate for t in trs])
    nominal = float(np.median(rates))
    for t in trs:
        if abs(t.stats.sampling_rate - nominal) <= SEIS_RATE_TOL * nominal:
            t.stats.sampling_rate = nominal
    rate_txt = ", ".join(f"{r:.6f} Hz x {int(np.sum(rates == r))}" for r in sorted(set(rates)))
    if len(set(rates)) > 1:
        log(f"  {sta['name']}: sampling rates in the headers: {rate_txt}; each trace is resampled with its own rate")
    pieces = []
    for gid in ids:
        for r in sorted({t.stats.sampling_rate for t in trs if t.id == gid}):
            grp = Stream([t.copy() for t in trs if t.id == gid and t.stats.sampling_rate == r])
            for t in grp:
                t.data = np.asarray(t.data, dtype=np.float64)
            try:
                grp.merge(method=1, fill_value=None)
                grp = grp.split()
            except Exception as ex:
                log(f"  ! {sta['name']} {gid} at {r:g} Hz: merge failed ({ex}), traces used one by one")
            pieces += list(grp)
    pieces.sort(key=lambda t: t.stats.starttime)
    n = int(round((tb - ta) * fs_t))
    out = []
    short = 0
    for tr in pieces:
        fs_n = tr.stats.sampling_rate
        if tr.stats.npts / fs_n < 10.0:
            short += 1
            continue
        tr.detrend("linear")
        tr.taper(0.05, max_length=5.0)
        unit = "counts"
        if SEIS_REMOVE_RESPONSE and inv is not None and remove_response_any(tr, inv, fs_n):
            unit = SEIS_UNITS.get(SEIS_OUTPUT.upper(), "?")
        if fs_n > fs_t * 1.0001:
            tr.filter("lowpass", freq=0.45 * fs_t, corners=8, zerophase=True)
        t_start, t_end = tr.stats.starttime.timestamp, tr.stats.endtime.timestamp
        k0 = int(np.ceil((t_start - ta) * fs_t - 1e-6))
        t_al = ta + k0 / fs_t
        if t_al >= t_end:
            continue
        if not (abs(fs_n - fs_t) < 1e-9 * fs_t and abs(t_al - t_start) * fs_t < 1e-3):
            tr.interpolate(sampling_rate=fs_t, method="lanczos", a=12, starttime=UTCDateTime(t_al))
        out.append((k0, np.asarray(tr.data, dtype=np.float64), unit, t_end - t_start))
    if short:
        log(f"  {sta['name']}: {short} pieces shorter than 10 s left out")
    units = {u for _, _, u, _ in out}
    unit = SEIS_UNITS.get(SEIS_OUTPUT.upper(), "?") if (units - {"counts"}) else "counts"
    if len(units) > 1:
        lost = sum(d for _, _, u, d in out if u == "counts")
        log(f"  ! {sta['name']}: {lost:.0f} s could not be converted to {unit} and are left out (no mixed units)")
    y = np.full(n, np.nan)
    for k0, d, u, _ in out:
        if u != unit:
            continue
        s0, s1 = max(0, k0), min(n, k0 + len(d))
        if s1 > s0:
            seg = d[s0 - k0:s1 - k0]
            ok = np.isfinite(seg)
            y[s0:s1][ok] = seg[ok]
    resp = f"response removed ({SEIS_OUTPUT})" if unit != "counts" else "counts"
    info = dict(fs_native=nominal, resp=resp, sid=sid, unit=unit)
    log(f"  {sta['name']} {cha}: {len(set(t.stats.source_file for t in trs))} files, {len(pieces)} continuous pieces, "
        f"{100.0 * float(np.isfinite(y).mean()):.1f} % of the window filled")
    result_save("seis", key, dict(y=y.astype(np.float32), fs_native=np.float64(nominal), resp=np.str_(resp),
                                  sid=np.str_(sid), unit=np.str_(unit)))
    _trace_memo[key] = (y, info)
    return _trace_memo[key]


def index_intervals(index, sta_name, cha):
    rows = []
    for p, e in index:
        for t in e.get("traces", []):
            parts = t["id"].split(".")
            if len(parts) == 4 and parts[3] == cha:
                rows.append((parts[1], t["t0"], t["t1"] + 1.0 / max(t["fs"], 1e-9), os.path.basename(p)))
    mine = [r for r in rows if r[0] == sta_name] or rows
    iv = sorted((a, b, f) for _, a, b, f in mine)
    merged = []
    for a, b, f in iv:
        if merged and a <= merged[-1][1] + 0.05:
            merged[-1][1] = max(merged[-1][1], b)
            merged[-1][2].add(f)
        else:
            merged.append([a, b, {f}])
    return merged


def interval_gaps(merged, ta, tb, min_sec):
    gaps, t = [], ta
    for a, b, _ in merged:
        if b <= ta or a >= tb:
            continue
        if a - t >= min_sec:
            gaps.append((t, min(a, tb)))
        t = max(t, b)
    if tb - t >= min_sec:
        gaps.append((t, tb))
    return gaps


def channel_codes(index, sta_name):
    codes = set()
    for _, e in index:
        for t in e.get("traces", []):
            parts = t["id"].split(".")
            if len(parts) == 4 and (parts[1] == sta_name or not sta_name):
                codes.add(parts[3])
    return sorted(codes)


def seis_file_check(sta, cha, ta, tb, y=None, fs=None):
    index = seis_index(sta)
    merged = index_intervals(index, sta["name"], cha)
    gaps = interval_gaps(merged, ta, tb, GAP_REPORT_MIN_SEC)
    span = tb - ta
    cover = 100.0 * (1.0 - sum(b - a for a, b in gaps) / span)
    files = sorted({os.path.basename(p) for p, e in index for t in e.get("traces", [])
                    if t["id"].split(".")[-1] == cha and t["t1"] > ta and t["t0"] < tb})
    log(f"  {sta['name']} {cha} in the files on disk: {cover:.1f} % of {window_text(ta, tb)} "
        f"({len(files)} files: {', '.join(files[:6])}{' ...' if len(files) > 6 else ''})")
    others = [c for c in channel_codes(index, sta["name"]) if c != cha]
    for a, b in gaps[:30]:
        alt = []
        for c in others:
            g2 = interval_gaps(index_intervals(index, sta["name"], c), a, b, GAP_REPORT_MIN_SEC)
            got = (b - a) - sum(q - p for p, q in g2)
            if got > 0.5 * (b - a):
                alt.append(c)
        log(f"    no {cha} recording in any file: {from_posix(a):%H:%M:%S} - {from_posix(b):%H:%M:%S} ({b - a:.0f} s)"
            + (f"; {', '.join(alt)} recorded at that time" if alt else "; no other channel either"))
    if y is not None and fs is not None:
        used = 100.0 * float(np.isfinite(y).mean())
        if used < cover - 1.0:
            log(f"  ! {sta['name']} {cha}: the files cover {cover:.1f} % but only {used:.1f} % was loaded: "
                "see the messages above for files that were not readable or not converted")
        else:
            log(f"  {sta['name']} {cha}: all recorded data in the window was loaded ({used:.1f} %)")
    return gaps, cover


def check_seismic(windows):
    for ws, we, name in windows:
        ta, tb = to_posix(parse_window_time(ws)), to_posix(parse_window_time(we))
        log(f"\n{name}: {window_text(ta, tb)}")
        for sta in STATIONS:
            try:
                index = seis_index(sta)
            except StopRun as stop:
                log(f"  {sta['name']}: {stop}")
                continue
            for cha in channel_codes(index, sta["name"]):
                seis_file_check(sta, cha, ta, tb)


def das_unit(L):
    if L.get("unit_attr"):
        return L["unit_attr"], L["unit_attr_src"]
    names = {1e-9: "n\u03b5", 1e-6: "\u00b5\u03b5", 1e-12: "p\u03b5", 1e-3: "m\u03b5"}
    if L.get("unit_kind") in ("strain_rate", "strain") and L.get("unit_scale") in names:
        u = names[L["unit_scale"]] + ("/s" if L["unit_kind"] == "strain_rate" else "")
        return u, f"dataset name {L['dataset']}"
    if L.get("unit_kind") == "phase":
        return "rad", f"dataset name {L['dataset']}"
    return "as stored", "no unit in the metadata"


def _jsonable(v):
    if isinstance(v, (np.floating, np.integer)):
        return v.item()
    if isinstance(v, np.ndarray):
        return v.tolist()
    return v


def das_meta_index(paths):
    import json
    ip = os.path.join(CACHE_FOLDER, f"das_meta_{CABLE}.json")
    idx = {}
    if USE_CACHE and not _rebuild and os.path.exists(ip):
        try:
            with open(ip, encoding="utf-8") as fh:
                idx = json.load(fh)
        except Exception:
            idx = {}
    changed, out = False, []
    t_start = time.time()
    for n, p in enumerate(paths):
        k, st_ = os.path.abspath(p), os.stat(p)
        e = idx.get(k)
        if (e is None or e.get("size") != st_.st_size or abs(e.get("mtime", -1e9) - st_.st_mtime) > 2.5
                or ("L" in e and "missing_blocks" not in e)):
            try:
                with open_h5(p) as f:
                    _, L = file_layout(f, CABLE)
                    tb = find_time_array(f)
                    attrs = {f"{o}@{a}": str(_text(v) if _text(v) is not None else v).replace("\n", " ")[:200]
                             for o, a, v in h5_attr_table(f)}
                tb = None if tb is None else np.asarray(tb, dtype=float).ravel()
                summ = {kk: _jsonable(vv) for kk, vv in L.items()}
                per = L["n_keep"] / L["fs"]
                d = np.diff(tb) if tb is not None and tb.size > 1 else np.array([])
                miss = int(np.sum(np.maximum(np.round(d / per) - 1, 0))) if d.size else 0
                e = {"size": st_.st_size, "mtime": st_.st_mtime, "L": summ, "attrs": attrs,
                     "t_first": float(tb[0]) if tb is not None and tb.size else None,
                     "t_last": float(tb[-1]) if tb is not None and tb.size else None,
                     "missing_blocks": miss, "block_sec": per,
                     "step_min": float(d.min()) if d.size else None, "step_max": float(d.max()) if d.size else None,
                     "step_median": float(np.median(d)) if d.size else None}
            except Exception as ex:
                e = {"size": st_.st_size, "mtime": st_.st_mtime, "error": str(ex)}
            idx[k] = e
            changed = True
            if n and n % 200 == 0:
                log(f"  metadata read: {n} of {len(paths)} files, {time.time() - t_start:.0f} s")
        out.append((p, e))
    if changed and USE_CACHE:
        try:
            os.makedirs(CACHE_FOLDER, exist_ok=True)
            with open(ip + ".tmp", "w", encoding="utf-8") as fh:
                json.dump(idx, fh)
            os.replace(ip + ".tmp", ip)
        except OSError:
            pass
    return out


def _utc(t):
    return "-" if t is None else f"{from_posix(t):%Y-%m-%d %H:%M:%S.%f}"[:-3]


def das_report(paths, folder):
    rows = das_meta_index(paths)
    ok = [(p, e) for p, e in rows if "L" in e]
    lines = [f"DAS data folder : {folder}", f"files reported  : {len(rows)} ({len(rows) - len(ok)} unreadable)",
             f"cable / dataset : {CABLE}", ""]
    if ok:
        L0 = ok[0][1]["L"]
        unit, usrc = das_unit(L0)
        lines += ["Acquisition parameters (first file, source in the file):",
                  f"  sampling rate      : {L0['fs']:g} Hz  <- {L0['fs_src']}",
                  f"  channel spacing    : {L0['dx']:g} m  <- {L0['dx_src']}",
                  f"  channel 0 at       : {L0['x0']:g} m  <- {L0['x0_src']}",
                  f"  Origin / Extent    : {L0['origin']} / {L0['extent']}",
                  "  gauge length       : " + ("not found" if not L0["gauge_m"] else
                                               f"{L0['gauge_m']:g} m  <- {L0['gauge_src']}"),
                  "  derivation time    : " + ("not found" if L0["dt_s"] is None else
                                               f"{L0['dt_s'] * 1e3:g} ms  <- {L0['dt_src']}"),
                  f"  channels           : {L0['n_ch']}  "
                  f"({L0['x0']:g} - {L0['x0'] + (L0['n_ch'] - 1) * L0['dx']:g} m)",
                  f"  blocks x samples   : {L0['n_blocks']} x {L0['spb']}, block overlap {L0['block_overlap']:g} %",
