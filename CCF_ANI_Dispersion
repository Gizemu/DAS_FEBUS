                lines.append(f"  ! {kk} differs between files: {', '.join(sorted(vals))}")
        hdr = (f"{'file':58s} {'MB':>7s} {'first block (UTC)':>23s} {'last block (UTC)':>23s} {'blocks':>6s} "
               f"{'spb':>5s} {'ch':>5s} {'fs Hz':>7s} {'dx m':>6s} {'x0 m':>7s} {'GL m':>6s} {'deriv ms':>8s} "
               f"{'missing blocks':>14s} {'block step min/med/max s':>26s}")
        lines += ["Per-file metadata:", hdr, "-" * len(hdr)]
        for p, e in rows:
            if "L" not in e:
                lines.append(f"{os.path.basename(p):58s} {e['size'] / 1e6:7.1f}  UNREADABLE: {e.get('error')}")
                continue
            L = e["L"]
            lines.append(f"{os.path.basename(p):58s} {e['size'] / 1e6:7.1f} {_utc(e['t_first']):>23s} "
                         f"{_utc(e['t_last']):>23s} {L['n_blocks']:6d} {L['spb']:5d} {L['n_ch']:5d} {L['fs']:7g} "
                         f"{L['dx']:6g} {L['x0']:7g} {str(L['gauge_m']):>6s} "
                         f"{'-' if L['dt_s'] is None else format(L['dt_s'] * 1e3, 'g'):>8s} "
                         f"{e.get('missing_blocks', 0):14d} "
                         f"{(format(e['step_min'], '.3f') + ' / ' + format(e['step_median'], '.3f') + ' / ' + format(e['step_max'], '.3f')) if e.get('step_min') is not None else '-':>26s}")
        allk = sorted({a for _, e in ok for a in e["attrs"]})
        const, vary = [], []
        for a in allk:
            vals = [e["attrs"].get(a, "<missing>") for _, e in ok]
            (const if len(set(vals)) == 1 else vary).append((a, vals))
        lines += ["", f"Attributes identical in all {len(ok)} files ({len(const)}):"]
        lines += [f"  {a} = {v[0]}" for a, v in const]
        lines += ["", f"Attributes that differ between files ({len(vary)}):"]
        for a, v in vary:
            lines.append(f"  {a}: {len(set(v))} values, first {v[0]!r}, last {v[-1]!r}")
    return lines


def seis_report(sta):
    lines = [f"Station {sta['name']}  |  folder {sta['folder']}"]
    try:
        index = seis_index(sta)
    except StopRun as s:
        return lines + [f"  {s}", ""]
    inv, rfiles = load_inventory(sta)
    lines.append(f"  response files: {', '.join(os.path.basename(f) for f in rfiles) or 'none'}")
    if inv is not None:
        for n in inv:
            for s in n:
                lines.append(f"  station {n.code}.{s.code}: lat {s.latitude}, lon {s.longitude}, elev {s.elevation} m, "
                             f"{s.start_date} - {s.end_date}")
                for c in s:
                    r = c.response
                    sens = getattr(r, "instrument_sensitivity", None) if r else None
                    lines.append(f"    channel {n.code}.{s.code}.{c.location_code}.{c.code}: "
                                 f"{c.sample_rate} Hz, depth {c.depth} m, az {c.azimuth}, dip {c.dip}, "
                                 f"{c.start_date} - {c.end_date}")
                    lines.append(f"      sensor {getattr(c.sensor, 'description', None) or getattr(c.sensor, 'type', None)}, "
                                 f"datalogger {getattr(c.data_logger, 'description', None)}")
                    if sens is not None:
                        lines.append(f"      sensitivity {sens.value:.6g} at {sens.frequency} Hz, "
                                     f"{sens.input_units} -> {sens.output_units}, "
                                     f"{len(r.response_stages)} stages")
    ok = [e for _, e in index if e.get("t0") is not None]
    if ok:
        lines.append(f"  coverage {_utc(min(e['t0'] for e in ok))} to {_utc(max(e['t1'] for e in ok))} UTC, "
                     f"{len(index)} files ({len(index) - len(ok)} unreadable)")
    hdr = (f"  {'file':44s} {'MB':>6s} {'trace id':18s} {'start (UTC)':>23s} {'end (UTC)':>23s} {'fs Hz':>7s} "
           f"{'npts':>10s} {'format':>6s} {'encoding':>9s} {'reclen':>6s}")
    lines += [hdr, "  " + "-" * (len(hdr) - 2)]
    for p, e in index:
        if not e.get("traces"):
            lines.append(f"  {os.path.basename(p):44s} {e['size'] / 1e6:6.1f}  UNREADABLE: {e.get('error')}")
            continue
        for t in e["traces"]:
            lines.append(f"  {os.path.basename(p):44s} {e['size'] / 1e6:6.1f} {t['id']:18s} {_utc(t['t0']):>23s} "
                         f"{_utc(t['t1']):>23s} {t['fs']:7g} {t['npts']:10d} {t['format']:>6s} {t['encoding']:>9s} "
                         f"{t['reclen']:6d}")
    return lines + [""]


def settings_report():
    names = [k for k in globals() if re.fullmatch(r"[A-Z][A-Z0-9_]+", k) and not callable(globals()[k])
             and k not in ("UTC", "META_PATTERNS", "SEIS_UNITS", "CACHE_VERSION")]
    return [f"  {k} = {globals()[k]!r}" for k in names]


def write_metadata_report(das_paths, das_folder, stations, started):
    bar = "=" * 100
    lines = [f"Metadata and processing report  |  site {SITE}",
             f"run started {started:%Y-%m-%d %H:%M:%S} (local), written {datetime.datetime.now():%Y-%m-%d %H:%M:%S}", ""]
    if das_paths is not None:
        lines += [bar, "DAS (Febus A1-R)", bar] + das_report(das_paths, das_folder) + [""]
    if stations:
        lines += [bar, "SEISMIC", bar]
        for sta in stations:
            lines += seis_report(sta)
    lines += [bar, "Settings", bar] + settings_report() + ["", bar, "Processing log", bar] + list(_LOG)
    path = next_path(f"METADATA_{SITE}", "txt")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")
    print(f"metadata report: {path}")
    return path


def spec_params(span, fs):
    step = span / float(SPEC_TARGET_FRAMES)
    fmax = min(SPEC_FMAX or 0.45 * fs, 0.5 * fs)
    if SPEC_WIN_SEC:
        win = float(SPEC_WIN_SEC)
    else:
        win = float(np.clip(np.sqrt(2.0 * SPEC_NW * span / fmax), SPEC_WIN_MIN_SEC, SPEC_WIN_MAX_SEC))
    if SPEC_OVERLAP is not None:
        return win, float(SPEC_OVERLAP)
    return win, float(np.clip(1.0 - step / win, 0.0, 0.95))


def close_tiny_holes(y, max_n=None):
    max_n = BRIDGE_MAX_SAMPLES if max_n is None else max_n
    bad = np.isnan(y) if y.ndim == 1 else np.isnan(y).any(axis=1)
    if not bad.any() or max_n < 1:
        return y, 0
    n_fixed = 0
    for s0, s1 in contiguous_runs(bad):
        if s1 - s0 <= max_n and s0 > 0 and s1 < len(y) and not bad[s0 - 1] and not bad[s1]:
            fr = (np.arange(s0, s1) - (s0 - 1)) / float(s1 - (s0 - 1))
            if y.ndim == 1:
                y[s0:s1] = y[s0 - 1] + (y[s1] - y[s0 - 1]) * fr
            else:
                y[s0:s1] = y[s0 - 1][None, :] + (y[s1] - y[s0 - 1])[None, :] * fr[:, None]
            n_fixed += s1 - s0
    return y, n_fixed


def gap_runs(y, fs, ta, min_sec):
    out = []
    for s0, s1 in contiguous_runs(np.isnan(y)):
        if (s1 - s0) / fs >= min_sec:
            out.append((ta + s0 / fs, ta + s1 / fs))
    return out


def log_gaps(label, y, fs, ta):
    gaps = gap_runs(y, fs, ta, GAP_REPORT_MIN_SEC)
    tot = sum(b - a for a, b in gaps)
    log(f"  {label}: {100.0 * float(np.isfinite(y).mean()):.1f} % of the window has samples; "
        f"{len(gaps)} gaps >= {GAP_REPORT_MIN_SEC:g} s ({tot:.1f} s)")
    for a, b in gaps[:30]:
        log(f"    gap {from_posix(a):%H:%M:%S.%f}"[:-3] + f" - {from_posix(b):%H:%M:%S.%f}"[:-3] + f"  ({b - a:.2f} s)")
    if len(gaps) > 30:
        log(f"    ... {len(gaps) - 30} more gaps")
    return gaps, tot


def spectrogram(y, fs, win_sec, ov):
    from scipy.signal.windows import dpss
    nper = max(16, int(round(win_sec * fs)))
    step = max(1, int(round(nper * (1.0 - ov))))
    if len(y) < nper:
        raise StopRun("the window is shorter than one spectrogram segment")
    idx = np.arange(0, len(y) - nper + 1, step)
    nfft = int(2 ** np.ceil(np.log2(nper * max(1, int(SPEC_ZERO_PAD)))))
    k_tap = max(1, int(SPEC_TAPERS))
    tap = np.atleast_2d(dpss(nper, SPEC_NW, k_tap))
    tap = tap / np.sqrt((tap ** 2).sum(axis=1, keepdims=True))
    f = np.fft.rfftfreq(nfft, 1.0 / fs)
    m = max(16, nper // max(2, int(SPEC_GAP_SUBSEG)))
    hop = max(1, m // 2)
    sub_starts = np.arange(0, nper - m + 1, hop)
    sub_ix = sub_starts[:, None] + np.arange(m)[None, :]
    wm = np.hanning(m + 1)[:-1]
    sm = 1.0 / (fs * np.sum(wm ** 2))
    fm = np.fft.rfftfreq(m, 1.0 / fs)
    need = max(1, int(np.ceil(SPEC_GAP_MIN_VALID * len(sub_starts))))
    P = np.full((len(idx), len(f)), np.nan, dtype=np.float32)
    ar = np.arange(nper)
    chunk = max(4, int(2e7 // (nfft * k_tap)))
    n_sub = 0
    for c0 in range(0, len(idx), chunk):
        ii = idx[c0:c0 + chunk]
        fr = y[ii[:, None] + ar[None, :]]
        full = np.isfinite(fr).all(axis=1)
        if full.any():
            g = fr[full] - fr[full].mean(axis=1, keepdims=True)
            S = np.zeros((g.shape[0], len(f)))
            for t in tap:
                S += np.abs(np.fft.rfft(g * t, n=nfft, axis=1)) ** 2
            S = S / (k_tap * fs)
            S[:, 1:-1] *= 2.0
            P[c0 + np.flatnonzero(full)] = S
        part = np.flatnonzero(~full & np.isfinite(fr).any(axis=1))
        if part.size and len(sub_starts) > 1:
            W = fr[part][:, sub_ix]
            ok = np.isfinite(W).all(axis=2)
            W = np.where(ok[:, :, None], W, 0.0)
            W = (W - W.mean(axis=2, keepdims=True)) * wm
            Sw = np.abs(np.fft.rfft(W, axis=2)) ** 2 * sm
            Sw[:, :, 1:-1] *= 2.0
            cnt = ok.sum(axis=1)
            Sm = (Sw * ok[:, :, None]).sum(axis=1) / np.maximum(cnt, 1)[:, None]
            for r, sw, c in zip(part, Sm, cnt):
                if c >= need:
                    P[c0 + r] = np.interp(f, fm, sw)
                    n_sub += 1
    info = dict(n_sub=n_sub, sub_sec=m / fs, df=2.0 * SPEC_NW / (nper / fs), nfft=nfft, tapers=k_tap)
    return f, (idx + nper / 2.0) / fs, P.T, step / fs, info


def to_dt64(t):
    return (np.asarray(t, dtype=float) * 1e6).astype("int64").astype("datetime64[us]")


def time_axis(ax, ta, tb):
    import matplotlib.dates as mdates
    span = tb - ta
    if span <= 180:
        ax.xaxis.set_major_locator(mdates.SecondLocator(bysecond=range(0, 60, 15)))
        ax.xaxis.set_minor_locator(mdates.SecondLocator(bysecond=range(0, 60, 5)))
    elif span <= 600:
        ax.xaxis.set_major_locator(mdates.MinuteLocator(interval=1))
        ax.xaxis.set_minor_locator(mdates.SecondLocator(bysecond=range(0, 60, 15)))
    elif span <= 1800:
        ax.xaxis.set_major_locator(mdates.MinuteLocator(byminute=range(0, 60, 5)))
        ax.xaxis.set_minor_locator(mdates.MinuteLocator())
    elif span <= 3600:
        ax.xaxis.set_major_locator(mdates.MinuteLocator(byminute=range(0, 60, 10)))
        ax.xaxis.set_minor_locator(mdates.MinuteLocator(byminute=range(0, 60, 2)))
    elif span <= 3 * 3600:
        ax.xaxis.set_major_locator(mdates.MinuteLocator(byminute=range(0, 60, 15)))
        ax.xaxis.set_minor_locator(mdates.MinuteLocator(byminute=range(0, 60, 5)))
    else:
        ax.xaxis.set_major_locator(mdates.AutoDateLocator(minticks=6, maxticks=14))
    ax.xaxis.set_major_formatter(mdates.DateFormatter("%H:%M:%S" if span <= 600 else "%H:%M"))
    ax.set_xlim(to_dt64(ta), to_dt64(tb))


def span_text(a, b):
    da, db = from_posix(a), from_posix(b)
    if da.date() == db.date():
        return f"{da:%Y-%m-%d %H:%M:%S}\u2013{db:%H:%M:%S} UTC"
    return f"{da:%Y-%m-%d %H:%M:%S}\u2013{db:%Y-%m-%d %H:%M:%S} UTC"


def plot_spectrogram(y, fs, ta, tb, head, unit, base, file_gaps=None, sub="", trace=None, psd_gain=None):
    import warnings
    y = np.asarray(y, dtype=np.float64).copy()
    y, n_fixed = close_tiny_holes(y)
    yt = y if trace is None else np.asarray(trace, dtype=np.float64)
    win_sec, ov = spec_params(tb - ta, fs)
    gaps, gap_tot = log_gaps("data", y, fs, ta)
    fin = np.flatnonzero(np.isfinite(y))
    if not fin.size:
        raise StopRun("no data in the window")
    td0, td1 = ta + fin[0] / fs, ta + (fin[-1] + 1) / fs
    cropped = SPEC_CROP_TO_DATA and (td0 > ta + 1.0 or td1 < tb - 1.0)
    x0, x1 = (td0, td1) if cropped else (ta, tb)
    f, tt, P, step_s, sinfo = spectrogram(y, fs, win_sec, ov)
    fmax = min(SPEC_FMAX or 0.45 * fs, 0.5 * fs)
    sel = (f >= SPEC_FMIN) & (f <= fmax) & (f > 0)
    f, P = f[sel], P[sel]
    if psd_gain is not None:
        P = P * psd_gain(f)[:, None]
    k = int(np.ceil(len(f) / float(SPEC_MAX_FREQ_ROWS)))
    if k > 1:
        mrow = len(f) // k
        f = f[:mrow * k].reshape(mrow, k).mean(axis=1)
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", RuntimeWarning)
            P = np.nanmean(P[:mrow * k].reshape(mrow, k, -1), axis=1)
    with np.errstate(divide="ignore", invalid="ignore"):
        D = 10.0 * np.log10(P)
    D[~np.isfinite(D)] = np.nan
    good = np.isfinite(D).any(axis=0)
    if not good.any():
        raise StopRun("no usable spectrogram frame")
    lo, hi = SPEC_CLIM_DB if SPEC_CLIM_DB else np.nanpercentile(D, SPEC_CLIM_PCT)
    med = float(np.nanmedian(D))
    times = to_dt64(ta + tt)
    half = np.timedelta64(int(round(0.5e6 * step_s)), "us")
    cmap = matplotlib.colormaps[SPEC_CMAP].copy()
    cmap.set_bad("white")
    if SPEC_SHOW_TRACE:
        fig, (axw, ax) = plt.subplots(2, 1, figsize=FIG_SIZE, sharex=True,
                                      gridspec_kw=dict(height_ratios=[1, 3], hspace=0.06))
        kk = max(1, len(yt) // 8000)
        mm = len(yt) // kk
        yy = yt[:mm * kk].reshape(mm, kk)
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", RuntimeWarning)
            ymin, ymax = np.nanmin(yy, axis=1), np.nanmax(yy, axis=1)
        tw = to_dt64(ta + (np.arange(mm) * kk + 0.5 * kk) / fs)
        if kk > 1:
            axw.fill_between(tw, ymin, ymax, color="0.15", lw=0, step="mid")
        else:
            axw.plot(tw, yt[:mm], color="0.15", lw=0.5)
        for a, b in gaps:
            a, b = max(a, x0), min(b, x1)
            if b > a:
                axw.axvspan(to_dt64(a), to_dt64(b), color="tab:red", alpha=0.15, lw=0)
        for a, b in (file_gaps or []):
            a, b = max(a, x0), min(b, x1)
            if b > a:
                axw.axvspan(to_dt64(a), to_dt64(b), color="0.55", alpha=0.35, lw=0, hatch="//")
        valid = yt[np.isfinite(yt)]
        if valid.size:
            center = float(np.median(valid))
            halfspan = float(np.percentile(np.abs(valid - center), SIGNAL_YLIM_PCT))
            if not np.isfinite(halfspan) or halfspan <= 0.0:
                halfspan = float(np.max(np.abs(valid - center)))
            if halfspan <= 0.0:
                halfspan = max(abs(center) * 0.01, 1e-12)
            halfspan *= SIGNAL_YLIM_PAD
            axw.set_ylim(center - halfspan, center + halfspan)
        axw.ticklabel_format(axis="y", style="sci", scilimits=(-2, 3))
        axw.set_ylabel(f"[{unit}]")
        axw.grid(alpha=0.25)
    else:
        fig, ax = plt.subplots(figsize=FIG_SIZE)
    import matplotlib.dates as mdates
    df = f[1] - f[0] if len(f) > 1 else 1.0
    edges_f = np.array([max(f[0] - df / 2, 1e-3), f[-1] + df / 2])
    t_lo = mdates.date2num(times[0] - half)
    t_hi = mdates.date2num(times[-1] + half)
    interp = SPEC_INTERP
    if interp == "auto":
        interp = "bilinear" if (tb - ta) / win_sec < 600 else "nearest"
    ax.xaxis_date()
    im = ax.imshow(np.ma.masked_invalid(D), cmap=cmap, vmin=lo, vmax=hi, origin="lower", aspect="auto",
                   interpolation=interp, extent=[t_lo, t_hi, edges_f[0], edges_f[-1]], rasterized=True)
    if SPEC_LOG_FREQ:
        ax.set_yscale("log")
    ax.set_ylim(edges_f[0], edges_f[-1])
    time_axis(ax, x0, x1)
    ax.set_ylabel("Frequency [Hz]")
    ax.set_xlabel("Time (UTC)")
    cb = fig.colorbar(im, ax=[ax] if not SPEC_SHOW_TRACE else [axw, ax], pad=0.02, aspect=30)
    cb.set_label(f"PSD [dB rel. 1 ({unit})\u00b2/Hz]")
    title = (f"{head}  |  {span_text(x0, x1)}\n"
             f"{sub}{edges_f[0]:.2g}\u2013{edges_f[-1]:.4g} Hz  |  median {med:.1f} dB")
    (axw if SPEC_SHOW_TRACE else ax).set_title(title, fontsize=fz(10))
    log(f"  spectrogram: {win_sec:.3g} s frames, {step_s:.3g} s step, multitaper NW {SPEC_NW:g} with {sinfo['tapers']} "
        f"tapers (resolution {sinfo['df']:.3g} Hz, FFT {sinfo['nfft']}), {len(tt)} frames, {int(good.sum())} shown, "
