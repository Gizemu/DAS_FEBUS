               RAM_WIN_SEC=RAM_WIN_SEC, WHITEN_SMOOTH_HZ=WHITEN_SMOOTH_HZ, PWS_POWER=PWS_POWER,
               DAS_MIN_COMPLETE=DAS_MIN_COMPLETE, VEL_C_MIN=VEL_C_MIN, VEL_C_MAX=VEL_C_MAX,
               VEL_C_STEP=VEL_C_STEP, VEL_MIN_OFFSET_M=VEL_MIN_OFFSET_M, VEL_MIN_CONTRAST=VEL_MIN_CONTRAST,
               CLIP_PCT=CLIP_PCT, FONT_INC=FONT_INC, SEIS_WATER_LEVEL=SEIS_WATER_LEVEL, SEIS_PAD_SEC=SEIS_PAD_SEC)
    for k, v in num.items():
        if v is not None and (isinstance(v, bool) or not isinstance(v, (int, float, np.integer, np.floating))):
